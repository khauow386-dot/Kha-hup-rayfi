local function makeTab(name)
    local tab = {Name=name, subtabs={}}
    local b = Instance.new("TextButton")
    b.Size = UDim2.new(1,-4,0,38)
    b.BackgroundColor3 = Color3.fromRGB(34,34,42)
    b.TextColor3 = Color3.fromRGB(240,240,245)
    b.Text = "  "..name
    b.TextXAlignment = Enum.TextXAlignment.Left
    b.Font = Enum.Font.GothamBold
    b.TextSize = 13
    b.Parent = Sidebar
    Instance.new("UICorner", b).CornerRadius = UDim.new(0,7)
    tab.Button = b
    table.insert(tabs, tab)
    b.MouseButton1Click:Connect(function()
        activeTab = tab
        for _, t in ipairs(tabs) do styleButton(t.Button, t == tab) end
        clearContent()
        for _, st in ipairs(tab.subtabs) do
            local header = makeControlBase(32)
            local hl = addLabel(header, st.Name, 13, true)
            hl.TextColor3 = Color3.fromRGB(120,190,255)
            for _, fn in ipairs(st.items) do fn() end
        end
        refreshCanvas()
    end)
    return tab
end

local function makeSubTab(tab, name)
