local toggleDragging, toggleMoved, toggleStart, toggleOrigin
ToggleButton.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        toggleDragging = true
        toggleMoved = false
        toggleStart = input.Position
        toggleOrigin = ToggleButton.Position
    end
end)
UIS.InputChanged:Connect(function(input)
    if toggleDragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
        local delta = input.Position - toggleStart
        if delta.Magnitude > 8 then toggleMoved = true end
        ToggleButton.Position = UDim2.new(
            toggleOrigin.X.Scale, toggleOrigin.X.Offset + delta.X,
            toggleOrigin.Y.Scale, toggleOrigin.Y.Offset + delta.Y
        )
    end
end)
UIS.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        toggleDragging = false
    end
end)
ToggleButton.MouseButton1Click:Connect(function()
    if not toggleMoved then ScreenGui.Enabled = not ScreenGui.Enabled end
end)

