--==================================================
-- COPY CURRENT COORDINATES
--==================================================

CopyCoordinate.MouseButton1Click:Connect(function()
	local rootPart = getRoot()

	if not rootPart then
		CopyCoordinate.Text = "Không tìm thấy!"

		task.wait(1)
		CopyCoordinate.Text = "Copy Tọa Độ"
		return
	end

	local pos = rootPart.Position

	local x = string.format("%.2f", pos.X)
	local y = string.format("%.2f", pos.Y)
	local z = string.format("%.2f", pos.Z)

	local coordinateText = x .. ", " .. y .. ", " .. z

	-- Điền thẳng vào 3 ô
	XBox.Text = x
	YBox.Text = y
	ZBox.Text = z

	-- Sao chép nếu executor hỗ trợ setclipboard
	if setclipboard then
		setclipboard(coordinateText)
		CopyCoordinate.Text = "Đã Copy!"
	else
		CopyCoordinate.Text = "Đã lấy tọa độ!"
	end

	task.wait(1.2)
	CopyCoordinate.Text = "Copy Tọa Độ"
end)

