-- Universal GUI parent: use CoreGui when the executor allows it,
-- otherwise fall back to the local player's PlayerGui.
local function parentGui(gui)
    local ok = pcall(function() gui.Parent = CoreGui end)
    if ok and gui.Parent == CoreGui then return true end
    local pg = LocalPlayer:FindFirstChildOfClass("PlayerGui") or LocalPlayer:WaitForChild("PlayerGui", 10)
    if pg then
        local ok2 = pcall(function() gui.Parent = pg end)
        return ok2 and gui.Parent == pg
    end
    return false
end
