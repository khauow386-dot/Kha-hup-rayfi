            print(
                "MINH KHA HUB V5:",
                T("languageChanged")
            )

            task.spawn(function()

                task.wait(0.1)

                BuildUI()

            end)

        end
    )

    Settings:CreateButton(
        T("english"),
        function()

            if Language == "EN" then
                return
            end

            Language = "EN"

            print(
                "MINH KHA HUB V5:",
                T("languageChanged")
            )

            task.spawn(function()

                task.wait(0.1)

                BuildUI()

            end)

        end
    )

    --========================================================
    -- CHỈNH CHỮ
    --========================================================

    task.defer(function()

        local Gui

        for _ = 1, 30 do

            local PlayerGui =
                Player:FindFirstChild(
                    "PlayerGui"
                )

            if PlayerGui then

                Gui =
                    PlayerGui:FindFirstChild(
                        "MINH_KHA_HUB_COMPLETE"
                    )

                if Gui then
                    break
                end

            end

            task.wait(0.1)

        end

        if not Gui then
            return
        end

        for _, Object in ipairs(
            Gui:GetDescendants()
        ) do

            if Object:IsA("TextButton") then

                Object.TextSize = 16

                if Object.Text == "MK" then
                    Object.TextSize = 23
                end

            elseif Object:IsA("TextLabel") then

                Object.TextSize = 16

                if Object.Text ==
                    "MINH KHA HUB" then

                    Object.TextSize = 24

                end

            elseif Object:IsA("TextBox") then

                Object.TextSize = 16

            end

        end

    end)

    print(
        "MINH KHA HUB V5:",
        Language == "VI"
            and "ĐÃ TẠO MENU TIẾNG VIỆT"
            or "ENGLISH MENU CREATED"
    )

    return true
end

