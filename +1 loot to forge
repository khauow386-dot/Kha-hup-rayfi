end  

local Loader, CompileError = loadstring(Source)  

if not Loader then  
    error(CompileError or "Không compile được Library")  
end  

return Loader()

end)

if not ok or not result then

warn(  
    "MINH KHA HUB LIBRARY ERROR:",  
