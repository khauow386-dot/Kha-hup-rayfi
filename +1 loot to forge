local Debug = _G.__LOOTTOFORGE_DBG
local CONFIG = Debug and Debug.CONFIG
local STATE = Debug and Debug.STATE

local EngineReady = Debug ~= nil
local EngineLoading = false
local EngineError = nil

--============================================================
-- UPDATE ENGINE
--============================================================

local function UpdateEngineState()

    Debug = _G.__LOOTTOFORGE_DBG

    if Debug then

        EngineReady = true
        CONFIG = Debug.CONFIG
        STATE = Debug.STATE

        return true

    end

    return false
end

--============================================================
-- DEFAULT CONFIG
--============================================================

local function DisableEverything()

    if not UpdateEngineState() then
        return
    end

    if not CONFIG then
        return
    end

    CONFIG.auto = false

    CONFIG.farm = false
    CONFIG.train = false

    CONFIG.forge = false
    CONFIG.forgeArmor = false
    CONFIG.equip = false
    CONFIG.sell = false

    CONFIG.upgrade = false
    CONFIG.orePackFirst = false
    CONFIG.upgOrePack = false
    CONFIG.upgTrain = false
    CONFIG.upgLuck = false

    CONFIG.rebirth = false
    CONFIG.index = false

    CONFIG.tower = false
    CONFIG.dailyTicket = false

    CONFIG.enchant = false
    CONFIG.race = false

    CONFIG.antiAfk = false
end

--============================================================
-- ENGINE LOADER
--============================================================

local function LoadEngine()

    if EngineLoading or EngineReady then
        return
    end

    EngineLoading = true

    task.spawn(function()

        local ok, err = pcall(function()

            local Source = game:HttpGet(ENGINE_URL)

            if not Source or #Source < 1000 then
                error("Engine rỗng hoặc không tải được")
            end

            local Loader, CompileError =
                loadstring(Source)

            if not Loader then
                error(
                    CompileError
                    or "Không compile được Engine"
                )
            end

            Loader()

        end)

        if not ok then

            EngineError = err

            warn(
                "MINH KHA HUB V5 ENGINE ERROR:",
                err
            )

        end

        UpdateEngineState()

        if EngineReady and CONFIG then

            CONFIG.auto = false

            CONFIG.farm = false
            CONFIG.train = false

            CONFIG.forge = false
            CONFIG.forgeArmor = false
            CONFIG.equip = false
            CONFIG.sell = false

            CONFIG.upgrade = false
            CONFIG.orePackFirst = false
            CONFIG.upgOrePack = false
            CONFIG.upgTrain = false
            CONFIG.upgLuck = false

            CONFIG.rebirth = false
            CONFIG.index = false

            CONFIG.tower = false
            CONFIG.dailyTicket = false
            CONFIG.towerKeep = 0

            CONFIG.enchant = false
            CONFIG.race = false

            CONFIG.antiAfk = false

            CONFIG.stage = 0
            CONFIG.trainSecs = 20
            CONFIG.coinKeep = 0
            CONFIG.element = "Fire"

            print(
                "MINH KHA HUB V5: ENGINE ĐÃ SẴN SÀNG"
            )

        end

        EngineLoading = false

    end)
end

--============================================================
-- START ENGINE NGAY
--============================================================

LoadEngine()

--============================================================
-- CONFIG HELPER
--============================================================

local function SetConfig(Name, Value)

    if UpdateEngineState() and CONFIG then

        CONFIG[Name] = Value

        return true

    end

    return false
end

--============================================================
-- CALL ENGINE
--
-- KHÔNG CHỜ 15 GIÂY
--============================================================

local function Call(Name, ...)

    local Args = table.pack(...)

    task.spawn(function()

        if not UpdateEngineState() then

            warn(
                "MINH KHA HUB V5:",
                Name,
                "Engine chưa sẵn sàng"
            )

            return
        end

        if not Debug then
            return
        end

        local Function = Debug[Name]

        if type(Function) ~= "function" then

            warn(
                "MINH KHA HUB V5:",
                "Không tìm thấy chức năng:",
                Name
            )

            return
        end

        local ok, err = pcall(function()

            Function(
                table.unpack(
                    Args,
                    1,
                    Args.n
                )
            )

        end)

        if not ok then

            warn(
                "MINH KHA HUB V5:",
                Name,
                err
            )

        end

    end)
end

