--============================================================
-- GỌI HÀM THẬT CỦA ENGINE
--============================================================

local function Call(Name, ...)

if not Debug then  
    return false  
end  

local Function = Debug[Name]  

if type(Function) ~= "function" then  

    warn(  
        "MINH KHA HUB: Không tìm thấy chức năng:",  
        Name  
    )  

    return false  
end  

local Args = table.pack(...)  

task.spawn(function()  

    local ok, err = pcall(function()  
        return Function(table.unpack(Args, 1, Args.n))  
    end)  

    if not ok then  
        warn(  
            "MINH KHA HUB:",  
            Name,  
            err  
        )  
    end  

end)  

return true

end

