local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local GuiService = game:GetService("GuiService")
local CoreGui = game:GetService("CoreGui")

local LocalPlayer = Players.LocalPlayer

--==================================================
-- WINDOW
--==================================================

local Window = Rayfield:CreateWindow({
    Name = "Minh Kha Hub",
    Subtitle = "Teleport Menu",
    Theme = "default",

    Configuration = {
        autoSave = true,
        autoLoad = true,
        fileName = "MinhKhaHub"
    }
})

--==================================================
-- VARIABLES
--==================================================

local savedCFrame = nil

local infiniteJumpEnabled = false

local noclipEnabled = false
local noclipConnection = nil

local antiPausedEnabled = false

local X = 0
local Y = 0
local Z = 0

--==================================================
-- HELPER
--==================================================

local function getRoot()
    local character = LocalPlayer.Character

    if not character then
        return nil
    end

    return character:FindFirstChild("HumanoidRootPart")
end

local function notify(title, content)
    pcall(function()
        Window:Notify({
            Title = title,
            Content = content,
            Duration = 2
        })
    end)
end

--==================================================
-- ANTI GAMEPLAY PAUSED
--==================================================

local function removeNetworkPause()

    pcall(function()

        local RobloxGui =
            CoreGui:FindFirstChild("RobloxGui")

        if RobloxGui then

            local NetworkPause =
                RobloxGui:FindFirstChild("CoreScripts/NetworkPause")

            if NetworkPause then
                NetworkPause:Destroy()
            end

        end

    end)

end

local function enableAntiPaused()

    pcall(function()

        GuiService:SetGameplayPausedNotificationEnabled(false)

    end)

    removeNetworkPause()

end

local function disableAntiPaused()

    pcall(function()

        GuiService:SetGameplayPausedNotificationEnabled(true)

    end)

end

