--==================================================
-- COPY + AUTO INPUT COORDINATES
--==================================================

TeleportTab:CreateButton({
    Name = "Lấy Tọa Độ Hiện Tại",

    Callback = function()

        local rootPart = getRoot()

        if not rootPart then

            notify(
                "Minh Kha Hub",
                "Không tìm thấy nhân vật!"
            )

            return
        end

        local pos = rootPart.Position

        local x = string.format("%.2f", pos.X)
        local y = string.format("%.2f", pos.Y)
        local z = string.format("%.2f", pos.Z)

        X = tonumber(x)
        Y = tonumber(y)
        Z = tonumber(z)

        pcall(function()

            XInput:Set(x)
            YInput:Set(y)
            ZInput:Set(z)

        end)

        local coordinateText =
            x .. ", " .. y .. ", " .. z

        if setclipboard then

            pcall(function()
                setclipboard(coordinateText)
            end)

            notify(
                "Minh Kha Hub",
                "Đã copy + tự động nhập tọa độ!"
            )

        else

            notify(
                "Minh Kha Hub",
                "Đã tự động nhập tọa độ!"
            )

        end

    end
})

--==================================================
-- HIGHEST FLOOR
--==================================================

local function findHighestFloor()

    local highestPart = nil
    local highestY = -math.huge

    for _, obj in ipairs(
        workspace:GetDescendants()
    ) do

        if obj:IsA("BasePart")
            and obj.CanCollide
            and obj.Transparency < 1
            and obj.Size.X >= 3
            and obj.Size.Z >= 3 then

            local topY =
                obj.Position.Y +
                (obj.Size.Y / 2)

            if topY > highestY then

                highestY = topY
                highestPart = obj

            end

        end

    end

    return highestPart, highestY

end

--==================================================
-- TELEPORT HIGHEST FLOOR
--==================================================

TeleportTab:CreateButton({
    Name = "Teleport Sàn Cao Nhất",

    Callback = function()

        local rootPart = getRoot()

        if not rootPart then

            notify(
                "Minh Kha Hub",
                "Không tìm thấy nhân vật!"
            )

            return
        end

        local floor, highestY =
            findHighestFloor()

        if not floor then

            notify(
                "Minh Kha Hub",
                "Không tìm thấy sàn!"
            )

            return
        end

        local targetPosition =
            Vector3.new(
                floor.Position.X,
                highestY + 4,
                floor.Position.Z
            )

        rootPart.CFrame =
            CFrame.new(targetPosition)

        notify(
            "Minh Kha Hub",
            "Đã teleport đến sàn cao nhất!"
        )

    end
})

