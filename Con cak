    for _,obj in ipairs(
        workspace:GetDescendants()
    ) do

        if obj:IsA("BasePart")
        and string.find(
            string.lower(
                obj.Name
            ),
            string.lower(
                itemName
            ),
            1,
            true
        ) then

            table.insert(
                found,
                obj
            )

        end

    end


    if #found == 0 then

        Notify(
            "Items",
            "Not found: "
            .. itemName
        )

        return

    end


    local target =
        found[
            math.random(
                1,
                #found
            )
        ]


    root.CFrame =
        target.CFrame
        + Vector3.new(
            0,
            3,
            0
        )

end


