--============================================================
-- 18. PICKUP EGG
--============================================================

local function PickupEgg(Egg)

    if not Egg then
        return false
    end

    if not GameRemotes then
        return false
    end

    local EggPickup =
        GameRemotes:FindFirstChild(
            "EggPickup"
        )

    if not EggPickup then

        warn(
            "[MINH KHA HUB] EggPickup remote not found"
        )

        return false
    end

    local Before =
        #GetBasket()

    pcall(function()

        if EggPickup:IsA(
            "RemoteEvent"
        ) then

            EggPickup:FireServer(
                Egg.Object.Name
            )
        end

    end)

    local Timeout =
        os.clock() + 3

    while os.clock() < Timeout do

        if Config.StopMovement then
            return false
        end

        if #GetBasket() > Before then
            return true
        end

        task.wait(0.1)
    end

    return false
end

