-- 18. PICKUP
--============================================================

local function PickupEgg(Egg)

    if not Egg
        or not GameRemotes then

        return false
    end

    local EggPickup =
        GameRemotes:FindFirstChild(
            "EggPickup"
        )

    if not EggPickup then
        return false
    end

    local Before =
        #GetBasket()

    pcall(function()

        if EggPickup:IsA(
            "RemoteEvent"
        ) then

            EggPickup:FireServer(
                Egg.Object.Name
            )
        end
    end)

    local Timeout =
        os.clock() + 2

    while os.clock()
        < Timeout do

        if Config.StopMovement then
            return false
        end

        if #GetBasket()
            > Before then

            return true
        end

        task.wait(0.05)
    end

    return false
end

