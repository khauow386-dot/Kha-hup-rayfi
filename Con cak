            0

        Text.Font =
            Enum.Font.GothamBold

        Text.TextSize = 14
        Text.TextWrapped = true

        Text.Parent =
            Billboard

        EggESPObjects[Egg] =
            Part
    end

    Part.CFrame =
        CFrame.new(Position)

    local Billboard =
        Part:FindFirstChild(
            "EggESP"
        )

    if Billboard then

        local Text =
            Billboard:FindFirstChild(
                "EggText"
            )

        if Text then

            Text.Text =
                "🥚 "
                .. tostring(EggName)
                .. "\n🍀 "
                .. tostring(Luck)
                .. "x"
        end
    end
end

local function ClearAllEggESP()

    for Egg, Part in pairs(
        EggESPObjects
    ) do

        pcall(function()
            Part:Destroy()
        end)

        EggESPObjects[Egg] = nil
    end
end

local function UpdateEggESP()

    if not Config.EggESP then

        ClearAllEggESP()

        return
    end

    if not ActiveEggs then
        return
    end

    local ExistingEggs = {}

    for _, Egg in ipairs(
        ActiveEggs:GetChildren()
    ) do

        ExistingEggs[Egg] = true

        CreateEggESP(Egg)
    end

    for Egg in pairs(
        EggESPObjects
    ) do

        if not ExistingEggs[Egg]
            or not Egg.Parent then

            RemoveEggESP(Egg)
        end
    end
end

task.spawn(function()

    while task.wait(0.15) do

        if Config.EggESP then

            pcall(function()
                UpdateEggESP()
            end)
        end
    end
end)

