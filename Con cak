--============================================================
-- 27. RELOAD MENU
--============================================================

local Reloading = false

function ReloadMenu()

    if Reloading then
        return
    end

    Reloading = true

    -- Không dừng Auto Steal
    -- Chỉ dừng tween hiện tại
    if CurrentTween then

        pcall(function()
            CurrentTween:Cancel()
        end)

        CurrentTween = nil
    end

    --========================================================
    -- XÓA MENU CŨ
    --========================================================

    local Old =
        PlayerGui:FindFirstChild(
            "MINH_KHA_HUB_COMPLETE"
        )

    if Old then

        pcall(function()
            Old:Destroy()
        end)
    end

    Library = nil

    MainTab = nil
    PointTab = nil
    ESPTab = nil
    SettingsTab = nil

    task.wait(0.12)

    --========================================================
    -- LOAD LẠI LIBRARY
    --========================================================

    local Success =
        LoadLibrary()

    if Success then

        task.wait(0.12)

        BuildMenu()

        task.wait(0.08)

        PatchLibraryText()

        PatchToggleText()
    end

    Reloading = false
end

