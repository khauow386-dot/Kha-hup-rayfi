            + forward*z
            + right*(width/2)
            + Vector3.new(
                0,
                roofY,
                0
            )
        )

    end


    --====================================================
    -- FRONT ROOF EDGE
    --====================================================

    Segment(
        remote,
        part,

        origin
        + right*(-width/2)
        + Vector3.new(
            0,
            roofY,
            0
        ),

        origin
        + right*(width/2)
        + Vector3.new(
            0,
            roofY,
            0
        )
    )


    --====================================================
    -- BACK ROOF EDGE
    --====================================================

    Segment(
        remote,
        part,

        origin
        + forward*length
        + right*(-width/2)
        + Vector3.new(
            0,
            roofY,
            0
        ),

