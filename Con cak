local function GetPlotPosition()

    local Plots =
        workspace:FindFirstChild(
            "Plots"
        )

    if not Plots then
        return nil
    end

    for _, Plot in ipairs(
        Plots:GetChildren()
    ) do

        local Data =
            Plot:FindFirstChild(
                "Data"
            )

        if Data then

            local Owner =
                Data:FindFirstChild(
                    "Owner"
                )

            if Owner then

                local Mine = false

                pcall(function()

                    Mine =
                        Owner.Value
                        == Player

                end)

                if Mine then

                    local Base =
                        Plot:FindFirstChild(
                            "Baseplate"
                        )

                    if Base
                        and Base:IsA(
                            "BasePart"
                        ) then

                        return Base.Position
                            + Vector3.new(
                                0,
                                4,
                                0
                            )
                    end
                end
            end
        end
    end

    return nil
end

