    )

end


--========================================================
-- HOUSE
--========================================================

local function BuildHouse(
    width,
    length,
    height,
    withFloor
)

    local root,remote,part =
        GetBuildData()

    if not root then
        return
    end


    width =
        math.max(
            4,
            width
        )

    length =
        math.max(
            4,
            length
        )

    height =
        math.max(
            3,
            height
        )


    -- FLOOR

    if withFloor then

        HouseFloor(
            root,
            remote,
            part,
            width,
            length
        )

        task.wait(
            .10
        )

    end


    -- WALLS + DOOR

    HouseWalls(
        root,
        remote,
        part,
        width,
        length,
        height
    )


    task.wait(
        .10
    )


    -- ROOF

    BuildRoof(
        root,
        remote,
        part,
        width,
        length,
        height
    )


    Notify(
        "Build",
        "House + Door + Roof complete."
    )

end


