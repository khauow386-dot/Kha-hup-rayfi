--============================================================
-- 13. GET EGG NAME / LUCK / RARITY
--============================================================

local function GetEggInfo(EggObject)

    if not EggObject then
        return nil, 0, "Common"
    end

    local EggName =
        EggObject:GetAttribute("Egg")

    if not EggName then
        return nil, 0, "Common"
    end

    local Luck = tonumber(
        EggObject:GetAttribute("Luck")
    ) or 0

    local Rarity = "Common"

    if EggsModule then

        local Data = EggsModule[EggName]

        if type(Data) == "table" then

            Luck = tonumber(Data.Luck) or Luck
            Rarity = Data.Rarity or Rarity

        end
    end

    return EggName, Luck, Rarity
end

--============================================================
-- 14. FIND BEST EGG
--============================================================

local function FindBestEgg()

    if not ActiveEggs then
        return nil
    end

    local Character, Humanoid, Root = GetCharacter()

    if not Root then
        return nil
    end

    local BestEgg = nil
    local BestScore = -math.huge

    for _, Egg in ipairs(ActiveEggs:GetChildren()) do

        if Config.StopMovement then
            break
        end

        local EggName, Luck, Rarity =
            GetEggInfo(Egg)

        local Position =
            Egg:GetAttribute("Position")

        if EggName and typeof(Position) == "Vector3" then

            local Distance =
                (Root.Position - Position).Magnitude

            local Score = 0

            if Config.Priority == "Highest Luck" then

                Score =
                    (Luck * 100000)
                    -
                    Distance

            else

                local RarityValue =
                    RarityOrder[Rarity] or 1

                Score =
                    (RarityValue * 100000)
                    +
                    (Luck * 1000)
                    -
                    Distance
            end

            if Score > BestScore then

                BestScore = Score
                BestEgg = {
                    Object = Egg,
                    Name = EggName,
                    Luck = Luck,
                    Rarity = Rarity,
                    Position = Position
                }

            end
        end
    end

    return BestEgg
end

