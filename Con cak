--============================================================
-- 21. AUTO STEAL
--============================================================

local function AutoStealLoop()

    if Config.Busy then
        return
    end

    Config.Busy = true
    Config.StopMovement = false

    task.spawn(function()

        while Config.AutoSteal do

            if Config.StopMovement then
                break
            end

            local Character, Humanoid, Root =
                GetCharacter()

            if not Root then

                task.wait(1)

                continue
            end

            local BestEgg =
                FindBestEgg()

            if not BestEgg
                or not BestEgg.Object.Parent then

                task.wait(0.2)

                continue
            end

            --================================================
            -- TELEPORT TO EGG
            --================================================

            InstantTeleportToEgg(
                BestEgg.Position
                + Vector3.new(
                    0,
                    3,
                    0
                )
            )

            task.wait(0.12)

            --================================================
            -- PICKUP
            --================================================

            local Picked = false

            for i = 1, 3 do

                if not Config.AutoSteal then
                    break
                end

                Picked =
                    PickupEgg(
                        BestEgg
                    )

                if Picked then
                    break
                end

                task.wait(0.08)
            end

            --================================================
            -- FLY BACK
            --================================================

            if Picked then

                local Target =
                    Config.SavedPoint
                    and Config.SavedPoint.Position
                    or GetPlotPosition()

                if Target then

                    FlyTo(Target)

                    task.wait(0.1)

                    DeliverToPlot()
                end

                task.wait(0.3)

            else

                task.wait(0.4)
            end
        end

        Config.Busy = false
    end)
end

