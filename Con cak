--========================================================
-- MK DRAG
--========================================================

do

    local dragging =
        false

    local dragStart

    local startPosition

    local moved =
        false


    MK.InputBegan:Connect(
        function(input)

            if input.UserInputType ==
                Enum.UserInputType.MouseButton1

            or input.UserInputType ==
                Enum.UserInputType.Touch then

                dragging =
                    true

                moved =
                    false

                dragStart =
                    input.Position

                startPosition =
                    MK.Position

            end

        end
    )


    UserInputService.InputChanged:Connect(
        function(input)

            if not dragging then
                return
            end

            if input.UserInputType ==
                Enum.UserInputType.MouseMovement

            or input.UserInputType ==
                Enum.UserInputType.Touch then

                local delta =
                    input.Position
                    - dragStart


                if math.abs(delta.X) > 5
                or math.abs(delta.Y) > 5 then

                    moved =
                        true

                end


                MK.Position =
                    UDim2.new(

                        startPosition.X.Scale,

                        startPosition.X.Offset
                        + delta.X,

                        startPosition.Y.Scale,

                        startPosition.Y.Offset
                        + delta.Y

                    )

            end

        end
    )


    UserInputService.InputEnded:Connect(
        function(input)

            if input.UserInputType ==
                Enum.UserInputType.MouseButton1

            or input.UserInputType ==
                Enum.UserInputType.Touch then

                dragging =
                    false

            end

        end
    )


    MK.MouseButton1Click:Connect(
        function()

            if moved then

                moved =
                    false

                return

            end


            Main.Visible =
                not Main.Visible

        end
    )

end


