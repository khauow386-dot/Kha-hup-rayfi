            Key = key,
            Type = "Input"
        }
    )


    Box.FocusLost:Connect(
        function()

            local value =
                tonumber(
                    Box.Text
                )

            if value then

                pcall(
                    callback,
                    value
                )

            end

        end
    )


    return Box

end


