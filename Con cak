--============================================================
-- 13. GET EGG INFORMATION
--============================================================

local function GetEggInfo(EggObject)

    if not EggObject then
        return nil, 0, "Common"
    end

    local EggName =
        EggObject:GetAttribute(
            "Egg"
        )

    if not EggName then
        return nil, 0, "Common"
    end

    local Luck =
        tonumber(
            EggObject:GetAttribute(
                "Luck"
            )
        ) or 0

    local Rarity =
        "Common"

    if EggsModule then

        local Data =
            EggsModule[EggName]

        if type(Data) == "table" then

            Luck =
                tonumber(Data.Luck)
                or Luck

            Rarity =
                Data.Rarity
                or Rarity
        end
    end

    return EggName, Luck, Rarity
end

--============================================================
-- 14. EGG ESP
-- NAME + LUCK ONLY
-- NO BOX / NO BACKGROUND / NO RARITY
--============================================================

local EggESPObjects = {}

local function RemoveEggESP(Egg)

    local Part =
        EggESPObjects[Egg]

    if Part then

        pcall(function()
            Part:Destroy()
        end)

        EggESPObjects[Egg] = nil
    end
end

local function CreateEggESP(Egg)

    if not Config.EggESP then
        return
    end

    if not Egg then
        return
    end

    local EggName, Luck =
        GetEggInfo(Egg)

    if not EggName then
        return
    end

    local Position =
        Egg:GetAttribute(
            "Position"
        )

    if typeof(Position) ~= "Vector3" then
        return
    end

    local Part =
        EggESPObjects[Egg]

    if not Part then

        Part =
            Instance.new("Part")

        Part.Name =
            "MINH_KHA_EGG_ESP"

        Part.Size =
            Vector3.new(
                0.1,
                0.1,
                0.1
            )

        Part.Transparency = 1

        Part.Anchored = true

        Part.CanCollide = false

        Part.CanTouch = false

        Part.CanQuery = false

        Part.Parent =
            workspace

        local Billboard =
            Instance.new(
                "BillboardGui"
            )

        Billboard.Name =
            "EggESP"

        Billboard.Size =
            UDim2.new(
                0,
                180,
                0,
                45
            )

        Billboard.StudsOffset =
            Vector3.new(
                0,
                3,
                0
            )

        Billboard.AlwaysOnTop =
            true

        Billboard.MaxDistance =
            1000

        Billboard.Parent =
            Part

        local Text =
            Instance.new(
                "TextLabel"
            )

        Text.Name =
            "EggText"

        Text.Size =
            UDim2.fromScale(
                1,
                1
            )

        Text.BackgroundTransparency =
            1

        Text.TextColor3 =
            Color3.fromRGB(
                255,
                255,
                255
            )

        Text.TextStrokeColor3 =
            Color3.fromRGB(
                0,
                0,
                0
            )

        Text.TextStrokeTransparency =
            0

        Text.Font =
            Enum.Font.GothamBold

        Text.TextSize =
            14

        Text.TextWrapped =
            true

        Text.Parent =
            Billboard

        EggESPObjects[Egg] =
            Part
    end

    Part.CFrame =
        CFrame.new(Position)

    local Billboard =
        Part:FindFirstChild(
            "EggESP"
        )

    if Billboard then

        local Text =
            Billboard:FindFirstChild(
                "EggText"
            )

        if Text then

            Text.Text =
                "🥚 "
                .. tostring(EggName)
                .. "\n🍀 "
                .. tostring(Luck)
                .. "x"
        end
    end
end

local function ClearAllEggESP()

    for Egg, Part in pairs(
        EggESPObjects
    ) do

        pcall(function()
            Part:Destroy()
        end)

        EggESPObjects[Egg] = nil
    end
end

local function UpdateEggESP()

    if not Config.EggESP then

        ClearAllEggESP()

        return
    end

    if not ActiveEggs then
        return
    end

    local ExistingEggs = {}

    for _, Egg in ipairs(
        ActiveEggs:GetChildren()
    ) do

        ExistingEggs[Egg] = true

        CreateEggESP(Egg)
    end

    for Egg in pairs(
        EggESPObjects
    ) do

        if
            not ExistingEggs[Egg]
            or not Egg.Parent
        then

            RemoveEggESP(Egg)
        end
    end
end

