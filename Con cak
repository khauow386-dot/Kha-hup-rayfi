end


local function Character()

    local char =
        LocalPlayer.Character

    if not char then
        return nil,nil
    end

    local root =
        char:FindFirstChild(
            "HumanoidRootPart"
        )

    return char,root
end


local function Humanoid()

    local char =
        LocalPlayer.Character

    if not char then
        return nil
    end

    return char:FindFirstChildOfClass(
        "Humanoid"
    )
end


local function Corner(object,radius)

    local c =
        Instance.new("UICorner")

    c.CornerRadius =
        UDim.new(
            0,
            radius or 10
        )

    c.Parent =
        object

    return c
end


local function Stroke(
    object,
    color,
    thickness
)

    local s =
        Instance.new("UIStroke")

    s.Color =
        color
        or Config.Red

    s.Thickness =
        thickness
        or 1.5

    s.Transparency =
        0.10

    s.Parent =
        object

    return s
end


