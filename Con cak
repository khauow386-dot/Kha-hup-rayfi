--========================================================
-- TOGGLE
--========================================================

local function AddToggle(
    parent,
    key,
    default,
    callback
)

    local State =
        default

    local Button =
        Instance.new("TextButton")

    Button.Size =
        UDim2.new(
            1,
            -4,
            0,
            42
        )

    Button.TextColor3 =
        Config.White

    Button.TextSize =
        10

    Button.Font =
        Enum.Font.GothamBold

    Button.BorderSizePixel =
        0

    Button.AutoButtonColor =
        false

    Button.Parent =
        parent

    Corner(
        Button,
        10
    )

    Stroke(
        Button,
        Color3.fromRGB(
            55,
            55,
            65
        ),
        1
    )


    local Component = {

        Object = Button,

        Key = key,

        Type = "Toggle",

        State = function()
            return State
        end

    }


    table.insert(
        Components,
        Component
    )


    local function Update()

        Button.Text =
            T(key)
            .. " ["
            .. T(
                State
                and "ON"
                or "OFF"
            )
            .. "]"


        if State then

            Button.BackgroundColor3 =
                Config.Red

        else

            Button.BackgroundColor3 =
                Config.Panel2

        end

    end


    Component.Update =
        Update


    Button.MouseButton1Click:Connect(
        function()

            State =
                not State

            Update()

            task.spawn(
                function()

                    pcall(
                        callback,
                        State
                    )

                end
            )

        end
    )


    Update()


    task.spawn(
        function()

            pcall(
                callback,
                State
            )

        end
    )


    return Button

end


