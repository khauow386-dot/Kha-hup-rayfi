local function InstantTeleportToEgg(
    Position
)

    local Character, Humanoid, Root =
        GetCharacter()

    if not Character
        or not Humanoid
        or not Root then

        return false
    end

    Config.StopMovement = false

    local OldCollision = {}

    for _, Object in ipairs(
        Character:GetDescendants()
    ) do

        if Object:IsA("BasePart") then

            OldCollision[Object] =
                Object.CanCollide

            Object.CanCollide =
                false
        end
    end

    Root.AssemblyLinearVelocity =
        Vector3.zero

    Root.AssemblyAngularVelocity =
        Vector3.zero

    Root.CFrame =
        CFrame.new(Position)
        * Root.CFrame.Rotation

    task.delay(
        0.2,
        function()

            for Part, Value in pairs(
                OldCollision
            ) do

                if Part
                    and Part.Parent then

                    Part.CanCollide =
                        Value
                end
            end
        end
    )

    return true
end

