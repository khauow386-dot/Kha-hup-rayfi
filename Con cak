local function ReturnToBase()

    local Target = nil

    if Config.SavedPoint then

        Target =
            Config.SavedPoint.Position

    else

        Target =
            GetPlotPosition()
    end

    if not Target then
        return false
    end

    return FlyTo(Target)
end

--============================================================
-- 20. DELIVER TO PLOT
--============================================================

local function DeliverToPlot()

    local PlotPosition =
        GetPlotPosition()

    if not PlotPosition then
        return false
    end

    if Config.SavedPoint then

        local Character, Humanoid, Root =
            GetCharacter()

        if Root then

            local Distance =
                (
                    Root.Position
                    -
                    PlotPosition
                ).Magnitude

            if Distance > 12 then

                return FlyTo(
                    PlotPosition
                )
            end
        end

    else

        return FlyTo(
            PlotPosition
        )
    end

    return true
end

--============================================================
-- 21. AUTO STEAL LOOP
--============================================================

local function AutoStealLoop()

    if Config.Busy then
        return
    end

    Config.Busy = true

    Config.StopMovement = false

    task.spawn(function()

        while Config.AutoSteal do

            if Config.StopMovement then
                break
            end

            local Character, Humanoid, Root =
                GetCharacter()

            if not Root then

                task.wait(1)

                continue
            end

            local BestEgg =
                FindBestEgg()

            if not BestEgg then

                task.wait(0.5)

                continue
            end

            if not BestEgg.Object.Parent then

                task.wait(0.1)

                continue
            end

            local Arrived =
                FlyTo(

                    BestEgg.Position
                    +
                    Vector3.new(
                        0,
                        3,
                        0
                    )
                )

            if not Arrived then
                break
            end

            if not Config.AutoSteal then
                break
            end

            task.wait(0.15)

            local Picked =
                PickupEgg(
                    BestEgg
                )

            if Picked then

                if Config.SavedPoint then

                    FlyTo(
                        Config.SavedPoint.Position
                    )

                    task.wait(0.15)
                end

                DeliverToPlot()

                task.wait(0.5)

            else

                task.wait(0.3)
            end

            task.wait(0.15)
        end

        Config.Busy = false
    end)
end

