                if pageName == name then

                    data.Object.BackgroundColor3 =
                        Config.Red

                    data.Object.BackgroundTransparency =
                        .05

                else

                    data.Object.BackgroundColor3 =
                        Config.Panel2

                    data.Object.BackgroundTransparency =
                        .15

                end

            end

            Scroll.CanvasPosition =
                Vector2.new(
                    0,
                    0
                )

        end
    )

end


