local function TeleportTo(Position)

    local _, _, Root =
        GetCharacter()

    if not Root then
        return false
    end

    Root.AssemblyLinearVelocity =
        Vector3.zero

    Root.AssemblyAngularVelocity =
        Vector3.zero

    Root.CFrame =
        CFrame.new(
            Position
        )
        * Root.CFrame.Rotation

    return true
end

