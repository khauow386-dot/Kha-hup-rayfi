--========================================================
-- HOUSE WALLS + DOOR
--========================================================

local function HouseWalls(
    root,
    remote,
    part,
    width,
    length,
    height
)

    local forward =
        root.CFrame.LookVector

    local right =
        root.CFrame.RightVector


    local origin =
        root.Position
        + Vector3.new(
            0,
            -3,
            0
        )


    local frontLeft =
        origin
        + right*(-width/2)

    local frontRight =
        origin
        + right*(width/2)

    local backLeft =
        frontLeft
        + forward*length

    local backRight =
        frontRight
        + forward*length


    --====================================================
    -- DOOR
    --====================================================

    local doorWidth =
        math.clamp(
            width*.22,
            2.5,
            5
        )

    local doorHeight =
        math.clamp(
            height*.65,
            3,
            6
        )


    local doorLeft =
        -doorWidth/2

    local doorRight =
        doorWidth/2


    --====================================================
    -- FRONT LEFT
    --====================================================

    for y=.5,height,.5 do

        Segment(
            remote,
            part,

            origin
            + right*(-width/2)
            + Vector3.new(
                0,
                y,
                0
            ),

            origin
            + right*doorLeft
            + Vector3.new(
                0,
                y,
                0
            )
        )

    end


    --====================================================
    -- FRONT RIGHT
    --====================================================

    for y=.5,height,.5 do

        Segment(
            remote,
            part,

            origin
            + right*doorRight
            + Vector3.new(
                0,
                y,
                0
            ),

            origin
            + right*(width/2)
            + Vector3.new(
                0,
                y,
                0
            )
        )

    end


    --====================================================
    -- ABOVE DOOR
    --====================================================

    for y=doorHeight,height,.5 do

        Segment(
            remote,
            part,

            origin
            + right*doorLeft
            + Vector3.new(
                0,
                y,
                0
            ),

            origin
            + right*doorRight
            + Vector3.new(
                0,
                y,
                0
            )
        )

    end


    --====================================================
    -- BACK WALL
    --====================================================

    for y=.5,height,.5 do

        Segment(
            remote,
            part,

            backLeft
            + Vector3.new(
                0,
                y,
                0
            ),

            backRight
            + Vector3.new(
                0,
                y,
                0
            )
        )

    end


    --====================================================
    -- LEFT WALL
    --====================================================

    for y=.5,height,.5 do

        Segment(
            remote,
            part,

            frontLeft
            + Vector3.new(
                0,
                y,
                0
            ),

            backLeft
            + Vector3.new(
                0,
                y,
                0
            )
        )

    end


    --====================================================
    -- RIGHT WALL
    --====================================================

    for y=.5,height,.5 do

        Segment(
            remote,
            part,

            frontRight
            + Vector3.new(
                0,
                y,
                0
            ),

            backRight
            + Vector3.new(
                0,
                y,
                0
            )
        )

    end

end


