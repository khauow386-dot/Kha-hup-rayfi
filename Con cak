local function GetEggInfo(EggObject)

    if not EggObject then
        return nil, 0, "Common"
    end

    local EggName =
        EggObject:GetAttribute(
            "Egg"
        )

    if not EggName then
        return nil, 0, "Common"
    end

    local Luck =
        tonumber(
            EggObject:GetAttribute(
                "Luck"
            )
        ) or 0

    local Rarity =
        "Common"

    if EggsModule then

        local Data =
            EggsModule[EggName]

        if type(Data) == "table" then

            Luck =
                tonumber(Data.Luck)
                or Luck

            Rarity =
                Data.Rarity
                or Rarity
        end
    end

    return EggName, Luck, Rarity
end

