local function GetBasketCount()

    local Basket =
        Player:FindFirstChild(
            "Basket"
        )

    if not Basket then
        return 0
    end

    return #Basket:GetChildren()
end

local function PickupEgg(Egg)

    if not Egg then
        return false
    end

    if not GameRemotes then
        return false
    end

    local Remote =
        GameRemotes:FindFirstChild(
            "EggPickup"
        )

    if not Remote then
        return false
    end

    local Before =
        GetBasketCount()

    pcall(function()

        if Remote:IsA(
            "RemoteEvent"
        ) then

            Remote:FireServer(
                Egg.Object.Name
            )

        elseif Remote:IsA(
            "RemoteFunction"
        ) then

            Remote:InvokeServer(
                Egg.Object.Name
            )
        end
    end)

    local EndTime =
        os.clock() + 2

    while os.clock()
        < EndTime do

        if Config.Stop then
            return false
        end

        if GetBasketCount()
            > Before then

            return true
        end

        task.wait(0.05)
    end

    return false
end

