--========================================================
-- FIX LAG
--========================================================

local HiddenObjects = {}
local DisabledEffects = {}


local VegetationNames = {

    "tree",
    "trees",
    "plant",
    "plants",
    "grass",
    "leaf",
    "leaves",
    "bush",
    "bushes",
    "flower",
    "flowers",
    "foliage",
    "branch",
    "branches"

}


local function IsVegetation(
    object
)

    local name =
        string.lower(
            object.Name
        )


    for _,word in ipairs(
        VegetationNames
    ) do

        if string.find(
            name,
            word,
            1,
            true
        ) then

            return true

        end

    end


    return false

end


local function HideVegetation()

    local count =
        0


    for _,obj in ipairs(
        workspace:GetDescendants()
    ) do

        if obj:IsA("BasePart")
        and IsVegetation(obj)
        and not (
            LocalPlayer.Character
            and obj:IsDescendantOf(
                LocalPlayer.Character
            )
        ) then

            if HiddenObjects[obj] ==
                nil then

                HiddenObjects[obj] =
                    obj.LocalTransparencyModifier

                obj.LocalTransparencyModifier =
                    1

                count +=
                    1

            end

        end

    end


    Notify(
        "Fix Lag",
        "Hidden: "
        .. count
    )

end


local function DisableEffects()

    local count =
        0


    for _,obj in ipairs(
        workspace:GetDescendants()
    ) do

        if obj:IsA(
            "ParticleEmitter"
        )
        or obj:IsA(
            "Trail"
        )
        or obj:IsA(
            "Beam"
        )
        or obj:IsA(
            "Smoke"
        )
        or obj:IsA(
            "Fire"
        )
        or obj:IsA(
            "Sparkles"
        ) then

            if DisabledEffects[obj] ==
                nil then

                DisabledEffects[obj] =
                    obj.Enabled

                obj.Enabled =
                    false

                count +=
                    1

            end

        end

    end


    Notify(
        "Fix Lag",
        "Effects disabled: "
        .. count
    )

end


local function RestoreLag()

    for obj,value in pairs(
        HiddenObjects
    ) do

        if obj
        and obj.Parent then

            obj.LocalTransparencyModifier =
                value

        end

    end


    for obj,value in pairs(
        DisabledEffects
    ) do

        if obj
        and obj.Parent then

            obj.Enabled =
                value

        end

    end


    table.clear(
        HiddenObjects
    )

    table.clear(
        DisabledEffects
    )


    Notify(
        "Fix Lag",
        "Restored."
    )

end


AddToggle(
