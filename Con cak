local function GetCharacter()

    local Character =
        Player.Character

    if not Character then
        return nil, nil, nil
    end

    local Humanoid =
        Character:FindFirstChildOfClass(
            "Humanoid"
        )

    local Root =
        Character:FindFirstChild(
            "HumanoidRootPart"
        )

    if not Humanoid or not Root then
        return nil, nil, nil
    end

    if Humanoid.Health <= 0 then
        return nil, nil, nil
    end

    return Character, Humanoid, Root
end

