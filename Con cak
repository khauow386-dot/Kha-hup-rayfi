--============================================================
-- 16. PICKUP EGG
--============================================================

local function PickupEgg(Egg)

    if not Egg then
        return false
    end

    if not GameRemotes then
        return false
    end

    local EggPickup =
        GameRemotes:FindFirstChild("EggPickup")

    if not EggPickup then
        warn("[MINH KHA HUB] EggPickup remote not found")
        return false
    end

    local Before =
        #GetBasket()

    pcall(function()

        if EggPickup:IsA("RemoteEvent") then
            EggPickup:FireServer(Egg.Object.Name)
        end

    end)

    -- Wait for basket change
    local Timeout = os.clock() + 3

    while os.clock() < Timeout do

        if Config.StopMovement then
            return false
        end

        if #GetBasket() > Before then
            return true
        end

        task.wait(0.1)
    end

    return false
end

--============================================================
-- 17. RETURN TO BASE
--============================================================

local function ReturnToBase()

    local Target = nil

    -- Nếu user đã Set Point thì về điểm đó trước
    if Config.SavedPoint then

        Target =
            Config.SavedPoint.Position

    else

        Target =
            GetPlotPosition()
    end

    if not Target then
        return false
    end

    return FlyTo(Target)
end

--============================================================
-- 18. DELIVER TO PLOT
--============================================================

local function DeliverToPlot()

    local PlotPosition =
        GetPlotPosition()

    if not PlotPosition then
        return false
    end

    -- Nếu Saved Point khác plot,
    -- sau khi về saved point vẫn đưa egg về plot.
    if Config.SavedPoint then

        local Character, Humanoid, Root =
            GetCharacter()

        if Root then

            local Distance =
                (Root.Position - PlotPosition).Magnitude

            if Distance > 12 then
                return FlyTo(PlotPosition)
            end
        end
    else
        return FlyTo(PlotPosition)
    end

    return true
end

--============================================================
-- 19. AUTO STEAL LOOP
--============================================================

local function AutoStealLoop()

    if Config.Busy then
        return
    end

    Config.Busy = true
    Config.StopMovement = false

    task.spawn(function()

        while Config.AutoSteal do

            if Config.StopMovement then
                break
            end

            local Character, Humanoid, Root =
                GetCharacter()

            if not Root then
                task.wait(1)
                continue
            end

            -- Tìm egg
            local BestEgg =
                FindBestEgg()

            if not BestEgg then

                task.wait(0.5)

                continue
            end

            -- Kiểm tra egg còn tồn tại
            if not BestEgg.Object.Parent then
                task.wait(0.1)
                continue
            end

            -- Bay tới egg
            local Arrived =
                FlyTo(
                    BestEgg.Position +
                    Vector3.new(0, 3, 0)
                )

            if not Arrived then
                break
            end

            if not Config.AutoSteal then
                break
            end

            task.wait(0.15)

            -- Nhặt egg bằng remote thật của game
            local Picked =
                PickupEgg(BestEgg)

            if Picked then

                -- Về điểm đã lưu
                if Config.SavedPoint then

                    FlyTo(
                        Config.SavedPoint.Position
                    )

                    task.wait(0.15)
                end

                -- Sau đó về plot để giao egg
                DeliverToPlot()

                task.wait(0.5)

            else

                -- Egg không nhặt được
                task.wait(0.3)
            end

            task.wait(0.15)
        end

        Config.Busy = false
    end)
end

