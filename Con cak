        Color3.fromRGB(
            55,
            55,
            65
        ),
        1
    )


    Pages[name] =
        Page

    Tabs[name] = {
        Object = Tab,
        Key = languageKey
    }


    Tab.MouseButton1Click:Connect(
        function()

            for pageName,page in pairs(
                Pages
            ) do

                page.Visible =
                    pageName == name

            end


            for pageName,data in pairs(
                Tabs
