--========================================================
-- BUILD DATA
--========================================================

local function GetBuildData()

    local char,root =
        Character()

    if not char or not root then

        Notify(
            "Build",
            "Character not found."
        )

        return

    end


    local hammer =
        char:FindFirstChild(
            "Hammer"
        )

    if not hammer then

        Notify(
            "Build",
            "Equip Hammer first."
        )

        return

    end


    local remote =
        hammer:FindFirstChild(
            "BuildPlank"
        )

    if not remote then

        Notify(
            "Build",
            "BuildPlank not found."
        )

        return

    end


    local road =
        workspace:FindFirstChild(
            "Road"
        )

    if not road then

        Notify(
            "Build",
            "Road not found."
        )

        return

    end


    local children =
        road:GetChildren()

    local part =
        children[33]


    if not part
    or not part:IsA("BasePart") then

        Notify(
            "Build",
            "Build part not found."
        )

        return

    end


    return root,remote,part

end


--========================================================
-- SEGMENT
--========================================================

local function Segment(
    remote,
    part,
    A,
    B
)

    local distance =
        (B-A).Magnitude

    if distance < .05 then
        return
    end


    local direction =
        (B-A).Unit

    local current =
        A


    while distance > .05 do

        local length =
            math.min(
                10,
                distance
            )

        local nextPoint =
            current
            + direction
            * length


        pcall(
            function()

                remote:FireServer(
                    current,
                    nextPoint,
                    part,
                    part,
                    Vector3.new(
                        0,
                        1,
                        0
                    )
                )

            end
        )


        current =
            nextPoint

        distance -=
            length

        task.wait(
            .01
        )

    end

end


--========================================================
-- FLOOR
--========================================================

local function BuildFloor(
    width,
    length
)

    local root,remote,part =
        GetBuildData()

    if not root then
        return
    end


    width =
        math.max(
            2,
            width
        )

    length =
        math.max(
            2,
            length
        )


    local forward =
        root.CFrame.LookVector

    local right =
        root.CFrame.RightVector


    local origin =
        root.Position
        + Vector3.new(
            0,
            -3,
            0
        )


    for z = 0,length,2 do

        Segment(
            remote,
            part,

            origin
            + forward*z
            + right*(-width/2)
            + Vector3.new(
                0,
                .25,
                0
            ),

            origin
            + forward*z
            + right*(width/2)
            + Vector3.new(
                0,
                .25,
                0
            )
        )

    end


    Notify(
        "Build",
        "Floor complete."
    )

end


