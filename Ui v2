--============================================================
-- CREATE TAB
--============================================================

function Library:CreateTab(tabName)

    local page = Instance.new("Frame")

    page.Name = tostring(tabName)

    page.Parent = RightScroll

    page.Size = UDim2.new(1, -4, 0, 0)
    page.AutomaticSize = Enum.AutomaticSize.Y

    page.BackgroundTransparency = 1
    page.Visible = false
    page.ZIndex = 13

    local layout = Instance.new("UIListLayout")

    layout.Parent = page
    layout.Padding = UDim.new(0, 8)

    Pages[tabName] = page

    --========================================================
    -- TAB BUTTON
    --========================================================

    local tabBtn = Instance.new("TextButton")

    tabBtn.Parent = MenuScroll

    tabBtn.Size = UDim2.new(1, -4, 0, 42)

    tabBtn.BackgroundColor3 =
        Color3.fromRGB(43, 43, 51)

    tabBtn.BackgroundTransparency = 0.25

    tabBtn.BorderSizePixel = 0

    tabBtn.Text = tostring(tabName)

    tabBtn.TextColor3 =
        Color3.fromRGB(245, 245, 245)

    tabBtn.TextSize = 13
    tabBtn.Font = Enum.Font.GothamSemibold

    tabBtn.AutoButtonColor = false
    tabBtn.ZIndex = 13

    Corner(tabBtn, 9)
    Stroke(tabBtn)

    Tabs[tabName] = tabBtn

    tabBtn.MouseButton1Click:Connect(function()

        for pName, pObj in pairs(Pages) do
            pObj.Visible = pName == tabName
        end

        for tName, tObj in pairs(Tabs) do

            if tName == tabName then

                tObj.BackgroundColor3 =
                    Theme.BorderColor

                tObj.BackgroundTransparency = 0.05

            else

                tObj.BackgroundColor3 =
                    Color3.fromRGB(43, 43, 51)

                tObj.BackgroundTransparency = 0.25
            end
        end

        RightScroll.CanvasPosition =
            Vector2.new(0, 0)
    end)

    if firstTab then

        firstTab = false

        page.Visible = true

        tabBtn.BackgroundColor3 =
            Theme.BorderColor

        tabBtn.BackgroundTransparency = 0.05
    end

    --========================================================
    -- TAB FUNCTIONS
    --========================================================

    local TabFunctions = {}

    --========================================================
    -- BUTTON
    --========================================================

    function TabFunctions:CreateButton(text, callback)

        local btn = Instance.new("TextButton")

        btn.Parent = page

        btn.Size = UDim2.new(1, -4, 0, 46)

        btn.BackgroundColor3 =
            Color3.fromRGB(27, 27, 34)

        btn.BackgroundTransparency = 0.18
        btn.BorderSizePixel = 0

        btn.Text = tostring(text)

        btn.TextColor3 =
            Color3.fromRGB(245, 245, 245)

        btn.TextSize = 13
        btn.Font = Enum.Font.GothamBold

        btn.AutoButtonColor = false
        btn.ZIndex = 14

        Corner(btn, 10)

        Stroke(
            btn,
            Color3.fromRGB(55,55,65),
            1,
            0
        )

        btn.MouseButton1Click:Connect(function()

            pcall(function()
                if callback then
                    callback()
                end
            end)
        end)

        return btn
    end

    --========================================================
    -- TOGGLE
    --========================================================

    function TabFunctions:CreateToggle(text, default, callback)

        local Key =
            tostring(tabName)
            .. "_"
            .. tostring(text)

        local enabled = default == true

        if SaveData.Toggles[Key] ~= nil then
            enabled = SaveData.Toggles[Key] == true
        end

        local row = Instance.new("Frame")

        row.Parent = page

        row.Size = UDim2.new(1, -4, 0, 46)

        row.BackgroundColor3 =
            Color3.fromRGB(27, 27, 34)

        row.BackgroundTransparency = 0.18
        row.BorderSizePixel = 0
        row.ZIndex = 14

        Corner(row, 10)

        Stroke(
            row,
            Color3.fromRGB(55,55,65),
            1,
            0
        )

        local label = Instance.new("TextLabel")

        label.Parent = row

        label.Size = UDim2.new(1, -65, 1, 0)
        label.Position = UDim2.new(0, 12, 0, 0)

        label.BackgroundTransparency = 1

        label.Font = Enum.Font.GothamSemibold
        label.TextSize = 13

        label.TextColor3 =
            Color3.fromRGB(245,245,245)

        label.TextXAlignment =
            Enum.TextXAlignment.Left

        label.ZIndex = 15

        local toggleBtn = Instance.new("TextButton")

        toggleBtn.Parent = row

        toggleBtn.Size = UDim2.new(0, 42, 0, 23)

        toggleBtn.Position =
            UDim2.new(1, -51, 0.5, -11)

        toggleBtn.Text = ""

        toggleBtn.BorderSizePixel = 0
        toggleBtn.AutoButtonColor = false

        toggleBtn.ZIndex = 15

        Corner(toggleBtn, 12)

        local function update(runCallback)

            label.Text =
                tostring(text)
                .. "  ["
                .. (enabled and "ON" or "OFF")
                .. "]"

            toggleBtn.BackgroundColor3 =
                enabled
                and Theme.BorderColor
                or Color3.fromRGB(43,43,51)

            SaveData.Toggles[Key] =
                enabled

            QueueSave()

            if runCallback ~= false then

                pcall(function()

                    if callback then
                        callback(enabled)
                    end

                end)
            end
        end

        toggleBtn.MouseButton1Click:Connect(function()

            enabled = not enabled

            update(true)
        end)

        update(true)

        return {
            Set = function(_, value)

                enabled = value == true

                update(true)
            end,

            Get = function()
                return enabled
            end
        }
    end

    --========================================================
    -- INPUT
    --========================================================

    function TabFunctions:CreateInput(text, default, callback)

        local Key =
            tostring(tabName)
            .. "_"
            .. tostring(text)

        local savedValue =
            SaveData.Inputs[Key]

        if savedValue == nil then
            savedValue = default
        end

        local holder = Instance.new("Frame")

        holder.Parent = page

        holder.Size = UDim2.new(1, -4, 0, 49)

        holder.BackgroundColor3 =
            Color3.fromRGB(27,27,34)

        holder.BackgroundTransparency = 0.18
        holder.BorderSizePixel = 0
        holder.ZIndex = 14

        Corner(holder, 10)

        Stroke(
            holder,
            Color3.fromRGB(55,55,65),
            1,
            0
        )

        local label = Instance.new("TextLabel")

        label.Parent = holder

        label.Size = UDim2.new(0.38, 0, 1, 0)
        label.Position = UDim2.new(0, 10, 0, 0)

        label.BackgroundTransparency = 1

        label.Text = tostring(text)

        label.TextColor3 =
            Color3.fromRGB(245,245,245)

        label.TextSize = 13
        label.Font = Enum.Font.GothamBold

        label.TextXAlignment =
            Enum.TextXAlignment.Left

        label.ZIndex = 15

        local box = Instance.new("TextBox")

        box.Parent = holder

        box.Position =
            UDim2.new(0.40, 0, 0.12, 0)

        box.Size =
            UDim2.new(0.57, 0, 0.76, 0)

        box.BackgroundColor3 =
            Color3.fromRGB(12,12,16)

        box.BorderSizePixel = 0

        box.Text = tostring(savedValue)

        box.TextColor3 =
            Color3.fromRGB(245,245,245)

        box.TextSize = 13
        box.Font = Enum.Font.Gotham

        box.ClearTextOnFocus = false
        box.ZIndex = 15

        Corner(box, 7)

        box.FocusLost:Connect(function()

            local value = tonumber(box.Text)

            if value then

                SaveData.Inputs[Key] =
                    value

                QueueSave()

                pcall(function()

                    if callback then
                        callback(value)
                    end

                end)
            end
        end)

        return box
    end

    return TabFunctions
end

