local function BuildWall()

    local character, root, hammer, remote =
        getBuildData()

    if not remote then
        return
    end

    local ground =
        workspace:FindFirstChild("Ground")

    if not ground then
        notify(
            "Build Error",
            "Ground not found."
        )
        return
    end

    local part =
        ground:GetChildren()[9]

    if not part then
        notify(
            "Build Error",
            "Ground part #9 not found."
        )
        return
    end

    local forward =
        root.CFrame.LookVector

    local right =
        root.CFrame.RightVector

    local start =
        root.Position +
        forward * 2 +
        Vector3.new(
            0,
            -3,
            0
        )

    local function fire(p1, p2)

        remote:FireServer(
            p1,
            p2,
            part,
            part,
            Vector3.new(
                0,
                1,
                0
            )
        )
    end

    for y = 0.5, 6, 0.5 do

        fire(
            start +
                right * -6 +
                Vector3.new(
                    0,
                    y,
                    0
                ),

            start +
                right * 6 +
                Vector3.new(
                    0,
                    y,
                    0
                )
        )
    end

    notify(
        "Building",
        "Wall complete."
    )
end

