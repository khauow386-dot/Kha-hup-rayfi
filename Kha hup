local previewFolder = Instance.new("Folder")

previewFolder.Name = "KhaHubPreview"
previewFolder.Parent = workspace

local function clearPreview()
    for _, object in ipairs(
        previewFolder:GetChildren()
    ) do
        object:Destroy()
    end
end

local function createPreviewPart(size, cframe)
    local preview = Instance.new("Part")

    preview.Name = "PreviewPart"

    preview.Anchored = true
    preview.CanCollide = false
    preview.CanTouch = false
    preview.CanQuery = false
    preview.CastShadow = false

    preview.Transparency = 0.75
    preview.Color = Color3.fromRGB(
        0,
        255,
        0
    )

    preview.Material =
        Enum.Material.ForceField

    preview.Size = size
    preview.CFrame = cframe

    preview.Parent = previewFolder

    return preview
end

