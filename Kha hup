local vegetationKeywords = {
    "tree",
    "trees",
    "plant",
    "plants",
    "grass",
    "leaf",
    "leaves",
    "bush",
    "bushes",
    "flower",
    "flowers",
    "foliage",
    "branch",
    "branches"
}

local function isVegetation(object)

    local name =
        string.lower(object.Name)

    for _, keyword in ipairs(
        vegetationKeywords
    ) do

        if name:find(
            keyword,
            1,
            true
        ) then

            return true

        end

    end

    return false

end

--==================================================
-- HIDE VEGETATION
--==================================================

local function hideVegetation()

    local count = 0

    for _, object in ipairs(
        workspace:GetDescendants()
    ) do

        if object == previewFolder then
            continue
        end

        if LocalPlayer.Character
            and object:IsDescendantOf(
                LocalPlayer.Character
            )
        then
            continue
        end

        if object:IsA("BasePart")
            and isVegetation(object)
        then

            if hiddenObjects[object] == nil then

                hiddenObjects[object] =
                    object.LocalTransparencyModifier

                pcall(function()

                    object.LocalTransparencyModifier =
                        1

                end)

                count += 1

            end

        end

    end

    return count

end

--==================================================
-- DISABLE EFFECTS
--==================================================

local function disableEffects()

    local count = 0

    for _, object in ipairs(
        workspace:GetDescendants()
    ) do

        if object:IsA("ParticleEmitter")
            or object:IsA("Trail")
            or object:IsA("Beam")
            or object:IsA("Smoke")
            or object:IsA("Fire")
            or object:IsA("Sparkles")
        then

            if disabledEffects[object] == nil then

                disabledEffects[object] =
                    object.Enabled

                pcall(function()

                    object.Enabled = false

                end)

                count += 1

            end

        end

    end

    return count

end

--==================================================
-- RESTORE
--==================================================

local function restoreVegetation()

    for object, oldValue in pairs(
        hiddenObjects
    ) do

        if object and object.Parent then

            pcall(function()

                object.LocalTransparencyModifier =
                    oldValue

            end)

        end

    end

    table.clear(hiddenObjects)

end

local function restoreEffects()

    for object, oldValue in pairs(
        disabledEffects
    ) do

        if object and object.Parent then

            pcall(function()

                object.Enabled = oldValue

            end)

        end

    end

    table.clear(disabledEffects)

end

