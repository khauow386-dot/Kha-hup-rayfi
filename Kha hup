local function teleportToRandomAsset(searchName)
    local _, root = getCharacter()
    if not root then return end
    local matches = {}
    local target = string.lower(searchName)
    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("BasePart") then
            if string.find(string.lower(obj.Name), target, 1, true) then
                table.insert(matches, obj)
            end
        end
    end
    if #matches == 0 then
        notify("Items", "Không tìm thấy " .. searchName)
        return
    end
    local choice = matches[math.random(1, #matches)]
    root.CFrame = choice.CFrame + Vector3.new(0, 3, 0)
    notify("Items", "Đã tới " .. searchName)
end

