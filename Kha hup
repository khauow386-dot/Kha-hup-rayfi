local function getBuildData()

    local character, root =
        getCharacter()

    if not character or not root then
        notify(
            "Build Error",
            "Character not ready."
        )
        return nil
    end

    local hammer =
        character:FindFirstChild("Hammer")

    if not hammer then
        notify(
            "Build Error",
            "Hammer not found."
        )
        return nil
    end

    local remote =
        hammer:FindFirstChild(
            "BuildPlank"
        )

    if not remote then
        notify(
            "Build Error",
            "BuildPlank not found."
        )
        return nil
    end

    return character, root, hammer, remote
end

--==================================================
-- BUILD HUT
--==================================================

local function BuildHut()

    local character, root, hammer, remote =
        getBuildData()

    if not remote then
        return
    end

    local road =
        workspace:FindFirstChild("Road")

    if not road then
        notify(
            "Build Error",
            "Road not found."
        )
        return
    end

    local part =
        road:GetChildren()[33]

    if not part then
        notify(
            "Build Error",
            "Road part #33 not found."
        )
        return
    end

    local forward =
        root.CFrame.LookVector

    local right =
        root.CFrame.RightVector

    local origin =
        root.Position +
        Vector3.new(
            0,
            -3,
            0
        )

    local function fire(p1, p2)

        remote:FireServer(
            p1,
            p2,
            part,
            part,
            Vector3.new(
                0,
                1,
                0
            )
        )
    end

    -- Front
    for y = 0.5, 7, 0.5 do

        if y < 1 or y > 5.5 then

            fire(
                origin +
                    right * -6 +
                    Vector3.new(
                        0,
                        y,
                        0
                    ),

                origin +
                    right * 6 +
                    Vector3.new(
                        0,
                        y,
                        0
                    )
            )

        else

            fire(
                origin +
                    right * -6 +
                    Vector3.new(
                        0,
                        y,
                        0
                    ),

                origin +
                    right * -2 +
                    Vector3.new(
                        0,
                        y,
                        0
                    )
            )

            fire(
                origin +
                    right * 2 +
                    Vector3.new(
                        0,
                        y,
                        0
                    ),

                origin +
                    right * 6 +
                    Vector3.new(
                        0,
                        y,
                        0
                    )
            )
        end
    end

    -- Right
    for y = 0.5, 7, 0.5 do

        fire(
            origin +
                right * 6 +
                Vector3.new(
                    0,
                    y,
                    0
                ),

            origin +
                right * 6 +
                forward * 12 +
                Vector3.new(
                    0,
                    y,
                    0
                )
        )
    end

    -- Back
    for y = 0.5, 7, 0.5 do

        fire(
            origin +
                right * -6 +
                forward * 12 +
                Vector3.new(
                    0,
                    y,
                    0
                ),

            origin +
                right * 6 +
                forward * 12 +
                Vector3.new(
                    0,
                    y,
                    0
                )
        )
    end

    -- Left
    for y = 0.5, 7, 0.5 do

        fire(
            origin +
                right * -6 +
                Vector3.new(
                    0,
                    y,
                    0
                ),

            origin +
                right * -6 +
                forward * 12 +
                Vector3.new(
                    0,
                    y,
                    0
                )
        )
    end

    -- Roof
    for z = 0, 12, 2 do

        fire(
            origin +
                right * -6 +
                forward * z +
                Vector3.new(
                    0,
                    7.5,
                    0
                ),

            origin +
                right * 6 +
                forward * z +
                Vector3.new(
                    0,
                    7.5,
                    0
                )
        )
    end

    notify(
        "Building",
        "Hut complete."
    )
end

