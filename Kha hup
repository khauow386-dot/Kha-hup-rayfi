    Toggle(P.Building,"FloatBuild",FloatingBuildGui ~= nil,function(v)
        SetFloatingBuild(v)
    end,"mkh_float_build")

    -- XÂY DỰNG VIP
    P.VIP:CreateSection(T("VIP"))

    Button(P.VIP,"VIPHut",function()
        VIPType = "hut"
        VIPWidth = 12
        VIPLength = 12
        VIPHeight = 7

        Notify("VIP","Đã chọn Hut.")
    end)

    Button(P.VIP,"VIPWall",function()
        VIPType = "wall"
        VIPWidth = 12
        VIPLength = 1
        VIPHeight = 6

        Notify("VIP","Đã chọn Wall.")
    end)

    Button(P.VIP,"Floor",function()
        VIPType = "floor"
        VIPWidth = 12
        VIPLength = 12
        VIPHeight = 1

        Notify("VIP","Đã chọn Floor.")
    end)

    Button(P.VIP,"VIPBig",function()
        VIPType = "big"
        VIPWidth = 60
        VIPLength = 60
        VIPHeight = 10

        Notify("VIP","Đã chọn Big House.")
    end)

    Button(P.VIP,"BigFloor",function()
        VIPType = "bigfloor"
        VIPWidth = 100
        VIPLength = 100
        VIPHeight = 1

        Notify("VIP","Đã chọn Big Floor.")
    end)

    Input(P.VIP,"Width",VIPWidth,function(v)
        VIPWidth = math.clamp(tonumber(v) or VIPWidth,2,200)
    end,"mkh_vip_width")

    Input(P.VIP,"Length",VIPLength,function(v)
        VIPLength = math.clamp(tonumber(v) or VIPLength,2,200)
    end,"mkh_vip_length")

    Input(P.VIP,"Height",VIPHeight,function(v)
        VIPHeight = math.clamp(tonumber(v) or VIPHeight,3,50)
    end,"mkh_vip_height")

    Toggle(P.VIP,"WithFloor",VIPFloor,function(v)
        VIPFloor = v
    end,"mkh_vip_floor")

    Button(P.VIP,"VIPBuild",function()
        if VIPType == "hut" or VIPType == "big" then
            BuildHouse(VIPWidth,VIPLength,VIPHeight,VIPFloor)

        elseif VIPType == "wall" then
            BuildWall(VIPWidth,VIPHeight)

        elseif VIPType == "floor" or VIPType == "bigfloor" then
            BuildFloor(VIPWidth,VIPLength)

        else
            Notify("VIP","Hãy chọn kiểu xây.")
        end
    end)

    -- DỊCH CHUYỂN
    P.Teleport:CreateSection(T("Teleport"))

    Button(P.Teleport,"Save",SavePosition)
    Button(P.Teleport,"Return",ReturnPosition)

    Input(P.Teleport,"X",CoordX,function(v)
        CoordX = tonumber(v) or CoordX
    end,"mkh_coord_x")

    Input(P.Teleport,"Y",CoordY,function(v)
        CoordY = tonumber(v) or CoordY
    end,"mkh_coord_y")

    Input(P.Teleport,"Z",CoordZ,function(v)
        CoordZ = tonumber(v) or CoordZ
    end,"mkh_coord_z")

    Button(P.Teleport,"Coords",CopyCoordinates)
    Button(P.Teleport,"GoCoords",GoCoordinates)
    Button(P.Teleport,"Highest",HighestFloor)

    Button(P.Teleport,"Shop",function()
        TeleportTo(-425,6,77)
    end)

    Button(P.Teleport,"Main",function()
        TeleportTo(-394,3,423)
    end)

    -- GIẢM LAG
    P.Lag:CreateSection(T("Lag"))

    Toggle(P.Lag,"FixAll",false,function(v)
        if v then
            HideVegetation()
            DisableEffects()
        else
            RestoreLag()
        end
    end,"mkh_fix_all")

    Button(P.Lag,"Vegetation",HideVegetation)
    Button(P.Lag,"Effects",DisableEffects)
    Button(P.Lag,"Restore",RestoreLag)

    -- NGÔN NGỮ
    P.Language:CreateSection(T("Language"))

    Button(P.Language,"Vietnamese",function()
        env.__MKH_LANGUAGE = "VN"
        Config.Language = "VN"
        BuildInterface()
        Notify("Settings","Tiếng Việt")
    end)

    Button(P.Language,"English",function()
        env.__MKH_LANGUAGE = "EN"
        Config.Language = "EN"
        BuildInterface()
        Notify("Settings","English")
    end)

    Button(P.Language,"Switch",function()
        local nextLang = (Config.Language == "VN") and "EN" or "VN"

        env.__MKH_LANGUAGE = nextLang
        Config.Language = nextLang

        BuildInterface()
    end)

    pcall(function()
        Library:SetAccent(Color3.fromRGB(220,25,45))
    end)

    Notify("MINH KHA HUP","Ready • "..Config.Language)
end

BuildInterface()
