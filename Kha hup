local function teleportToNearestItem()
    local _, root = getCharacter()
    if not root then return end
    local targetPart = nil
    local shortestDist = math.huge
    
    for _, obj in ipairs(Workspace:GetDescendants()) do
        if obj:IsA("BasePart") and not obj:IsDescendantOf(LocalPlayer.Character) then
            local name = obj.Name:lower()
            if name:find("item") or name:find("drop") or name:find("loot") or name:find("hammer") or name:find("plank") or name:find("food") or name:find("money") or name:find("shell") or name:find("bullet") then
                local dist = (obj.Position - root.Position).Magnitude
                if dist < shortestDist then
                    shortestDist = dist
                    targetPart = obj
                end
            end
        end
    end
    
    if targetPart then
        root.CFrame = targetPart.CFrame + Vector3.new(0, 2, 0)
        notify("Item Teleport", "Đã bay đến vật phẩm gần nhất!")
    else
        notify("Item Teleport", "Không tìm thấy vật phẩm gần đây.")
    end
end

