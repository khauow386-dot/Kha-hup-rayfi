--==================================================
-- AUTO HIDE NEW VEGETATION
--==================================================

workspace.DescendantAdded:Connect(
    function(object)

        if not fixLagEnabled then
            return
        end

        task.defer(
            function()

                if not object
                    or not object.Parent
                then
                    return
                end

                if object:IsA("BasePart")
                    and isVegetation(object)
                then

                    if not (
                        LocalPlayer.Character
                        and object:IsDescendantOf(
                            LocalPlayer.Character
                        )
                    ) then

                        if hiddenObjects[object] == nil then

                            hiddenObjects[object] =
                                object.LocalTransparencyModifier

                            pcall(function()

                                object.LocalTransparencyModifier =
                                    1

                            end)

                        end

                    end

                end

                if object:IsA("ParticleEmitter")
                    or object:IsA("Trail")
                    or object:IsA("Beam")
                    or object:IsA("Smoke")
                    or object:IsA("Fire")
                    or object:IsA("Sparkles")
                then

                    if disabledEffects[object] == nil then

                        disabledEffects[object] =
                            object.Enabled

                        pcall(function()

                            object.Enabled =
                                false

                        end)

                    end

                end

            end
        )

    end
)

