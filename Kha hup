local function BuildHut()
    local _, root, _, remote = getBuildData()
    if not remote then return end
    local Road = workspace:FindFirstChild("Road")
    if not Road then notify("Build", "Không tìm thấy Road.") return end
    local part = Road:GetChildren()[33]
    if not part or not part:IsA("BasePart") then return end
    local forward = root.CFrame.LookVector
    local right = root.CFrame.RightVector
    local origin = root.Position + Vector3.new(0, -3, 0)
    local function fire(p1, p2)
        remote:FireServer(p1, p2, part, part, Vector3.new(0, 1, 0))
    end
    for y = .5, 7, .5 do
        if y < 1 or y > 5.5 then
            fire(origin + right*-6 + Vector3.new(0,y,0), origin + right*6 + Vector3.new(0,y,0))
        else
            fire(origin + right*-6 + Vector3.new(0,y,0), origin + right*-2 + Vector3.new(0,y,0))
            fire(origin + right*2 + Vector3.new(0,y,0), origin + right*6 + Vector3.new(0,y,0))
        end
    end
    for y = .5, 7, .5 do
        fire(origin + right*6 + Vector3.new(0,y,0), origin + right*6 + forward*12 + Vector3.new(0,y,0))
        fire(origin + right*-6 + Vector3.new(0,y,0), origin + right*-6 + forward*12 + Vector3.new(0,y,0))
        fire(origin + right*-6 + forward*12 + Vector3.new(0,y,0), origin + right*6 + forward*12 + Vector3.new(0,y,0))
    end
    for z = 0, 12, 2 do
        fire(origin + right*-6 + forward*z + Vector3.new(0,7.5,0), origin + right*6 + forward*z + Vector3.new(0,7.5,0))
    end
    notify("Build", "Xây Hut hoàn thành.")
end

