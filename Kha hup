local function GetBuildData()
    local char,root = Character()

    if not char or not root then
        Notify("Build","Không tìm thấy nhân vật.")
        return
    end

    local hammer = char:FindFirstChild("Hammer")

    if not hammer then
        Notify("Build","Hãy trang bị Hammer trước.")
        return
    end

    local remote = hammer:FindFirstChild("BuildPlank")

    if not remote then
        Notify("Build","Không tìm thấy BuildPlank.")
        return
    end

    local road = workspace:FindFirstChild("Road")

    if not road then
        Notify("Build","Không tìm thấy Road.")
        return
    end

    local part = road:GetChildren()[33]

    if not part or not part:IsA("BasePart") then
        Notify("Build","Không tìm thấy Build Part.")
        return
    end

    return root,remote,part
end

local function Segment(remote,part,A,B)
    local distance = (B-A).Magnitude

    if distance < 0.05 then return end

    local direction = (B-A).Unit
    local current = A

    while distance > 0.05 do
        local length = math.min(10,distance)
        local nextPoint = current + direction*length

        pcall(function()
            remote:FireServer(
                current,
                nextPoint,
                part,
                part,
                Vector3.new(0,1,0)
            )
        end)

        current = nextPoint
        distance = distance-length

        task.wait(0.01)
    end
end

local function BuildFloor(width,length)
    local root,remote,part = GetBuildData()
    if not root then return end

    width = math.max(2,width)
    length = math.max(2,length)

    local f = root.CFrame.LookVector
    local r = root.CFrame.RightVector
    local o = root.Position + Vector3.new(0,-3,0)

    for z=0,length,2 do
        Segment(
            remote,
            part,
            o+f*z+r*(-width/2)+Vector3.new(0,0.25,0),
            o+f*z+r*(width/2)+Vector3.new(0,0.25,0)
        )
    end

    Notify("Build","Đã hoàn thành sàn.")
end

local function BuildWall(width,height)
    local root,remote,part = GetBuildData()
    if not root then return end

    width = math.max(2,width)
    height = math.max(2,height)

    local r = root.CFrame.RightVector
    local o = root.Position + Vector3.new(0,-3,0)

    for y=0.5,height,0.5 do
        Segment(
            remote,
            part,
            o+r*(-width/2)+Vector3.new(0,y,0),
            o+r*(width/2)+Vector3.new(0,y,0)
        )
    end

    Notify("Build","Đã hoàn thành tường.")
end

local function HouseFloor(root,remote,part,width,length)
    local f = root.CFrame.LookVector
    local r = root.CFrame.RightVector
    local o = root.Position + Vector3.new(0,-3,0)

    for z=0,length,2 do
        Segment(
            remote,
            part,
            o+f*z+r*(-width/2)+Vector3.new(0,0.25,0),
            o+f*z+r*(width/2)+Vector3.new(0,0.25,0)
        )
    end
end

local function HouseWalls(root,remote,part,width,length,height)
    local f = root.CFrame.LookVector
    local r = root.CFrame.RightVector
    local o = root.Position + Vector3.new(0,-3,0)

    local fl = o+r*(-width/2)
    local fr = o+r*(width/2)
    local bl = fl+f*length
    local br = fr+f*length

    local dw = math.clamp(width*0.22,2.5,5)
    local dh = math.clamp(height*0.65,3,6)

    for y=0.5,height,0.5 do
        Segment(
            remote,part,
            o+r*(-width/2)+Vector3.new(0,y,0),
            o+r*(-dw/2)+Vector3.new(0,y,0)
        )

        Segment(
            remote,part,
            o+r*(dw/2)+Vector3.new(0,y,0),
            o+r*(width/2)+Vector3.new(0,y,0)
        )
    end

    for y=dh,height,0.5 do
        Segment(
            remote,part,
            o+r*(-dw/2)+Vector3.new(0,y,0),
            o+r*(dw/2)+Vector3.new(0,y,0)
        )
    end

    for y=0.5,height,0.5 do
        Segment(
            remote,part,
            bl+Vector3.new(0,y,0),
            br+Vector3.new(0,y,0)
        )

        Segment(
            remote,part,
            fl+Vector3.new(0,y,0),
            bl+Vector3.new(0,y,0)
        )

        Segment(
            remote,part,
            fr+Vector3.new(0,y,0),
            br+Vector3.new(0,y,0)
        )
    end
end

local function BuildRoof(root,remote,part,width,length,height)
    local f = root.CFrame.LookVector
    local r = root.CFrame.RightVector
    local o = root.Position + Vector3.new(0,-3,0)
    local y = height+0.5

    for z=0,length,2 do
        Segment(
            remote,part,
            o+f*z+r*(-width/2)+Vector3.new(0,y,0),
            o+f*z+r*(width/2)+Vector3.new(0,y,0)
        )
    end

    Segment(
        remote,part,
        o+r*(-width/2)+Vector3.new(0,y,0),
        o+r*(width/2)+Vector3.new(0,y,0)
    )

    Segment(
        remote,part,
        o+f*length+r*(-width/2)+Vector3.new(0,y,0),
        o+f*length+r*(width/2)+Vector3.new(0,y,0)
    )
end

local function BuildHouse(width,length,height,withFloor)
    local root,remote,part = GetBuildData()
    if not root then return end

    width = math.max(4,width)
    length = math.max(4,length)
    height = math.max(3,height)

    if withFloor then
        HouseFloor(root,remote,part,width,length)
        task.wait(0.1)
    end

    HouseWalls(root,remote,part,width,length,height)
    task.wait(0.1)

    BuildRoof(root,remote,part,width,length,height)

    Notify("Build","Đã hoàn thành nhà + cửa + mái.")
end

