local vegetationKeywords = {"tree", "trees", "plant", "plants", "grass", "leaf", "leaves", "bush", "bushes", "flower", "flowers", "foliage", "branch", "branches"}

local function isVegetation(object)
    local name = string.lower(object.Name)
    for _, keyword in ipairs(vegetationKeywords) do
        if string.find(name, keyword, 1, true) then return true end
    end
    return false
end

local function hideVegetation()
    local count = 0
    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("BasePart") and not obj:IsDescendantOf(previewFolder) and not (LocalPlayer.Character and obj:IsDescendantOf(LocalPlayer.Character)) and isVegetation(obj) then
            if hiddenObjects[obj] == nil then
                hiddenObjects[obj] = obj.LocalTransparencyModifier
                obj.LocalTransparencyModifier = 1
                count += 1
            end
        end
    end
    notify("Fix Lag", "Đã ẩn " .. count .. " vật thể cây/cỏ.")
end

local function disableEffects()
    local count = 0
    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("ParticleEmitter") or obj:IsA("Trail") or obj:IsA("Beam") or obj:IsA("Smoke") or obj:IsA("Fire") or obj:IsA("Sparkles") then
            if disabledEffects[obj] == nil then
                disabledEffects[obj] = obj.Enabled
                obj.Enabled = false
                count += 1
            end
        end
    end
    notify("Fix Lag", "Đã tắt " .. count .. " hiệu ứng/hạt.")
end

local function restoreVegetation()
    for obj, oldValue in pairs(hiddenObjects) do
        if obj and obj.Parent then
            obj.LocalTransparencyModifier = oldValue
        end
    end
    table.clear(hiddenObjects)
end

local function restoreEffects()
    for obj, oldValue in pairs(disabledEffects) do
        if obj and obj.Parent then
            obj.Enabled = oldValue
        end
    end
    table.clear(disabledEffects)
end

AddToggle(LagPage, "Bật Fix Lag Tổng Thể", false, function(value)
    fixLagEnabled = value
    if value then
        hideVegetation()
        disableEffects()
        pcall(function() settings().Rendering.QualityLevel = Enum.QualityLevel.Level01 end)
        notify("Fix Lag", "Đã bật chế độ Fix Lag tối đa.")
    else
        restoreVegetation()
        restoreEffects()
        notify("Fix Lag", "Đã khôi phục cài đặt gốc.")
    end
end)

AddButton(LagPage, "Ẩn Toàn Bộ Cây / Cỏ", function() hideVegetation() end)
