BuildTab:CreateInput({
    name = "Select Build",
    placeholder = "hut / wall / floor / big house",
    removeTextAfterFocusLost = false,

    callback = function(text)

        text =
            tostring(text)
            :lower()
            :gsub("^%s+", "")
            :gsub("%s+$", "")

        if text == "hut"
            or text == "wall"
            or text == "floor"
            or text == "big house"
        then

            selectedBuild =
                text

            notify(
                "Build Selected",
                selectedBuild
            )

        else

            notify(
                "Invalid Build",
                "Use: hut, wall, floor, big house"
            )
        end
    end
})

--==================================================
-- BUILD SELECTED
--==================================================

local function buildSelected()

    if selectedBuild == "hut" then

        BuildHut()

    elseif selectedBuild == "wall" then

        BuildWall()

    elseif selectedBuild == "floor" then

        BuildFloor()

    elseif selectedBuild == "big house" then

        BuildBigHouse()

    else

        notify(
            "Build Error",
            "Unknown build type."
        )
    end
end

