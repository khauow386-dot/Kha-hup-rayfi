local function getBuildData()
    local character, root = getCharacter()
    if not character or not root then return end
    local hammer = character:FindFirstChild("Hammer")
    if not hammer then notify("Build", "Hãy cầm Hammer trên tay.") return end
    local remote = hammer:FindFirstChild("BuildPlank")
    if not remote then return end
    return character, root, hammer, remote
end

local function fireSegment(remote, p1, p2, part)
    local distance = (p2-p1).Magnitude
    if distance <= 0.05 then return end
    local direction = (p2-p1).Unit
    local current = p1
    local remaining = distance
    while remaining > 0.05 do
        local length = math.min(10, remaining)
        local nextPoint = current + direction*length
        pcall(function() remote:FireServer(current, nextPoint, part, part, Vector3.new(0,1,0)) end)
        task.wait(0.003)
        current = nextPoint
        remaining = remaining - length
    end
end

-- 1. Mẫu Lâu Đài (Castle)
local function BuildCastleCustom()
    local _, root, _, remote = getBuildData()
    if not remote then return end
    local Road = Workspace:FindFirstChild("Road") or Workspace:FindFirstChild("Ground")
    if not Road then return end
    local part = Road:GetChildren()[33] or Road:GetChildren()[9]
    if not part then return end

    local w = buildWidth / 2
    local l = buildLength
    local h = buildHeight
    local forward = root.CFrame.LookVector
    local right = root.CFrame.RightVector
    local origin = root.Position + Vector3.new(0, -3, 0)

    notify("Lâu Đài", "Đang xây dựng Lâu Đài...")

    local c1 = origin + right*(-w)
    local c2 = origin + right*w
    local c3 = origin + right*w + forward*l
    local c4 = origin + right*(-w) + forward*l

    local function buildCastleWall(p1, p2, wallHeight, hasGate)
        local wallDir = (p2-p1).Unit
        local wallLen = (p2-p1).Magnitude
        local mid = p1 + wallDir*(wallLen/2)
        local gateW = 12
        local gLeft = mid - wallDir*(gateW/2)
        local gRight = mid + wallDir*(gateW/2)

        for y = 0.5, wallHeight, 0.5 do
            if hasGate and y <= 10 then
                fireSegment(remote, p1 + Vector3.new(0,y,0), gLeft + Vector3.new(0,y,0), part)
                fireSegment(remote, gRight + Vector3.new(0,y,0), p2 + Vector3.new(0,y,0), part)
            else
                fireSegment(remote, p1 + Vector3.new(0,y,0), p2 + Vector3.new(0,y,0), part)
            end
        end
    end

    buildCastleWall(c1, c2, h, true)
    buildCastleWall(c2, c3, h, false)
    buildCastleWall(c3, c4, h, false)
    buildCastleWall(c4, c1, h, false)

    if buildHasFloor then
        for z = 0, l, 4 do
            fireSegment(remote, origin + forward*z + right*(-w) + Vector3.new(0, 0.3, 0), origin + forward*z + right*w + Vector3.new(0, 0.3, 0), part)
        end
    end
    notify("Lâu Đài", "Xây Lâu Đài Thành Công!")
end

-- 2. Mẫu Tháp Phòng Thủ (Tower)
local function BuildTowerCustom()
    local _, root, _, remote = getBuildData()
    if not remote then return end
    local Road = Workspace:FindFirstChild("Road") or Workspace:FindFirstChild("Ground")
    if not Road then return end
    local part = Road:GetChildren()[33] or Road:GetChildren()[9]
    if not part then return end

    local radius = math.clamp(buildWidth / 3, 10, 25)
    local h = buildHeight * 1.2
    local origin = root.Position + Vector3.new(0, -3, 0)
    local forward = root.CFrame.LookVector

    notify("Tháp Canh", "Đang xây Tháp Phòng Thủ...")

    -- Xây các tầng tháp hình trụ tròn đa giác
    local sides = 8
    local points = {}
    for i = 1, sides do
        local angle = (i / sides) * (math.pi * 2)
        local x = math.cos(angle) * radius
        local z = math.sin(angle) * radius
        table.insert(points, origin + Vector3.new(x, 0, z))
    end

    for y = 0.5, h, 0.8 do
        for i = 1, #points do
            local p1 = points[i] + Vector3.new(0, y, 0)
            local p2 = points[(i % #points) + 1] + Vector3.new(0, y, 0)
            -- Tạo lối ra cửa ở tầng trệt
            if not (y <= 8 and i == 1) then
                fireSegment(remote, p1, p2, part)
            end
        end
    end

    if buildHasFloor then
        for y = 4, h, 4 do
            for i = 1, #points do
                fireSegment(remote, origin + Vector3.new(0, y, 0), points[i] + Vector3.new(0, y, 0), part)
            end
        end
    end

    -- Mái chóp tháp
    for i = 1, #points do
        local p1 = points[i] + Vector3.new(0, h, 0)
        local pPeak = origin + Vector3.new(0, h + 10, 0)
        fireSegment(remote, p1, pPeak, part)
    end

    notify("Tháp Canh", "Xây Tháp Phòng Thủ Thành Công!")
end

-- 3. Mẫu Pháo Đài Kiên Cố (Fortress)
local function BuildFortressCustom()
    local _, root, _, remote = getBuildData()
    if not remote then return end
    local Road = Workspace:FindFirstChild("Road") or Workspace:FindFirstChild("Ground")
    if not Road then return end
    local part = Road:GetChildren()[33] or Road:GetChildren()[9]
    if not part then return end

    local w = (buildWidth / 2) * 1.3
    local l = buildWidth * 1.3
    local h = 14
    local forward = root.CFrame.LookVector
    local right = root.CFrame.RightVector
    local origin = root.Position + Vector3.new(0, -3, 0)

    notify("Pháo Đài", "Đang xây Pháo Đài Quân Sự...")

    -- Tường thành dày đôi
    for offset = 0, 1.5, 1.5 do
        local tw = w + offset
        local tl = l + offset
        local c1 = origin + right*(-tw)
        local c2 = origin + right*tw
        local c3 = origin + right*tw + forward*tl
        local c4 = origin + right*(-tw) + forward*tl

        for y = 0.5, h, 0.6 do
            fireSegment(remote, c1 + Vector3.new(0,y,0), c2 + Vector3.new(0,y,0), part)
            fireSegment(remote, c2 + Vector3.new(0,y,0), c3 + Vector3.new(0,y,0), part)
            fireSegment(remote, c3 + Vector3.new(0,y,0), c4 + Vector3.new(0,y,0), part)
            fireSegment(remote, c4 + Vector3.new(0,y,0), c1 + Vector3.new(0,y,0), part)
        end
    end

    if buildHasFloor then
        for z = 0, l, 5 do
            fireSegment(remote, origin + forward*z + right*(-w) + Vector3.new(0, 0.4, 0), origin + forward*z + right*w + Vector3.new(0, 0.4, 0), part)
        end
    end

    notify("Pháo Đài", "Xây Pháo Đài Thành Công!")
end

-- 4. Mẫu Hầm Trú Ẩn / Nhà Kho (Bunker)
local function BuildBunkerCustom()
    local _, root, _, remote = getBuildData()
    if not remote then return end
    local Road = Workspace:FindFirstChild("Road") or Workspace:FindFirstChild("Ground")
    if not Road then return end
    local part = Road:GetChildren()[33] or Road:GetChildren()[9]
    if not part then return end

    local w = buildWidth / 2
    local l = buildLength * 0.8
    local h = 10
    local forward = root.CFrame.LookVector
    local right = root.CFrame.RightVector
    local origin = root.Position + Vector3.new(0, -3, 0)

    notify("Hầm Trú Ẩn", "Đang xây Hầm Trú Ẩn vòm...")

    -- Xây thân hầm
    local c1 = origin + right*(-w)
    local c2 = origin + right*w
    local c3 = origin + right*w + forward*l
    local c4 = origin + right*(-w) + forward*l

    for y = 0.5, h, 0.5 do
        fireSegment(remote, c1 + Vector3.new(0,y,0), c4 + Vector3.new(0,y,0), part)
        fireSegment(remote, c2 + Vector3.new(0,y,0), c3 + Vector3.new(0,y,0), part)
    end

    -- Mái vòm cong kín
    for z = 0, l, 3 do
        local archOrigin = origin + forward*z
        for angle = 0, math.pi, 0.4 do
            local x1 = math.cos(angle) * w
            local y1 = math.sin(angle) * w + h
            local nextAngle = angle + 0.4
            local x2 = math.cos(nextAngle) * w
            local y2 = math.sin(nextAngle) * w + h
            fireSegment(remote, archOrigin + right*x1 + Vector3.new(0, y1 - h, 0), archOrigin + right*x2 + Vector3.new(0, y2 - h, 0), part)
        end
    end

    if buildHasFloor then
        for z = 0, l, 4 do
            fireSegment(remote, origin + forward*z + right*(-w) + Vector3.new(0, 0.2, 0), origin + forward*z + right*w + Vector3.new(0, 0.2, 0), part)
        end
    end

    notify("Hầm Trú Ẩn", "Xây Hầm Trú Ẩn Thành Công!")
end

