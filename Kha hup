local SavedCFrame

local CoordX = 0
local CoordY = 0
local CoordZ = 0

local function SavePosition()
    local _,root = Character()

    if root then
        SavedCFrame = root.CFrame
        Notify("Teleport","Đã lưu vị trí.")
    end
end

local function ReturnPosition()
    local _,root = Character()

    if root and SavedCFrame then
        root.CFrame = SavedCFrame
    else
        Notify("Teleport","Chưa có vị trí được lưu.")
    end
end

local function CopyCoordinates()
    local _,root = Character()
    if not root then return end

    local p = root.Position

    CoordX,CoordY,CoordZ = p.X,p.Y,p.Z

    local s = string.format(
        "%.2f, %.2f, %.2f",
        CoordX,CoordY,CoordZ
    )

    pcall(function()
        if setclipboard then
            setclipboard(s)
        end
    end)

    Notify("Coordinates",s)
end

local function GoCoordinates()
    local _,root = Character()

    if root then
        root.CFrame = CFrame.new(CoordX,CoordY,CoordZ)
    end
end

local function HighestFloor()
    local highest
    local highestY = -math.huge

    for _,obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("BasePart")
        and obj.CanCollide
        and obj.Transparency < 1
        and obj.Size.X >= 3
        and obj.Size.Z >= 3 then

            local top = obj.Position.Y+obj.Size.Y/2

            if top > highestY then
                highestY = top
                highest = obj
            end
        end
    end

    local _,root = Character()

    if highest and root then
        root.CFrame = CFrame.new(
            highest.Position.X,
            highestY+4,
            highest.Position.Z
        )
    else
        Notify("Teleport","Không tìm thấy sàn.")
    end
end

local function TeleportTo(x,y,z)
    local _,root = Character()

    if root then
        root.CFrame = CFrame.new(x,y,z)
    end
end

--========================================================
-- FIX LAG
--========================================================

local HiddenObjects = {}
local DisabledEffects = {}

local VegetationNames = {
    "tree","trees","plant","plants","grass",
    "leaf","leaves","bush","bushes",
    "flower","flowers","foliage","branch","branches"
}

local function IsVegetation(obj)
    local n = string.lower(obj.Name)

    for _,w in ipairs(VegetationNames) do
        if string.find(n,w,1,true) then
            return true
        end
    end

    return false
end

local function HideVegetation()
    local count = 0

    for _,obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("BasePart")
        and IsVegetation(obj)
        and not (
            LocalPlayer.Character
            and obj:IsDescendantOf(LocalPlayer.Character)
        )
        and HiddenObjects[obj] == nil then

            HiddenObjects[obj] = obj.LocalTransparencyModifier
            obj.LocalTransparencyModifier = 1
            count = count+1
        end
    end

    Notify("Fix Lag","Đã ẩn: "..count)
end

local function DisableEffects()
    local count = 0

    for _,obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("ParticleEmitter")
        or obj:IsA("Trail")
        or obj:IsA("Beam")
        or obj:IsA("Smoke")
        or obj:IsA("Fire")
        or obj:IsA("Sparkles") then

            if DisabledEffects[obj] == nil then
                DisabledEffects[obj] = obj.Enabled
                obj.Enabled = false
                count = count+1
            end
        end
    end

    Notify("Fix Lag","Đã tắt hiệu ứng: "..count)
end

local function RestoreLag()
    for obj,v in pairs(HiddenObjects) do
        if obj and obj.Parent then
            obj.LocalTransparencyModifier = v
        end
    end

    for obj,v in pairs(DisabledEffects) do
        if obj and obj.Parent then
            obj.Enabled = v
        end
    end

    table.clear(HiddenObjects)
    table.clear(DisabledEffects)

    Notify("Fix Lag","Đã khôi phục.")
end

