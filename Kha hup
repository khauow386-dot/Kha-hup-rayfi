local function BuildBigHouse()
    local _, root, _, remote = getBuildData()
    if not remote then return end
    local Road = workspace:FindFirstChild("Road")
    if not Road then notify("Big House", "Không tìm thấy Road.") return end
    local part = Road:GetChildren()[33]
    if not part or not part:IsA("BasePart") then return end
    local SIZE = 60
    local HEIGHT = 10
    local MAX_PLANK = 11
    local BUILD_DELAY = .015
    local forward = root.CFrame.LookVector
    local right = root.CFrame.RightVector
    local origin = root.Position + Vector3.new(0, -3, 0)

    local function fireSegment(p1, p2)
        local distance = (p2-p1).Magnitude
        if distance <= 0.05 then return end
        local direction = (p2-p1).Unit
        local current = p1
        local remaining = distance
        while remaining > 0.05 do
            local length = math.min(MAX_PLANK, remaining)
            local nextPoint = current + direction*length
            remote:FireServer(current, nextPoint, part, part, Vector3.new(0,1,0))
            task.wait(BUILD_DELAY)
            current = nextPoint
            remaining = remaining - length
        end
    end

    local c1 = origin + right*-30
    local c2 = origin + right*30
    local c3 = origin + right*30 + forward*60
    local c4 = origin + right*-30 + forward*60

    local function buildWall(p1, p2, wallHeight, hasDoor)
        local wallDirection = (p2-p1).Unit
        local wallLength = (p2-p1).Magnitude
        local middle = p1 + wallDirection*(wallLength/2)
        local doorWidth = 5
        local halfDoor = doorWidth/2
        local doorLeft = middle - wallDirection*halfDoor
        local doorRight = middle + wallDirection*halfDoor

        for y = .5, wallHeight, .5 do
            if hasDoor and y <= 8 then
                fireSegment(p1 + Vector3.new(0,y,0), doorLeft + Vector3.new(0,y,0))
                fireSegment(doorRight + Vector3.new(0,y,0), p2 + Vector3.new(0,y,0))
            else
                fireSegment(p1 + Vector3.new(0,y,0), p2 + Vector3.new(0,y,0))
            end
        end
    end

    buildWall(c1, c2, HEIGHT, true)
    buildWall(c2, c3, HEIGHT, false)
    buildWall(c3, c4, HEIGHT, false)
    buildWall(c4, c1, HEIGHT, false)

    local function buildSurface(y)
        for z = 0, SIZE-0.01, 2 do
            local start = origin + forward*z + right*-30 + Vector3.new(0,y,0)
            local finish = origin + forward*z + right*30 + Vector3.new(0,y,0)
            fireSegment(start, finish)
        end
    end

    buildSurface(.25)
    buildSurface(HEIGHT+.5)
    notify("Big House", "Hoàn thành Big House 60x60.")
end

local function BuildBigFloor()
    local _, root, _, remote = getBuildData()
    if not remote then return end
    local Road = workspace:FindFirstChild("Road")
    if not Road then return end
    local part = Road:GetChildren()[33]
    if not part or not part:IsA("BasePart") then return end
    local SIZE = 100
    local MAX_PLANK = 11
    local ROW_STEP = 2
    local BUILD_DELAY = .015
    local forward = root.CFrame.LookVector
    local right = root.CFrame.RightVector
    local origin = root.Position + Vector3.new(0, -3, 0)

    local function fireSegment(p1, p2)
        local distance = (p2-p1).Magnitude
        if distance <= 0.05 then return end
        local direction = (p2-p1).Unit
        local current = p1
        local remaining = distance
        while remaining > .05 do
            local length = math.min(MAX_PLANK, remaining)
            local nextPoint = current + direction*length
            remote:FireServer(current, nextPoint, part, part, Vector3.new(0,1,0))
            task.wait(BUILD_DELAY)
            current = nextPoint
            remaining = remaining - length
        end
    end

    local half = SIZE/2
    for z = 0, SIZE-0.01, ROW_STEP do
        local p1 = origin + forward*z + right*(-half) + Vector3.new(0,.25,0)
        local p2 = origin + forward*z + right*half + Vector3.new(0,.25,0)
        fireSegment(p1, p2)
    end
    notify("Big Floor", "Hoàn thành sàn lớn 100x100.")
end

