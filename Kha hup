--==================================================

local function enableFixLag()

    local treeCount =
        hideVegetation()

    local effectCount =
        disableEffects()

    pcall(function()

        settings().Rendering.QualityLevel =
            Enum.QualityLevel.Level01

    end)

    notify(
        "Fix Lag",
        "Đã tối ưu "
        .. treeCount
        .. " cây/cỏ và "
        .. effectCount
        .. " hiệu ứng."
    )

end

local function disableFixLag()

    restoreVegetation()
    restoreEffects()

    notify(
        "Fix Lag",
        "Đã khôi phục."
    )

end

