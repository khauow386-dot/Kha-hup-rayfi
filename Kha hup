local function AddButton(parent, text, callback)
    local button = Instance.new("TextButton")
    button.Parent = parent
    button.Size = UDim2.new(1, -4, 0, 42)
    button.BackgroundColor3 = PANEL2
    button.BackgroundTransparency = 0.18
    button.BorderSizePixel = 0
    button.Text = text
    button.TextColor3 = WHITE
    button.TextSize = 11
    button.Font = Enum.Font.GothamBold
    button.AutoButtonColor = false
    button.ZIndex = 15

    corner(button, 10)
    stroke(button, Color3.fromRGB(55, 55, 65), 1)

    button.MouseButton1Click:Connect(function()
        pcall(callback)
    end)
    return button
end

local function AddToggle(parent, text, default, callback)
    local enabled = default
    local row = Instance.new("Frame")
    row.Parent = parent
    row.Size = UDim2.new(1, -4, 0, 42)
    row.BackgroundColor3 = PANEL2
    row.BackgroundTransparency = 0.18
    row.BorderSizePixel = 0
    row.ZIndex = 15

    corner(row, 10)
    stroke(row, Color3.fromRGB(55, 55, 65), 1)

    local label = Instance.new("TextLabel")
    label.Parent = row
    label.Size = UDim2.new(1, -55, 1, 0)
    label.Position = UDim2.new(0, 12, 0, 0)
    label.BackgroundTransparency = 1
    label.Font = Enum.Font.GothamSemibold
    label.TextSize = 11
    label.TextColor3 = WHITE
    label.TextXAlignment = Enum.TextXAlignment.Left
    label.ZIndex = 16

    local toggleBtn = Instance.new("TextButton")
    toggleBtn.Parent = row
    toggleBtn.Size = UDim2.new(0, 36, 0, 20)
    toggleBtn.Position = UDim2.new(1, -44, 0.5, -10)
    toggleBtn.BackgroundColor3 = enabled and CONFIG.BorderColor or DARK_BUTTON
    toggleBtn.Text = ""
    toggleBtn.BorderSizePixel = 0
    toggleBtn.ZIndex = 16

    corner(toggleBtn, 10)

    local function update()
        label.Text = text .. "  [" .. (enabled and "ON" or "OFF") .. "]"
        toggleBtn.BackgroundColor3 = enabled and CONFIG.BorderColor or DARK_BUTTON
        pcall(function()
            callback(enabled)
        end)
    end

    toggleBtn.MouseButton1Click:Connect(function()
        enabled = not enabled
        update()
    end)

    update()
    return row
end

local function AddInput(parent, text, default, callback)
    local holder = Instance.new("Frame")
    holder.Parent = parent
    holder.Size = UDim2.new(1, -4, 0, 45)
    holder.BackgroundColor3 = PANEL2
    holder.BackgroundTransparency = 0.18
    holder.BorderSizePixel = 0
    holder.ZIndex = 15

    corner(holder, 10)
    stroke(holder, Color3.fromRGB(55, 55, 65), 1)

    local label = Instance.new("TextLabel")
    label.Parent = holder
    label.Size = UDim2.new(0.35, 0, 1, 0)
    label.Position = UDim2.new(0, 10, 0, 0)
    label.BackgroundTransparency = 1
    label.Text = text
    label.TextColor3 = WHITE
    label.TextSize = 11
    label.Font = Enum.Font.GothamBold
    label.TextXAlignment = Enum.TextXAlignment.Left
    label.ZIndex = 16

    local box = Instance.new("TextBox")
    box.Parent = holder
    box.Position = UDim2.new(0.4, 0, 0.15, 0)
    box.Size = UDim2.new(0.57, 0, 0.7, 0)
    box.BackgroundColor3 = DARK
    box.BorderSizePixel = 0
    box.Text = tostring(default)
    box.TextColor3 = WHITE
    box.TextSize = 11
    box.Font = Enum.Font.Gotham
    box.ClearTextOnFocus = false
    box.ZIndex = 16

    corner(box, 7)

    box.FocusLost:Connect(function()
        local value = tonumber(box.Text)
        if value then
            callback(value)
        end
    end)
    return box
end

