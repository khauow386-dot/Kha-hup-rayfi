local function teleportToRandomAsset(
    searchName
)

    local _, root =
        getCharacter()

    if not root then

        notify(
            "Item",
            "Character not ready."
        )

        return

    end

    local matches = {}

    local search =
        string.lower(
            searchName
        )

    for _, object in ipairs(
        workspace:GetDescendants()
    ) do

        if object:IsA("BasePart") then

            local objectName =
                string.lower(
                    object.Name
                )

            if objectName:find(
                search,
                1,
                true
            ) then

                table.insert(
                    matches,
                    object
                )

            end

        end

    end

    if #matches == 0 then

        notify(
            "Item Not Found",
            "Could not find: "
            .. searchName
        )

        return

    end

    local choice =
        matches[
            math.random(
                1,
                #matches
            )
        ]

    root.CFrame =
        choice.CFrame
        + Vector3.new(
            0,
            3,
            0
        )

    notify(
        "Item Found",
        "Teleported to: "
        .. choice.Name
    )

end

