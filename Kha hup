local function BuildBigFloor()

    local character,root,hammer,remote = getBuildData()

    if not remote then
        return
    end

    local Road = workspace:FindFirstChild("Road")

    if not Road then
        notify("Big Floor","Không tìm thấy Road.")
        return
    end

    local part = Road:GetChildren()[33]

    if not part or not part:IsA("BasePart") then
        return
    end

    local SIZE = 100
    local MAX_PLANK = 11
    local ROW_STEP = 2
    local BUILD_DELAY = .015

    local forward = root.CFrame.LookVector
    local right = root.CFrame.RightVector

    local origin =
        root.Position +
        Vector3.new(0,-3,0)

    local function fireSegment(p1,p2)

        local distance =
            (p2-p1).Magnitude

        if distance <= 0.05 then
            return
        end

        local direction =
            (p2-p1).Unit

        local current = p1
        local remaining = distance

        while remaining > .05 do

            local length =
                math.min(
                    MAX_PLANK,
                    remaining
                )

            local nextPoint =
                current +
                direction*length

            remote:FireServer(
                current,
                nextPoint,
                part,
                part,
                Vector3.new(0,1,0)
            )

            task.wait(BUILD_DELAY)

            current = nextPoint
            remaining = remaining-length

        end

    end

    local half = SIZE/2

    for z=0,SIZE-0.01,ROW_STEP do

        local p1 =
            origin +
            forward*z +
            right*(-half) +
            Vector3.new(0,.25,0)

        local p2 =
            origin +
            forward*z +
            right*half +
