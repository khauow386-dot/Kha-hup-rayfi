-- PAGES & TABS CREATION SYSTEM
--========================================================

local Pages = {}
local Tabs = {}

local function CreatePage(name, titleText)
    local page = Instance.new("Frame")
    page.Name = name
    page.Parent = RightScroll
    page.Size = UDim2.new(1, -4, 0, 0)
    page.AutomaticSize = Enum.AutomaticSize.Y
    page.BackgroundTransparency = 1
    page.BorderSizePixel = 0
    page.Visible = false
    page.ZIndex = 14

    local layout = Instance.new("UIListLayout")
    layout.Parent = page
    layout.Padding = UDim.new(0, 8)
    
    Pages[name] = page

    local tab = Instance.new("TextButton")
    tab.Parent = MenuScroll
    tab.Size = UDim2.new(1, -4, 0, 38)
    tab.BackgroundColor3 = DARK_BUTTON
    tab.BackgroundTransparency = 0.25
    tab.BorderSizePixel = 0
    tab.Text = titleText
    tab.TextColor3 = WHITE
    tab.TextSize = 10
    tab.Font = Enum.Font.GothamSemibold
    tab.AutoButtonColor = false
    tab.ZIndex = 14

    corner(tab, 9)
    stroke(tab, CONFIG.BorderColor, CONFIG.BorderThickness, CONFIG.BorderTransparency)

    Tabs[name] = tab
    return page
end

local function showPage(name)
    for pName, page in pairs(Pages) do
        page.Visible = (pName == name)
    end
    for tName, tab in pairs(Tabs) do
        if tName == name then
            tab.BackgroundColor3 = CONFIG.BorderColor
            tab.BackgroundTransparency = 0.05
        else
            tab.BackgroundColor3 = DARK_BUTTON
            tab.BackgroundTransparency = 0.25
        end
    end
    RightScroll.CanvasPosition = Vector2.new(0, 0)
end

