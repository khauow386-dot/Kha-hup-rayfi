local function findHighestFloor()

    local highestPart = nil
    local highestY = -math.huge

    for _,obj in ipairs(workspace:GetDescendants()) do

        if obj:IsA("BasePart")
        and obj.CanCollide
        and obj.Transparency < 1
        and obj.Size.X >= 3
        and obj.Size.Z >= 3 then

            local topY =
                obj.Position.Y +
                obj.Size.Y / 2

            if topY > highestY then

                highestY = topY
                highestPart = obj

            end

        end

    end

    return highestPart,highestY
end

