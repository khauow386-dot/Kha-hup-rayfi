    local origin =
        root.Position
        + Vector3.new(0, -3, 0)

    local half = SIZE / 2

    local function fire(p1, p2)

        local distance =
            (p2 - p1).Magnitude

        if distance <= 0.01 then
            return
        end

        local direction =
            (p2 - p1).Unit

        local current = p1
        local remaining = distance

        while remaining > 0.01 do

            local length =
                math.min(
                    MAX_PLANK,
                    remaining
                )

            local nextPoint =
                current
                + direction * length

            remote:FireServer(
                current,
                nextPoint,
                part,
                part,
                Vector3.new(0, 1, 0)
            )

            current = nextPoint
            remaining -= length

            task.wait(BUILD_DELAY)

        end

    end

    local z = 0

    while z < SIZE do

        local currentX = -half
        local remainingWidth = SIZE

        while remainingWidth > 0.01 do

            local plankLength =
                math.min(
                    MAX_PLANK,
                    remainingWidth
                )

            local p1 =
                origin
                + right * currentX
                + forward * z
                + Vector3.new(
                    0,
                    0.25,
                    0
                )

            local p2 =
                p1
                + right * plankLength

            fire(p1, p2)

            currentX += plankLength
            remainingWidth -= plankLength

        end

        z += ROW_STEP

    end

    notify(
        "Big Floor",
        "100 x 100 completed."
    )

end

