--==================================================
-- BIG HOUSE
--==================================================

local function BuildBigHouse()

    local character,
        root,
        hammer,
        remote =
        getBuildData()

    if not remote then
        return
    end

    local road =
        workspace:FindFirstChild(
            "Road"
        )

    if not road then

        notify(
            "Build Error",
            "Road not found."
        )

        return

    end

    local part =
        road:GetChildren()[33]

    if not part then

        notify(
            "Build Error",
            "Road part #33 not found."
        )

        return

    end

    local SIZE = 60
    local HEIGHT = 16
    local MAX_PLANK = 11
    local BUILD_DELAY = 0.015

    local forward =
        root.CFrame.LookVector

    local right =
        root.CFrame.RightVector

    local origin =
        root.Position +
        Vector3.new(
            0,
            -3,
            0
        )

    local function fire(
        p1,
        p2
    )

        local distance =
            (p2 - p1).Magnitude

        if distance <= 0.01 then
            return
        end

        local direction =
            (p2 - p1).Unit

        local current =
            p1

        local remaining =
            distance

        while remaining > 0.01 do

            local length =
                math.min(
                    MAX_PLANK,
                    remaining
                )

            local nextPoint =
                current
                + direction * length

            remote:FireServer(
                current,
                nextPoint,
                part,
                part,
                Vector3.new(
                    0,
                    1,
                    0
                )
            )

            current =
                nextPoint

            remaining -=
                length

            task.wait(
                BUILD_DELAY
            )

        end

    end

    local function buildWall(
        p1,
        p2,
        wallHeight,
        hasDoor
    )

        local direction =
            (p2 - p1).Unit

        local doorWidth = 5

        for y = 0.5,
            wallHeight,
            0.5
        do

            if hasDoor
                and y <= 8
            then

                local center =
                    (p1 + p2) / 2

                local left =
                    center
                    - direction
                    * (doorWidth / 2)

                local rightDoor =
                    center
                    + direction
                    * (doorWidth / 2)

                fire(
                    p1
                    + Vector3.new(
                        0,
                        y,
                        0
                    ),

                    left
                    + Vector3.new(
                        0,
                        y,
                        0
                    )
                )

                fire(
                    rightDoor
                    + Vector3.new(
                        0,
                        y,
                        0
                    ),

                    p2
                    + Vector3.new(
                        0,
                        y,
                        0
                    )
                )

            else

                fire(
                    p1
                    + Vector3.new(
                        0,
                        y,
                        0
                    ),

                    p2
                    + Vector3.new(
                        0,
                        y,
                        0
                    )
                )

            end

        end

    end

    local half =
        SIZE / 2

    local corner1 =
        origin
        + right * -half

    local corner2 =
        origin
        + right * half

    local corner3 =
        origin
        + right * half
        + forward * SIZE

    local corner4 =
        origin
        + right * -half
        + forward * SIZE

    buildWall(
        corner1,
        corner2,
        HEIGHT,
        true
    )

    buildWall(
        corner2,
        corner3,
        HEIGHT,
        false
    )

    buildWall(
        corner3,
        corner4,
        HEIGHT,
        false
    )

    buildWall(
        corner4,
        corner1,
        HEIGHT,
        false
    )

    local function buildSurface(y)

        local ROW_STEP = 2
        local z = 0

        while z < SIZE do

            local currentX =
                -half

            local remainingWidth =
                SIZE

            while remainingWidth > 0.01 do

                local plankLength =
                    math.min(
                        MAX_PLANK,
                        remainingWidth
                    )

                local p1 =
                    origin
                    + right * currentX
                    + forward * z
                    + Vector3.new(
                        0,
                        y,
                        0
                    )

                local p2 =
                    p1
                    + right * plankLength

                fire(
                    p1,
                    p2
                )

                currentX +=
                    plankLength

                remainingWidth -=
                    plankLength

            end

            z += ROW_STEP

        end

    end

    buildSurface(
        0.25
    )

    buildSurface(
        HEIGHT + 0.5
    )

    notify(
        "Big House",
        "Big House completed."
    )

end

