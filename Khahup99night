local function Diagnose()
	local lines = {}

	table.insert(lines, "Remote damage: " .. (DamageRemote and "OK" or "THIẾU"))

	local chop, chopName = GetEquippedTool(true)
	table.insert(lines, "Rìu/cưa: " .. (chop and tostring(chopName) or "CHƯA CẦM"))

	local any, anyName = GetEquippedTool(false)
	table.insert(lines, "Vũ khí: " .. (any and tostring(anyName) or "CHƯA CẦM"))

	table.insert(lines, "HitId: " .. (GetHitId() and "OK" or "KHÔNG LẤY ĐƯỢC"))

	local _, root = GetCharacter()
	local trees = GetTrees()
	local nearest = math.huge
	if root then
		for _, tree in ipairs(trees) do
			local trunk = tree:IsA("Model") and tree:FindFirstChild("Trunk")
			if trunk and trunk:IsA("BasePart") then
				local d = (trunk.Position - root.Position).Magnitude
				if d < nearest then nearest = d end
			end
		end
	end
	table.insert(lines, "Cây tìm thấy: " .. #trees
		.. (nearest < math.huge and (" | gần nhất " .. math.floor(nearest)) or ""))

	local chars = workspace:FindFirstChild("Characters")
	table.insert(lines, "Characters: " .. (chars and (#chars:GetChildren() .. " mục") or "THIẾU"))

	for _, l in ipairs(lines) do print("[CHẨN ĐOÁN] " .. l) end
	Notify("CHẨN ĐOÁN", table.concat(lines, "\n"))
end

local function ScanGameStructure()
	local report = {"=== QUÉT 99 NIGHTS ==="}

	-- 1. Workspace top-level
	local wsList = {}
	for _, c in ipairs(workspace:GetChildren()) do
		table.insert(wsList, c.Name .. "(" .. c.ClassName .. ")")
	end
	table.insert(report, "Workspace: " .. table.concat(wsList, ", "))

	-- 2. Remotes
	if RemoteEvents then
		local rList = {}
		for _, r in ipairs(RemoteEvents:GetChildren()) do
			table.insert(rList, r.Name)
		end
		table.insert(report, "RemoteEvents: " .. table.concat(rList, ", "))
	end

	-- 3. Vật thể di chuyển gần người chơi (để bắt tên đạn/tên lửa)
	local _, root = GetCharacter()
	if root then
		local near = {}
		for _, d in ipairs(workspace:GetDescendants()) do
			if d:IsA("BasePart") and (d.Position - root.Position).Magnitude < 60 then
				local v = math.floor(d.AssemblyLinearVelocity.Magnitude)
				if v > 5 or (not d.Anchored and not d:IsDescendantOf(Player.Character)) then
					table.insert(near, d:GetFullName() .. " [v=" .. v .. ",anc=" .. tostring(d.Anchored) .. "]")
				end
			end
		end
		table.insert(report, "Vật gần/bay: " .. (#near > 0 and table.concat(near, " | ") or "Không có"))
	end

	local fullText = table.concat(report, "\n")
	print(fullText)
	pcall(function() Library:Copy(fullText) end)
	Notify("QUÉT GAME", "Đã sao chép kết quả quét vào bộ nhớ tạm!")
end

