-- INSTANT BRING: GIỮ CƠ CHẾ CŨ
local function GetPosition(obj)
    if not obj then return nil end

    if obj:IsA("Model") then
        return obj:GetPivot().Position
    elseif obj:IsA("BasePart") then
        return obj.Position
    end

    return nil
end

local function SetItemPosition(item, position)
    if item:IsA("Model") then
        item:PivotTo(CFrame.new(position))
        return true
    elseif item:IsA("BasePart") then
        item.CFrame = CFrame.new(position)
        return true
    end

    return false
end

local function TeleportObject(item, destination)
    if not item or not item.Parent then
        return false
    end

    if not destination or not StartDrag or not StopDrag then
        return false
    end

    local position = GetPosition(destination)
    if not position then return false end

    local targetPosition = position + Vector3.new(0, 3, 0)

    local startSuccess = pcall(function()
        StartDrag:FireServer(item)
    end)

    if not startSuccess then
        return false
    end

    local moveSuccess = pcall(function()
        SetItemPosition(item, targetPosition)
    end)

    task.wait(0.05)

    local stopSuccess = pcall(function()
        StopDrag:FireServer(item)
    end)

    return startSuccess and moveSuccess and stopSuccess
end

local function BringItems(filter, destination)
    if Settings.BringBusy then
        Notify("BRING", "Đang xử lý vật phẩm!")
        return 0
    end

    local items = workspace:FindFirstChild("Items")

    if not items then
        Notify("BRING", "Không tìm thấy Workspace.Items!")
        return 0
    end

    if not destination then
        Notify("BRING", "Không tìm thấy vị trí đích!")
        return 0
    end

    Settings.BringBusy = true
    local count = 0

    for _, item in ipairs(items:GetChildren()) do
        if not Running then break end

        if not filter or filter[item.Name] then
            if TeleportObject(item, destination) then
                count += 1
            end
            task.wait(0.05)
        end
    end

    Settings.BringBusy = false
    return count
end

