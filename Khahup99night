local function IsIgnoredPart(part)
	if not part or not part.Parent then return true end
	local ch = Player.Character
	if ch and part:IsDescendantOf(ch) then return true end
	for _, folderName in ipairs({"Items", "Characters"}) do
		local f = workspace:FindFirstChild(folderName)
		if f and part:IsDescendantOf(f) then return true end
	end
	return false
end

workspace.DescendantAdded:Connect(function(obj)
	if Settings.AntiProjectile and obj:IsA("BasePart") and not obj.Anchored and not IsIgnoredPart(obj) then
		Tracked[obj] = os.clock()
	end
end)

local function ScanNearbyProjectiles(rootPos)
	local ok, parts = pcall(function()
		return workspace:GetPartBoundsInRadius(rootPos, Settings.ProjectileRange)
	end)
	if not ok or type(parts) ~= "table" then return end

	local now = os.clock()
	for _, part in ipairs(parts) do
		if part:IsA("BasePart") and not part.Anchored and not IsIgnoredPart(part) then
			if part.AssemblyLinearVelocity.Magnitude > 22 then
				Tracked[part] = now
			end
		end
	end
end

local function IsFlying(part)
	if IsIgnoredPart(part) or part.Anchored then return false end
	return part.AssemblyLinearVelocity.Magnitude > 22
end

local function AntiProjectileStep()
	local _, root = GetCharacter()
	if not root then return end

	local now = os.clock()
	ScanNearbyProjectiles(root.Position)

	for part, t in pairs(Tracked) do
		if not part.Parent or (now - t) > 6 then
			Tracked[part] = nil
		elseif (now - LastDodge) >= 0.22 and IsFlying(part) then
			local rel = root.Position - part.Position
			local dist = rel.Magnitude
			if dist > 0.01 and dist < Settings.ProjectileRange then
				local vel = part.AssemblyLinearVelocity
				local dir = vel.Unit
				local approach = rel:Dot(dir)

				if approach > -2 then
					local perp = rel - dir * math.max(approach, 0)
					if perp.Magnitude < 12 then
						local side = perp.Magnitude > 0.5 and perp.Unit
							or dir:Cross(Vector3.yAxis).Unit
						side = Vector3.new(side.X, 0, side.Z)
						if side.Magnitude < 0.1 then side = Vector3.xAxis end

						pcall(function() part.CanTouch = false end)
						local dodgePos = root.Position + side.Unit * 14
						root.CFrame = CFrame.new(dodgePos, dodgePos + root.CFrame.LookVector)
						LastDodge = now
						Tracked[part] = nil

						if not SeenNames[part.Name] and SeenCount < 50 then
							SeenNames[part.Name] = true
							SeenCount += 1
							Notify("ANTI ĐẠN", "Đã né: " .. part.Name)
						end
						return
					end
				end
			end
		end
	end
end

