-- FLY TO FIRE
--========================================================
local function CancelFly()
	FlyToken += 1
	if FlyTween then
		pcall(function() FlyTween:Cancel() end)
		FlyTween = nil
	end
end

local function StopFly()
	CancelFly()
	Notify("BAY", "Đã dừng bay!")
end

local function FlyToFire()
	local fire = GetFire()
	local _, root = GetCharacter()

	if not fire or not root then
		Notify("BAY", "Không tìm thấy nhân vật hoặc đống lửa!")
		return
	end

	local destination = GetPosition(fire)
	if not destination then
		Notify("BAY", "Không lấy được tọa độ đống lửa!")
		return
	end

	CancelFly()
	local currentToken = FlyToken

	local target = destination + Vector3.new(0, 6, 0)
	local distance = (root.Position - target).Magnitude
	local duration = math.max(distance / Settings.FlySpeed, 0.05)

	local tween = TweenService:Create(
		root,
		TweenInfo.new(duration, Enum.EasingStyle.Linear),
		{CFrame = CFrame.new(target)}
	)
	FlyTween = tween
	tween:Play()

	Notify("BAY", "Đang bay về đống lửa. Tốc độ: " .. Settings.FlySpeed)

	task.spawn(function()
		tween.Completed:Wait()
		if currentToken == FlyToken then
			FlyTween = nil
			Notify("BAY", "Đã kết thúc hành trình!")
		end
	end)
end

--========================================================
-- ANTI HIT
--========================================================
local LastEvade = 0
local LastRetreat = 0

local function AntiHitStep()
	local character, root = GetCharacter()
	local humanoid = GetHumanoid()
	if not (character and root and humanoid) or humanoid.Health <= 0 then return end

	local hpPercent = humanoid.Health / math.max(humanoid.MaxHealth, 1) * 100
	if hpPercent <= Settings.AntiHitHP and os.clock() - LastRetreat > 5 then
		local fire = GetFire()
		local firePos = fire and GetPosition(fire)
		if firePos then
			LastRetreat = os.clock()
			CancelFly()
			root.CFrame = CFrame.new(firePos + Vector3.new(0, 6, 0))
			Notify("ANTI HIT", "Máu thấp (" .. math.floor(hpPercent) .. "%), đã về đống lửa!")
			return
		end
	end

	if os.clock() - LastEvade < 0.4 then return end

	local enemies = workspace:FindFirstChild("Characters")
	if not enemies then return end

	local nearestPos, nearestDist
	for _, enemy in ipairs(enemies:GetChildren()) do
		if enemy:IsA("Model")
			and enemy ~= character
			and not ExcludedEnemies[enemy.Name] then

			local part = GetModelPart(enemy)
			local h = enemy:FindFirstChildOfClass("Humanoid")

			if part and (not h or h.Health > 0) then
				local d = (part.Position - root.Position).Magnitude
				if d < Settings.AntiHitRange and (not nearestDist or d < nearestDist) then
					nearestDist = d
					nearestPos = part.Position
				end
			end
		end
	end

	if nearestPos then
		local away = Vector3.new(
			root.Position.X - nearestPos.X, 0, root.Position.Z - nearestPos.Z
		)
		if away.Magnitude < 0.1 then
			away = Vector3.new(1, 0, 0)
		end
		local newPos = root.Position + away.Unit * (Settings.AntiHitRange + 6 - nearestDist)
		LastEvade = os.clock()
		root.CFrame = CFrame.new(newPos, newPos + root.CFrame.LookVector)
	end
end

