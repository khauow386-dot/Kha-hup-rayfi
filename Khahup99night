-- FLY TO FIRE
local function StopFly()
    FlyToken += 1

    if FlyTween then
        pcall(function()
            FlyTween:Cancel()
        end)
        FlyTween = nil
    end

    Notify("BAY", "Đã dừng bay!")
end

local function FlyToFire()
    local fire = GetFire()
    local character, root = GetCharacter()

    if not fire or not root then
        Notify("BAY", "Không tìm thấy nhân vật hoặc đống lửa!")
        return
    end

    local destination = GetPosition(fire)
    if not destination then
        Notify("BAY", "Không lấy được tọa độ đống lửa!")
        return
    end

    StopFly()

    FlyToken += 1
    local currentToken = FlyToken

    local target = destination + Vector3.new(0, 6, 0)
    local distance = (root.Position - target).Magnitude
    local duration = math.max(distance / Settings.FlySpeed, 0.05)

    FlyTween = TweenService:Create(
        root,
        TweenInfo.new(duration, Enum.EasingStyle.Linear),
        {CFrame = CFrame.new(target)}
    )

    FlyTween:Play()

    Notify("BAY", "Đang bay về đống lửa. Tốc độ: " .. Settings.FlySpeed)

    task.spawn(function()
        local tween = FlyTween
        tween.Completed:Wait()

        if currentToken == FlyToken then
            FlyTween = nil
            Notify("BAY", "Đã kết thúc hành trình!")
        end
    end)
end

