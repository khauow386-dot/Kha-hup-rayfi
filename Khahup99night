-- CHARACTER
local function GetCharacter()
    local character = Player.Character
    if not character then return nil end

    local root = character:FindFirstChild("HumanoidRootPart")
    if not root then return nil end

    return character, root
end

local function GetHumanoid()
    local character = Player.Character
    if not character then return nil end
    return character:FindFirstChildOfClass("Humanoid")
end

-- AXE
local function GetEquippedAxe()
    local character = Player.Character
    if not character then return nil end

    for _, model in ipairs(character:GetChildren()) do
        if model:IsA("Model") then
            local name = model:GetAttribute("ToolName")

            if type(name) == "string" and name:find("Axe") then
                local original = model:FindFirstChild("OriginalItem")
                if original and original.Value then
                    return original.Value
                end
            end
        end
    end

    return nil
end

local function HasChainsaw()
    local inventory = Player:FindFirstChild("Inventory")
    if not inventory then return false end

    for _, tool in ipairs(inventory:GetChildren()) do
        local name = tool:GetAttribute("ToolName")
        if type(name) == "string" and name:find("Chainsaw") then
            return true
        end
    end

    return false
end

-- HIT REGISTRATION
local EnemyHandler

local function GetHitId()
    if not EnemyHandler then
        local success, result = pcall(function()
            return require(Player.PlayerScripts.Client.EnemyHandler)
        end)

        if success then
            EnemyHandler = result
        else
            return nil
        end
    end

    local success, result = pcall(function()
        return EnemyHandler.GetHitRegId()
    end)

    if success then return result end
    return nil
end

local function DamageTarget(target, isTree)
    local character, root = GetCharacter()
    if not character or not root then return false end

    local axe = GetEquippedAxe()
    local hitId = GetHitId()

    if not axe or not hitId then return false end

    local success = pcall(function()
        if isTree then
            DamageRemote:InvokeServer(
                target, axe, hitId, root.CFrame, true
            )
        else
            DamageRemote:InvokeServer(
                target, axe, hitId, root.CFrame
            )
        end
    end)

    return success
end

-- TREE AURA
local function GetTrees()
    local success, result = pcall(function()
        return workspace:QueryDescendants("[$Resource]")
    end)

    if success and type(result) == "table" then
        return result
    end

    return CollectionService:GetTagged("Resource")
end

local function CanChopTree(tree)
    if tostring(tree):find("Big") then
        return HasChainsaw()
    end
    return true
end

local function GetClosestTree()
    local character, root = GetCharacter()
    if not root then return nil end

    local closest
    local shortest = Settings.TreeRange

    for _, tree in ipairs(GetTrees()) do
        if tree:IsA("Model") then
            local trunk = tree:FindFirstChild("Trunk")

            if trunk and trunk:IsA("BasePart")
                and CanChopTree(tree) then

                local distance = (trunk.Position - root.Position).Magnitude

                if distance < shortest then
                    closest = tree
                    shortest = distance
                end
            end
        end
    end

    return closest
end

local function StartTreeAura()
    task.spawn(function()
        while Running and Settings.TreeAura do
            if GetEquippedAxe() then
                local tree = GetClosestTree()
                if tree then
                    DamageTarget(tree, true)
                end
            end
            task.wait(0.15)
        end
    end)
end

-- KILL AURA
local ExcludedEnemies = {
    ["Lost Child"] = true,
    ["Lost Child2"] = true,
    ["Lost Child3"] = true,
    ["Lost Child4"] = true,
    ["Pelt Trader"] = true,
}

local function GetModelPart(model)
    return model.PrimaryPart
        or model:FindFirstChild("HumanoidRootPart")
        or model:FindFirstChildWhichIsA("BasePart")
end

local function StartKillAura()
    task.spawn(function()
        while Running and Settings.KillAura do
            local character, root = GetCharacter()
            local enemies = workspace:FindFirstChild("Characters")

            if root and enemies and GetEquippedAxe() then
                for _, enemy in ipairs(enemies:GetChildren()) do
                    if not Settings.KillAura then break end

                    if enemy:IsA("Model")
                        and enemy ~= character
                        and not ExcludedEnemies[enemy.Name] then

                        local part = GetModelPart(enemy)
                        local humanoid = enemy:FindFirstChildOfClass("Humanoid")

                        if part and (not humanoid or humanoid.Health > 0) then
                            local distance = (part.Position - root.Position).Magnitude

                            if distance <= Settings.KillRange then
                                DamageTarget(enemy, false)
                                task.wait(0.12)
                            end
                        end
                    end
                end
            end

            task.wait(0.15)
        end
    end)
end

