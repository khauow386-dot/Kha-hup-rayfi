--========================================================
-- LOOP MANAGER
--========================================================
local LoopTokens = {}

local function StopLoop(name)
	LoopTokens[name] = (LoopTokens[name] or 0) + 1
end

local function StartLoop(name, interval, fn)
	StopLoop(name)
	local my = LoopTokens[name]
	task.spawn(function()
		while Running and Settings[name] and LoopTokens[name] == my do
			local ok, err = pcall(fn, my)
			if not ok then
				Warn("err_" .. name, name .. " lỗi: " .. tostring(err))
			end
			task.wait(interval)
		end
	end)
end

local function ToggleLoop(name, interval, fn)
	return function(value)
		Settings[name] = value
		if value then
			StartLoop(name, interval, fn)
		else
			StopLoop(name)
		end
	end
end

--========================================================
-- CHARACTER
--========================================================
local function GetCharacter()
	local character = Player.Character
	if not character then return nil end
	local root = character:FindFirstChild("HumanoidRootPart")
	if not root then return nil end
	return character, root
end

local function GetHumanoid()
	local character = Player.Character
	if not character then return nil end
	return character:FindFirstChildOfClass("Humanoid")
end

local function GetModelPart(model)
	return model.PrimaryPart
		or model:FindFirstChild("HumanoidRootPart")
		or model:FindFirstChildWhichIsA("BasePart")
end

local function GetPosition(obj)
	if not obj then return nil end
	if obj:IsA("Model") then
		return obj:GetPivot().Position
	elseif obj:IsA("BasePart") then
		return obj.Position
	end
	return nil
end

--========================================================
-- TOOL DETECTION (rìu / cưa / vũ khí đang cầm)
--========================================================
local function HasWord(name, words)
	local lower = name:lower()
	for _, w in ipairs(words) do
		if lower:find(w, 1, true) then return true end
	end
	return false
end

local ChopWords = {"axe", "chainsaw"}

local function GetEquippedTool(onlyChop)
	local character = Player.Character
	if not character then return nil end

	for _, child in ipairs(character:GetChildren()) do
		if child:IsA("Model") or child:IsA("Tool") then
			local toolName = child:GetAttribute("ToolName")
			if type(toolName) ~= "string" then
				toolName = child.Name
			end

			if not onlyChop or HasWord(toolName, ChopWords) then
				local original = child:FindFirstChild("OriginalItem")
				if original and original.Value then
					return original.Value, toolName
				end
				if child:IsA("Tool") then
					return child, toolName
				end
			end
		end
	end
	return nil
end

local function HasChainsaw()
	local inventory = Player:FindFirstChild("Inventory")
	if not inventory then return false end

	for _, tool in ipairs(inventory:GetChildren()) do
		local name = tool:GetAttribute("ToolName")
		if type(name) == "string" and name:lower():find("chainsaw", 1, true) then
			return true
		end
	end
	return false
end

