local EnemyHandler

local function FindEnemyHandler()
	local ok, result = pcall(function()
		return require(Player.PlayerScripts.Client.EnemyHandler)
	end)
	if ok then return result end

	local scripts = Player:FindFirstChild("PlayerScripts")
	if scripts then
		for _, obj in ipairs(scripts:GetDescendants()) do
			if obj:IsA("ModuleScript") and obj.Name == "EnemyHandler" then
				local ok2, result2 = pcall(require, obj)
				if ok2 then return result2 end
			end
		end
	end
	return nil
end

local function GetHitId()
	if not EnemyHandler then
		EnemyHandler = FindEnemyHandler()
		if not EnemyHandler then return nil end
	end

	local ok, result = pcall(function()
		return EnemyHandler.GetHitRegId()
	end)
	if ok then return result end
	return nil
end

local function DamageTarget(target, isTree)
	if not DamageRemote then return false, "thiếu remote" end

	local _, root = GetCharacter()
	if not root then return false, "không có nhân vật" end

	local tool = GetEquippedTool(isTree)
	if not tool then
		return false, isTree and "chưa cầm rìu/cưa" or "chưa cầm vũ khí"
	end

	local hitId = GetHitId()
	if not hitId then return false, "không lấy được HitId" end

	local ok, err = pcall(function()
		if isTree then
			DamageRemote:InvokeServer(target, tool, hitId, root.CFrame, true)
		else
			DamageRemote:InvokeServer(target, tool, hitId, root.CFrame)
		end
	end)

	if not ok then return false, tostring(err) end
	return true
end

