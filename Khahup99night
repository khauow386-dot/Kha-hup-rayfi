-- TREE AURA
--========================================================
local TreeCache = {}
local TreeScanTime = 0

local function GetTrees()
	local ok, result = pcall(function()
		return workspace:QueryDescendants("[$Resource]")
	end)
	if ok and type(result) == "table" and #result > 0 then
		return result
	end

	local tagged = CollectionService:GetTagged("Resource")
	if #tagged > 0 then return tagged end

	if os.clock() - TreeScanTime > 5 then
		TreeScanTime = os.clock()
		TreeCache = {}
		for _, obj in ipairs(workspace:GetDescendants()) do
			if obj:IsA("Model") and obj:FindFirstChild("Trunk") then
				table.insert(TreeCache, obj)
			end
		end
	end
	return TreeCache
end

local function CanChopTree(tree)
	if tostring(tree):lower():find("big", 1, true) then
		return HasChainsaw()
	end
	return true
end

local function GetClosestTree()
	local _, root = GetCharacter()
	if not root then return nil end

	local closest
	local shortest = Settings.TreeRange

	for _, tree in ipairs(GetTrees()) do
		if tree:IsA("Model") then
			local trunk = tree:FindFirstChild("Trunk")
			if trunk and trunk:IsA("BasePart") and CanChopTree(tree) then
				local distance = (trunk.Position - root.Position).Magnitude
				if distance < shortest then
					closest = tree
					shortest = distance
				end
			end
		end
	end
	return closest
end

local function TreeAuraStep()
	if not GetEquippedTool(true) then
		Warn("noaxe", "Tree Aura: hãy cầm RÌU hoặc CƯA trên tay!")
		return
	end

	local tree = GetClosestTree()
	if not tree then
		Warn("notree", "Tree Aura: không có cây trong bán kính.")
		return
	end

	local ok, err = DamageTarget(tree, true)
	if not ok then
		Warn("treefail", "Tree Aura lỗi: " .. tostring(err))
	end
end

