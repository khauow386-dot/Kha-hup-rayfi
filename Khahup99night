--========================================================
-- FIX LAG
--========================================================
local OriginalEffects = {}

local function SetFixLag(value)
	Settings.FixLag = value

	if value then
		for _, obj in ipairs(workspace:GetDescendants()) do
			if obj:IsA("ParticleEmitter") or obj:IsA("Trail")
				or obj:IsA("Beam") or obj:IsA("Fire")
				or obj:IsA("Smoke") or obj:IsA("Sparkles") then

				if OriginalEffects[obj] == nil then
					OriginalEffects[obj] = {Type = "Enabled", Value = obj.Enabled}
				end
				obj.Enabled = false

			elseif obj:IsA("BasePart") then
				if OriginalEffects[obj] == nil then
					OriginalEffects[obj] = {Type = "Shadow", Value = obj.CastShadow}
				end
				obj.CastShadow = false
			end
		end
		Notify("FIX LAG", "Đã giảm hiệu ứng đồ họa!")
	else
		for obj, data in pairs(OriginalEffects) do
			if obj and obj.Parent then
				pcall(function()
					if data.Type == "Shadow" then
						obj.CastShadow = data.Value
					else
						obj.Enabled = data.Value
					end
				end)
			end
		end
		table.clear(OriginalEffects)
		Notify("FIX LAG", "Đã khôi phục hiệu ứng!")
	end
end

--========================================================
-- WORLD TRANSPARENCY (debounce)
--========================================================
local OriginalTransparency = {}

local function SaveTransparency(obj)
	if OriginalTransparency[obj] then return end

	pcall(function()
		if obj:IsA("BasePart") then
			OriginalTransparency[obj] = {
				Type = "Part",
				Transparency = obj.Transparency,
				LocalTransparencyModifier = obj.LocalTransparencyModifier,
			}
		elseif obj:IsA("Decal") or obj:IsA("Texture") then
			OriginalTransparency[obj] = {
				Type = "Texture",
				Transparency = obj.Transparency,
			}
		end
	end)
end

local function ApplyTransparency(amount)
	Settings.WorldTransparency = amount
	local alpha = math.clamp(amount / 100, 0, 1)

	for _, obj in ipairs(workspace:GetDescendants()) do
		if obj:IsA("BasePart") then
			SaveTransparency(obj)
			local data = OriginalTransparency[obj]
			if data then
				obj.LocalTransparencyModifier =
					data.LocalTransparencyModifier
					+ (1 - data.LocalTransparencyModifier) * alpha
			end
		elseif obj:IsA("Decal") or obj:IsA("Texture") then
			SaveTransparency(obj)
			local data = OriginalTransparency[obj]
			if data then
				obj.Transparency =
					data.Transparency + (1 - data.Transparency) * alpha
			end
		end
	end
end

local TransToken = 0
local function ApplyTransparencyDebounced(value)
	TransToken += 1
	local my = TransToken
	task.delay(0.3, function()
		if my == TransToken then
			ApplyTransparency(value)
		end
	end)
end

local function RestoreTransparency()
	TransToken += 1
	for obj, data in pairs(OriginalTransparency) do
		if obj and obj.Parent then
			pcall(function()
				if data.Type == "Part" then
					obj.Transparency = data.Transparency
					obj.LocalTransparencyModifier = data.LocalTransparencyModifier
				else
					obj.Transparency = data.Transparency
				end
			end)
		end
	end
	table.clear(OriginalTransparency)
	Settings.WorldTransparency = 0
	Notify("TRANSPARENCY", "Đã khôi phục độ trong suốt!")
end

