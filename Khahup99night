--========================================================
local function SetItemPosition(item, position)
	if item:IsA("Model") then
		item:PivotTo(CFrame.new(position))
		return true
	elseif item:IsA("BasePart") then
		item.CFrame = CFrame.new(position)
		return true
	end
	return false
end

local function TeleportObject(item, destination)
	if not item or not item.Parent then return false end
	if not destination or not StartDrag or not StopDrag then return false end

	local position = GetPosition(destination)
	if not position then return false end

	local target = position + Vector3.new(0, 3, 0)

	local startOk = pcall(function() StartDrag:FireServer(item) end)
	if not startOk then return false end

	local moveOk = pcall(function() SetItemPosition(item, target) end)
	task.wait(0.05)
	local stopOk = pcall(function() StopDrag:FireServer(item) end)

	return startOk and moveOk and stopOk
end

local function BringItems(filterFn, destination)
	if Settings.BringBusy then return 0 end

	local items = workspace:FindFirstChild("Items")
	if not items or not destination then return 0 end

	Settings.BringBusy = true
	local count = 0

	local ok = pcall(function()
		for _, item in ipairs(items:GetChildren()) do
			if not Running then break end
			if not filterFn or filterFn(item) then
				if TeleportObject(item, destination) then
					count += 1
				end
				task.wait(0.04)
			end
		end
	end)

	Settings.BringBusy = false
	return ok and count or 0
end

local function ResolveDestination(destKind, allowMe)
	if allowMe and Settings.BringToMe then
		local _, root = GetCharacter()
		return root, "bạn"
	end
	if destKind == "scrap" then
		return GetScrapper(), "Scrapper"
	end
	return GetFire(), "MainFire"
end

local function BringSync(catSet, destKind, allowMe)
	local destination, destName = ResolveDestination(destKind, allowMe)
	if not destination then return 0, destName end

	local count = BringItems(function(item)
		return not catSet or catSet[Classify(item.Name)]
	end, destination)

	return count, destName
end

local function BringButton(label, catSet, destKind, allowMe)
	return function()
		task.spawn(function()
			if Settings.BringBusy then
				Notify("BRING", "Đang xử lý vật phẩm, đợi chút!")
				return
			end

			local destination, destName = ResolveDestination(destKind, allowMe ~= false)
			if not destination then
				Notify("BRING", "Không tìm thấy " .. tostring(destName) .. "!")
				return
			end

			local count = BringItems(function(item)
				return not catSet or catSet[Classify(item.Name)]
			end, destination)

			Notify("BRING " .. label, "Đã gửi " .. count .. " vật phẩm về " .. destName .. ".")
		end)
	end
end

local function AutoFuelStep()
	if Settings.BringBusy then return end
	BringSync({Fuel = true}, "fire", false)
end

local function AutoScrapStep()
	if Settings.BringBusy then return end
	BringSync({Scrap = true}, "scrap", false)
end

