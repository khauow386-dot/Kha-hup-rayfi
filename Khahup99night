-- KILL AURA
--========================================================
local ExcludedEnemies = {
	["Lost Child"] = true,
	["Lost Child2"] = true,
	["Lost Child3"] = true,
	["Lost Child4"] = true,
	["Pelt Trader"] = true,
}

local function KillAuraStep(token)
	local character, root = GetCharacter()
	local enemies = workspace:FindFirstChild("Characters")

	if not enemies then
		Warn("nochars", "Kill Aura: không thấy Workspace.Characters.")
		return
	end
	if not root then return end
	if not GetEquippedTool(false) then
		Warn("noweapon", "Kill Aura: hãy cầm vũ khí/rìu trên tay!")
		return
	end

	for _, enemy in ipairs(enemies:GetChildren()) do
		if not Settings.KillAura or LoopTokens.KillAura ~= token then break end

		if enemy:IsA("Model")
			and enemy ~= character
			and not ExcludedEnemies[enemy.Name] then

			local part = GetModelPart(enemy)
			local humanoid = enemy:FindFirstChildOfClass("Humanoid")

			if part and (not humanoid or humanoid.Health > 0) then
				local distance = (part.Position - root.Position).Magnitude
				if distance <= Settings.KillRange then
					local ok, err = DamageTarget(enemy, false)
					if not ok then
						Warn("killfail", "Kill Aura lỗi: " .. tostring(err))
					end
					task.wait(0.12)
				end
			end
		end
	end
end

