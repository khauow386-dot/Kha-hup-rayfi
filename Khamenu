local function detectFileSystem()
    return type(readfile) == "function"
        and type(writefile) == "function"
        and type(isfile) == "function"
end

saveAvailable = detectFileSystem()

local function getData()
    local point

    if savedCFrame then
        local rx,ry,rz = savedCFrame:ToOrientation()
        local p = savedCFrame.Position

        point = {
            x=p.X, y=p.Y, z=p.Z,
            rx=rx, ry=ry, rz=rz
        }
    end

    return {
        version = 5,

        infiniteJump = infiniteJump,
        noclip = noclip,

        sound = soundEnabled,
        animation = animationEnabled,
        autoSave = autoSave,

        language = language,
        uiScale = uiScale,
        transparency = transparency,

        borderColor = {
            borderColor.R,
            borderColor.G,
            borderColor.B
        },

        menuVisible = menuVisible,
        settingsVisible = settingsVisible,

        savedPoint = point,

        menuPosition = {
            menuPosition.X.Scale,
            menuPosition.X.Offset,
            menuPosition.Y.Scale,
            menuPosition.Y.Offset
        },

        togglePosition = {
            togglePosition.X.Scale,
            togglePosition.X.Offset,
            togglePosition.Y.Scale,
            togglePosition.Y.Offset
        }
    }
end

local function saveConfig(force)
    if not saveAvailable then return false end
    if not force and not autoSave then return false end

    local ok,err = pcall(function()
        writefile(CFG.File, HttpService:JSONEncode(getData()))
    end)

    if not ok then
        warn("[MINH KHA V5] Save error:",err)
        return false
    end

    return true
end

local function readUDim(value,fallback)
    if type(value) ~= "table" then
        return fallback
    end

    return UDim2.new(
        tonumber(value[1]) or fallback.X.Scale,
        tonumber(value[2]) or fallback.X.Offset,
        tonumber(value[3]) or fallback.Y.Scale,
        tonumber(value[4]) or fallback.Y.Offset
    )
end

local function loadConfig()
    if not saveAvailable then return false end

    local ok,data = pcall(function()
        if not isfile(CFG.File) then return nil end
        return HttpService:JSONDecode(readfile(CFG.File))
    end)

    if not ok or type(data) ~= "table" then
        return false
    end

    infiniteJump = data.infiniteJump == true
    noclip = data.noclip == true

    soundEnabled = data.sound ~= false
    animationEnabled = data.animation ~= false
    autoSave = data.autoSave ~= false

    if data.language == "VI" or data.language == "EN" then
        language = data.language
    end

    uiScale = math.clamp(tonumber(data.uiScale) or 0.90,0.70,1.20)
    transparency = math.clamp(tonumber(data.transparency) or 0.08,0,0.80)

    if type(data.borderColor) == "table" then
        local c = data.borderColor

        if type(c[1]) == "number"
        and type(c[2]) == "number"
        and type(c[3]) == "number" then

            borderColor = Color3.new(
                math.clamp(c[1],0,1),
                math.clamp(c[2],0,1),
                math.clamp(c[3],0,1)
            )
        end
    end

    if type(data.menuVisible) == "boolean" then
        menuVisible = data.menuVisible
    end

    if type(data.settingsVisible) == "boolean" then
        settingsVisible = data.settingsVisible
    end

    if type(data.savedPoint) == "table" then
        local p = data.savedPoint

        if type(p.x) == "number"
        and type(p.y) == "number"
        and type(p.z) == "number" then

            savedCFrame = CFrame.new(p.x,p.y,p.z)
                * CFrame.fromOrientation(
                    tonumber(p.rx) or 0,
                    tonumber(p.ry) or 0,
                    tonumber(p.rz) or 0
                )
        end
    end

    menuPosition = readUDim(data.menuPosition,menuPosition)
    togglePosition = readUDim(data.togglePosition,togglePosition)

    return true
end

loadConfig()

