--========================================================
-- 30. NOCLIP
--========================================================

local function rememberPart(part)
    if not part:IsA("BasePart") then return end

    if collisionData[part] == nil then
        collisionData[part] = part.CanCollide
    end
end

local function restoreCollision()
    for part,original in pairs(collisionData) do
        if part and part.Parent then
            pcall(function()
                part.CanCollide = original
            end)
        end
    end

    table.clear(collisionData)
end

local function disconnectNoclip()
    if noclipConnection then
        noclipConnection:Disconnect()
        noclipConnection = nil
    end

    if descendantConnection then
        descendantConnection:Disconnect()
        descendantConnection = nil
    end
end

local function bindNoclip(character)
    disconnectNoclip()
    restoreCollision()

    currentCharacter = character

    if not noclip or not character then return end

    for _,part in ipairs(character:GetDescendants()) do
        rememberPart(part)
    end

    descendantConnection = character.DescendantAdded:Connect(function(part)
        if not noclip or currentCharacter ~= character then return end

        if part:IsA("BasePart") then
            rememberPart(part)

            pcall(function()
                part.CanCollide = false
            end)
        end
    end)

    noclipConnection = RunService.Stepped:Connect(function()
        if destroyed or not noclip then return end
        if currentCharacter ~= character then return end

        for part in pairs(collisionData) do
            if part and part.Parent then
                pcall(function()
                    part.CanCollide = false
                end)
            end
        end
    end)
end

local function updateNoclip()
