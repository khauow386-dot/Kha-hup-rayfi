    restoreCollision()

    currentCharacter = nil

    updateNoclip()
    setStatus(L("noclipOff"))
end

local function enableNoclip()
    noclip = true

    updateNoclip()
    bindNoclip(LP.Character)

    setStatus(L("noclipOn"))
end

