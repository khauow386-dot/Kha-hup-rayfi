--========================================================

local function makeDraggable(object,handle,onTap,onMove)
    local dragging = false
    local moved = false
    local dragType
    local startInput
    local startPosition

    handle.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = true
            moved = false
            dragType = "Mouse"
            startInput = input.Position
            startPosition = object.Position

        elseif input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            moved = false
            dragType = "Touch"
            startInput = input.Position
            startPosition = object.Position
        end
    end)

    local changed = UserInputService.InputChanged:Connect(function(input)
        if not dragging then return end

        local valid =
            (dragType == "Mouse" and input.UserInputType == Enum.UserInputType.MouseMovement)
            or (dragType == "Touch" and input.UserInputType == Enum.UserInputType.Touch)

        if not valid then return end

        local delta = input.Position-startInput

        if math.abs(delta.X)>5 or math.abs(delta.Y)>5 then
            moved = true
        end

        object.Position = UDim2.new(
            startPosition.X.Scale,
            startPosition.X.Offset+delta.X,
            startPosition.Y.Scale,
            startPosition.Y.Offset+delta.Y
        )
    end)

    local ended = UserInputService.InputEnded:Connect(function(input)
        if not dragging then return end

        local valid =
            (dragType == "Mouse" and input.UserInputType == Enum.UserInputType.MouseButton1)
            or (dragType == "Touch" and input.UserInputType == Enum.UserInputType.Touch)

        if not valid then return end

        dragging = false
        dragType = nil

        if moved then
            if onMove then onMove(object.Position) end
        elseif onTap then
            onTap()
        end
    end)

    table.insert(connections,changed)
    table.insert(connections,ended)
end

