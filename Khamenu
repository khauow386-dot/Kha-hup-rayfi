local function makeSlider(name,y,minValue,maxValue,initialValue,suffix,callback)
    local holder = create("Frame",{
        Name=name,
        Size=UDim2.new(1,-20,0,48),
        Position=UDim2.fromOffset(10,y),
        BackgroundTransparency=1
    },SettingsPage)

    local valueLabel = create("TextLabel",{
        Size=UDim2.new(1,0,0,17),
        BackgroundTransparency=1,
        Text="",
        TextColor3=CFG.White,
        TextSize=10,
        Font=Enum.Font.GothamBold,
        TextXAlignment=Enum.TextXAlignment.Left
    },holder)

    local track = create("Frame",{
        Size=UDim2.new(1,0,0,8),
        Position=UDim2.fromOffset(0,27),
        BackgroundColor3=Color3.fromRGB(55,65,58),
        BorderSizePixel=0
    },holder)

    round(track,5)

    local fill = create("Frame",{
        Size=UDim2.new(0,0,1,0),
        BackgroundColor3=borderColor,
        BorderSizePixel=0
    },track)

    round(fill,5)

    local knob = create("TextButton",{
        Size=UDim2.fromOffset(18,18),
        AnchorPoint=Vector2.new(0.5,0.5),
        Position=UDim2.new(0,0,0.5,0),
        BackgroundColor3=CFG.White,
        Text="",
        AutoButtonColor=false
    },track)

    round(knob,20)
    stroke(knob,borderColor,1)

    local value = math.clamp(initialValue,minValue,maxValue)
    local dragging = false

    local function updateVisual()
        local percent = (value-minValue)/(maxValue-minValue)

        fill.Size = UDim2.new(percent,0,1,0)
        knob.Position = UDim2.new(percent,0,0.5,0)

        valueLabel.Text = name .. " : " .. tostring(math.floor(value+0.5)) .. suffix
    end

    local function setFromX(x)
        local width = track.AbsoluteSize.X
        if width <= 0 then return end

        local percent = math.clamp(
            (x-track.AbsolutePosition.X)/width,
            0,
            1
        )

        value = minValue + (maxValue-minValue)*percent
        value = math.floor(value*100+0.5)/100

        updateVisual()
        callback(value)
    end

    local function begin(input)
        if input.UserInputType == Enum.UserInputType.Touch
        or input.UserInputType == Enum.UserInputType.MouseButton1 then

            dragging = true
            setFromX(input.Position.X)
        end
    end

    track.InputBegan:Connect(begin)
    knob.InputBegan:Connect(begin)

    local changed = UserInputService.InputChanged:Connect(function(input)
        if not dragging then return end

        if input.UserInputType == Enum.UserInputType.MouseMovement
        or input.UserInputType == Enum.UserInputType.Touch then
            setFromX(input.Position.X)
        end
    end)

    local ended = UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then
            dragging = false
        end
    end)

    table.insert(connections,changed)
    table.insert(connections,ended)

    updateVisual()

    return {
        Set = function(newValue)
            value = math.clamp(newValue,minValue,maxValue)
            updateVisual()
        end
    }
end

