	local sc = math.max(0.35, math.min(Theme.UIScale, fit))
	BaseScale = sc
	UIScaleObj.Scale = sc * AnimVal.Value
	MainCenter = Place(Main, MainSize * sc, MainCenter)
	BarCenter = Place(Bar, BarSize, BarCenter)
end
