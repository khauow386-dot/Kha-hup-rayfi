local FS = {
	can = type(writefile) == "function" and type(readfile) == "function" and type(isfile) == "function",
}

local function SafeWrite(path, data)
	if not FS.can then return false end
	pcall(function()
		if makefolder and isfolder and not isfolder(CONFIG_FOLDER) then makefolder(CONFIG_FOLDER) end
	end)
	return (pcall(writefile, path, data))
end

local function SafeRead(path)
	if not FS.can then return nil end
	local ok, res = pcall(function()
		if isfile(path) then return readfile(path) end
	end)
	if ok then return res end
	return nil
end

local function EncodeValue(v)
	local t = typeof(v)
	if t == "Color3" then return { __c = { v.R, v.G, v.B } } end
	if t == "boolean" or t == "number" or t == "string" then return v end
	return nil
end

local function DecodeValue(v)
	if type(v) == "table" and type(v.__c) == "table" then
		return Color3.new(v.__c[1] or 0, v.__c[2] or 0, v.__c[3] or 0)
	end
	return v
end

local function ToHex(c)
	return string.format("#%02X%02X%02X",
		math.floor(c.R * 255 + 0.5), math.floor(c.G * 255 + 0.5), math.floor(c.B * 255 + 0.5))
end

local function ParseHex(str)
	str = tostring(str or ""):gsub("#", ""):gsub("%s", "")
	if #str == 6 and str:match("^%x+$") then
		return Color3.fromRGB(tonumber(str:sub(1, 2), 16), tonumber(str:sub(3, 4), 16), tonumber(str:sub(5, 6), 16))
	end
	return nil
end

local DefaultTheme = {
	Accent = Color3.fromRGB(220, 25, 45),
	BorderTransparency = 0.10,
	GlassTransparency = 0.22,
	BorderThickness = 1.5,
	UIScale = 1,
}
local Theme = {}
for k, v in pairs(DefaultTheme) do Theme[k] = v end

local function ApplyThemeData(t)
	if type(t) ~= "table" then return end
	local c = DecodeValue(t.Accent)
	if typeof(c) == "Color3" then Theme.Accent = c end
	local function num(k, lo, hi)
		if type(t[k]) == "number" then Theme[k] = math.clamp(t[k], lo, hi) end
	end
	num("BorderTransparency", 0, 1)
	num("GlassTransparency", 0, 0.95)
	num("BorderThickness", 0, 5)
	num("UIScale", 0.5, 1.5)
end

local function ParseConfig(raw)
	if type(raw) ~= "string" or raw == "" then return nil end
	local ok, data = pcall(function() return HttpService:JSONDecode(raw) end)
	if not ok or type(data) ~= "table" then return nil end
	local flags = {}
	if type(data.flags) == "table" then
		for k, v in pairs(data.flags) do flags[k] = DecodeValue(v) end
	end
	return {
		flags = flags,
		theme = type(data.theme) == "table" and data.theme or {},
		ui = type(data.ui) == "table" and data.ui or {},
		autosave = data.autosave ~= false,
	}
end

local Config = ParseConfig(SafeRead(CONFIG_FILE)) or { flags = {}, theme = {}, ui = {}, autosave = true }
ApplyThemeData(Config.theme)

