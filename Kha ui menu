function Library:SetTitle(title, subtitle, short)
	if title then Title.Text = title end
	if subtitle then Subtitle.Text = subtitle end
	if short then self.ShortName = short end
	UpdateBar()
end

local visToken = 0
function Library:SetVisible(v)
	v = v and true or false
	visToken += 1
	local mine = visToken
	MenuOpen = v
	if v then
		Main.Visible = true
		AnimVal.Value = 0.8
		Tween(AnimVal, 0.3, { Value = 1 }, Enum.EasingStyle.Back)
	else
		Tween(AnimVal, 0.18, { Value = 0.8 }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
		task.delay(0.19, function()
			if mine == visToken then
				Main.Visible = false
				AnimVal.Value = 1
			end
		end)
	end
	QueueSave()
end

function Library:Toggle()
	self:SetVisible(not MenuOpen)
end

function Library:GetFlag(flag)
	return self.Flags[flag]
end

function Library:SetAccent(color)
	if typeof(color) == "Color3" then
		Theme.Accent = color
		ApplyTheme()
		QueueSave()
	end
end

local SyncSettings = function() end

function Library:Save(silent)
	local flags = {}
	for k, val in pairs(self.Flags) do
		local e = EncodeValue(val)
		if e ~= nil then flags[k] = e end
	end
	local data = {
		flags = flags,
		autosave = Config.autosave,
		theme = {
			Accent = EncodeValue(Theme.Accent),
			BorderTransparency = Theme.BorderTransparency,
			GlassTransparency = Theme.GlassTransparency,
			BorderThickness = Theme.BorderThickness,
			UIScale = Theme.UIScale,
		},
		ui = {
			main = { MainCenter.X, MainCenter.Y },
			bar = { BarCenter.X, BarCenter.Y },
			visible = MenuOpen,
		},
	}
	local ok, json = pcall(function() return HttpService:JSONEncode(data) end)
	local saved = ok and SafeWrite(CONFIG_FILE, json) or false
	if not silent then
		if saved then
			self:Notify("Đã lưu", "Cấu hình menu đã được lưu.", 2.5)
		else
			self:Notify("Không lưu được", FS.can and "Lỗi khi ghi file." or "Executor không hỗ trợ ghi file.", 3.5)
		end
	end
	return saved
end

function Library:Load(silent)
	local cfg = ParseConfig(SafeRead(CONFIG_FILE))
	if not cfg then
		if not silent then self:Notify("Chưa có cấu hình", "Không tìm thấy file đã lưu.", 3) end
		return false
	end
	Config.flags, Config.autosave = cfg.flags, cfg.autosave
	ApplyThemeData(cfg.theme)
	for flag, setter in pairs(Setters) do
		local val = cfg.flags[flag]
		if val ~= nil then pcall(setter, val) end
	end
	ApplyTheme()
	RefreshLayout()
	SyncSettings()
	if not silent then self:Notify("Đã tải", "Đã tải lại cấu hình đã lưu.", 2.5) end
	return true
end

local saveToken = 0
QueueSave = function()
	if not Config.autosave then return end
	saveToken += 1
	local mine = saveToken
	task.delay(1.5, function()
		if mine == saveToken and Config.autosave then Library:Save(true) end
	end)
end

function Library:Destroy()
	pcall(function() self:Save(true) end)
	for _, c in ipairs(Conns) do pcall(function() c:Disconnect() end) end
	Gui:Destroy()
end

