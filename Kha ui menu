local function Corner(obj, r)
	local c = Instance.new("UICorner")
	c.CornerRadius = UDim.new(0, r or 10)
	c.Parent = obj
	return c
end

-- Stroke(obj) = viền theo Theme (đổi màu/độ trong/độ dày được)
-- Stroke(obj, color, thickness, transparency) = viền cố định
local function Stroke(obj, color, thickness, transparency)
	local s = Instance.new("UIStroke")
	s.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	if color then
		s.Color = color
		s.Thickness = thickness or 1
		s.Transparency = transparency or 0
	else
		OnTheme(function()
			s.Color = Theme.Accent
			s.Thickness = Theme.BorderThickness
			s.Transparency = Theme.BorderTransparency
		end)
	end
	s.Parent = obj
	return s
end

local function MakeLabel(parent, text, size, font)
	local l = Instance.new("TextLabel")
	l.BackgroundTransparency = 1
	l.Text = text or ""
	l.TextSize = size or 11
	l.Font = font or Enum.Font.GothamSemibold
	l.TextColor3 = Color3.fromRGB(245, 245, 245)
	l.TextXAlignment = Enum.TextXAlignment.Left
	l.Parent = parent
	return l
end

local function Tween(obj, t, props, style, dir)
	local tw = TweenService:Create(obj, TweenInfo.new(t, style or Enum.EasingStyle.Quad, dir or Enum.EasingDirection.Out), props)
	tw:Play()
	return tw
end

local function Order(obj)
	if obj.Parent then obj.LayoutOrder = #obj.Parent:GetChildren() end
end

