local function CreateTabInternal(tabName, order)
	local page = Instance.new("Frame")
	page.Name = tabName
	page.Size = UDim2.new(1, -4, 0, 0)
	page.AutomaticSize = Enum.AutomaticSize.Y
	page.BackgroundTransparency = 1
	page.Visible = false
	page.Parent = RightScroll

	local layout = Instance.new("UIListLayout")
	layout.Padding = UDim.new(0, 8)
	layout.SortOrder = Enum.SortOrder.LayoutOrder
	layout.Parent = page
	Pages[tabName] = page
	local pagePad = Instance.new("UIPadding")
	pagePad.Parent = page

	local tabBtn = Instance.new("TextButton")
	tabBtn.Size = UDim2.new(1, -4, 0, 38)
	tabBtn.BorderSizePixel = 0
	tabBtn.Text = tabName
	tabBtn.TextColor3 = Color3.fromRGB(245, 245, 245)
	tabBtn.TextSize = 11
	tabBtn.Font = Enum.Font.GothamSemibold
	tabBtn.AutoButtonColor = false
	tabBtn.LayoutOrder = order
	tabBtn.Parent = MenuScroll
	Corner(tabBtn, 9)
	Stroke(tabBtn)
	Tabs[tabName] = tabBtn
	Animate(tabBtn)

	tabBtn.MouseButton1Click:Connect(function() SelectTab(tabName) end)
	RefreshTabs()
	return BuildTab(page)
end

function Library:CreateTab(tabName)
	UserTabCount += 1
	local T = CreateTabInternal(tabName, UserTabCount)
	if UserTabCount == 1 then SelectTab(tabName) end
	return T
end

