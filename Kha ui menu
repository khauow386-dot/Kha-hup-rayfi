--========================================================
local function Resolve(flag, default)
	local restored = false
	if flag then
		local saved = Config.flags[flag]
		if saved ~= nil and typeof(saved) == typeof(default) then
			default = saved
			restored = true
		end
		Library.Flags[flag] = default
	end
	return default, restored
end

local function SetFlag(flag, v)
	if flag then
		Library.Flags[flag] = v
		QueueSave()
	end
end

local function RegisterSetter(flag, obj)
	if flag then Setters[flag] = function(v) obj:Set(v) end end
end

