-- BUILD TAB (CÁC COMPONENT NGƯỜI DÙNG GỌI)
--========================================================
local function BuildTab(page)
	local T = {}

	function T:CreateSection(text)
		local holder = Instance.new("Frame")
		holder.Size = UDim2.new(1, -4, 0, 24)
		holder.BackgroundTransparency = 1
		holder.Parent = page
		Order(holder)
		local l = MakeLabel(holder, string.upper(text), 10, Enum.Font.GothamBold)
		l.Size = UDim2.new(1, 0, 0, 20)
		l.Position = UDim2.new(0, 4, 0, 0)
		local line = Instance.new("Frame")
		line.Position = UDim2.new(0, 0, 1, -2)
		line.Size = UDim2.new(1, 0, 0, 1)
		line.BorderSizePixel = 0
		line.BackgroundTransparency = 0.6
		line.Parent = holder
		OnTheme(function()
			l.TextColor3 = Theme.Accent
			line.BackgroundColor3 = Theme.Accent
		end)
	end

	function T:CreateLabel(text)
		local row = Instance.new("Frame")
		row.Size = UDim2.new(1, -4, 0, 0)
		row.AutomaticSize = Enum.AutomaticSize.Y
		row.BackgroundColor3 = ROWBG
		row.BackgroundTransparency = 0.3
		row.BorderSizePixel = 0
		row.Parent = page
		Order(row)
		Corner(row, 10)
		local pad = Instance.new("UIPadding")
		pad.PaddingTop, pad.PaddingBottom = UDim.new(0, 9), UDim.new(0, 9)
		pad.PaddingLeft, pad.PaddingRight = UDim.new(0, 10), UDim.new(0, 10)
		pad.Parent = row
		local l = MakeLabel(row, text, 11, Enum.Font.Gotham)
		l.Size = UDim2.new(1, 0, 0, 0)
		l.AutomaticSize = Enum.AutomaticSize.Y
		l.TextWrapped = true
		l.TextColor3 = Color3.fromRGB(200, 200, 210)
		local obj = {}
		function obj:Set(t) l.Text = tostring(t) end
		return obj
	end
	T.CreateParagraph = T.CreateLabel

	function T:CreateButton(text, callback)
		local btn = Instance.new("TextButton")
		btn.Size = UDim2.new(1, -4, 0, 42)
		btn.BackgroundColor3 = ROWBG
		btn.BackgroundTransparency = 0.18
		btn.BorderSizePixel = 0
		btn.Text = text
		btn.TextColor3 = Color3.fromRGB(245, 245, 245)
		btn.TextSize = 11
		btn.Font = Enum.Font.GothamBold
		btn.AutoButtonColor = false
		btn.Parent = page
		Order(btn)
		Corner(btn, 10)
		Stroke(btn, ROWLINE, 1, 0)

		Animate(btn)

		local baseText = text
		local token = 0
		btn.MouseButton1Click:Connect(function()
			btn.BackgroundColor3 = Theme.Accent
			Tween(btn, 0.4, { BackgroundColor3 = ROWBG })
			Fire(callback)
		end)

		local obj = {}
		function obj:SetText(t)
			baseText = t
			btn.Text = t
		end
		-- Hiệu ứng thành công: chớp xanh + đổi chữ tạm thời
		function obj:Success(msg, secs)
			secs = secs or 1.6
			token += 1
			local mine = token
			btn.Text = msg or "Đã sao chép!"
			btn.BackgroundColor3 = Color3.fromRGB(40, 165, 85)
			Tween(btn, secs, { BackgroundColor3 = ROWBG })
			task.delay(secs, function()
				if mine == token and btn.Parent then btn.Text = baseText end
			end)
		end
		return obj
	end

	function T:CreateToggle(text, default, callback, flag)
		local enabled = Resolve(flag, default and true or false)
		local row = NewRow(page, 42)

		local label = MakeLabel(row, text, 11)
		label.Position = UDim2.new(0, 12, 0, 0)
		label.Size = UDim2.new(1, -64, 1, 0)

		local track = Instance.new("TextButton")
		track.Size = UDim2.new(0, 38, 0, 20)
		track.Position = UDim2.new(1, -48, 0.5, -10)
		track.Text = ""
		track.AutoButtonColor = false
		track.BorderSizePixel = 0
		track.Parent = row
		Corner(track, 10)
		Animate(track)

		local knob = Instance.new("Frame")
		knob.Size = UDim2.new(0, 14, 0, 14)
		knob.BackgroundColor3 = Color3.fromRGB(245, 245, 245)
		knob.BorderSizePixel = 0
		knob.Parent = track
		Corner(knob, 7)

		local function render(anim)
			local col = enabled and Theme.Accent or NEUTRAL
			if anim then Tween(track, 0.2, { BackgroundColor3 = col }) else track.BackgroundColor3 = col end
			local pos = enabled and UDim2.new(1, -17, 0.5, -7) or UDim2.new(0, 3, 0.5, -7)
			if anim then
				Tween(knob, 0.25, { Position = pos }, Enum.EasingStyle.Back)
			else
				knob.Position = pos
			end
		end
		OnTheme(function() render(false) end)

		local obj = {}
		function obj:Get() return enabled end
		function obj:Set(v)
			enabled = v and true or false
			render(true)
			SetFlag(flag, enabled)
			Fire(callback, enabled)
		end
		track.MouseButton1Click:Connect(function() obj:Set(not enabled) end)

		RegisterSetter(flag, obj)
		Fire(callback, enabled)
		return obj
	end

	function T:CreateSlider(text, min, max, default, callback, flag, step, opts)
		local init, restored = Resolve(flag, default)
		local s = MakeSlider(page, text, min, max, init, step, function(v)
			SetFlag(flag, v)
			Fire(callback, v)
		end, opts)
		if flag then Library.Flags[flag] = s:Get() end
		RegisterSetter(flag, s)
		if restored then Fire(callback, s:Get()) end
		return s
	end

	function T:CreateInput(text, default, callback, flag)
		local numeric = type(default) == "number"
		local value, restored = Resolve(flag, default)

		local row = NewRow(page, 45)
		local label = MakeLabel(row, text, 11, Enum.Font.GothamBold)
		label.Position = UDim2.new(0, 10, 0, 0)
		label.Size = UDim2.new(0.35, 0, 1, 0)

		local box = Instance.new("TextBox")
		box.Position = UDim2.new(0.4, 0, 0.15, 0)
		box.Size = UDim2.new(0.57, 0, 0.7, 0)
		box.BackgroundColor3 = Color3.fromRGB(12, 12, 16)
		box.BorderSizePixel = 0
		box.Text = tostring(value == nil and "" or value)
		box.TextColor3 = Color3.fromRGB(245, 245, 245)
		box.TextSize = 11
		box.Font = Enum.Font.Gotham
		box.ClearTextOnFocus = false
		box.ClipsDescendants = true
		box.Parent = row
		Corner(box, 7)

		local obj = { Box = box }
		function obj:Get() return value end
		function obj:Set(v)
			if numeric then
				v = tonumber(v)
				if not v then return end
			else
				v = tostring(v)
			end
			value = v
			box.Text = tostring(v)
			SetFlag(flag, v)
			Fire(callback, v)
		end

		box.FocusLost:Connect(function()
			if numeric then
				local n = tonumber(box.Text)
				if n then obj:Set(n) else box.Text = tostring(value) end
			else
				obj:Set(box.Text)
			end
		end)

		RegisterSetter(flag, obj)
		if restored then Fire(callback, value) end
		return obj
	end

	function T:CreateDropdown(text, options, default, callback, flag)
		options = options or {}
		local value, restored = Resolve(flag, default ~= nil and default or options[1])
		if not table.find(options, value) then
			value = (default ~= nil) and default or options[1]
			restored = false
			if flag then Library.Flags[flag] = value end
		end

		local row = NewExpandRow(page)

		local header = Instance.new("TextButton")
		header.Size = UDim2.new(1, 0, 0, 42)
		header.BackgroundTransparency = 1
		header.Text = ""
		header.LayoutOrder = 1
		header.Parent = row

		local label = MakeLabel(header, text, 11)
		label.Position = UDim2.new(0, 12, 0, 0)
		label.Size = UDim2.new(0.5, -12, 1, 0)

		local valLabel = MakeLabel(header, "", 11, Enum.Font.Gotham)
		valLabel.Position = UDim2.new(0.4, 0, 0, 0)
		valLabel.Size = UDim2.new(0.6, -12, 1, 0)
		valLabel.TextXAlignment = Enum.TextXAlignment.Right
		valLabel.TextColor3 = Color3.fromRGB(170, 170, 180)

		local list = Instance.new("Frame")
		list.Size = UDim2.new(1, 0, 0, 0)
		list.AutomaticSize = Enum.AutomaticSize.Y
		list.BackgroundTransparency = 1
		list.Visible = false
		list.LayoutOrder = 2
		list.Parent = row
		local ll = Instance.new("UIListLayout")
		ll.Padding = UDim.new(0, 4)
		ll.SortOrder = Enum.SortOrder.LayoutOrder
		ll.Parent = list
		local pad = Instance.new("UIPadding")
		pad.PaddingLeft, pad.PaddingRight, pad.PaddingBottom = UDim.new(0, 8), UDim.new(0, 8), UDim.new(0, 8)
		pad.Parent = list

		local buttons = {}
		local obj = {}

		local function refresh()
			for opt, b in pairs(buttons) do
				local sel = (opt == value)
				b.BackgroundColor3 = sel and Theme.Accent or NEUTRAL
				b.BackgroundTransparency = sel and 0.1 or 0.3
			end
			valLabel.Text = tostring(value) .. "   " .. (list.Visible and "^" or "v")
		end
		OnTheme(refresh)

		local function build(opts)
			for _, b in pairs(buttons) do b:Destroy() end
			buttons = {}
			for i, opt in ipairs(opts) do
				local b = Instance.new("TextButton")
				b.Size = UDim2.new(1, 0, 0, 30)
				b.BorderSizePixel = 0
				b.Text = tostring(opt)
				b.TextSize = 11
				b.Font = Enum.Font.GothamSemibold
				b.TextColor3 = Color3.fromRGB(245, 245, 245)
				b.AutoButtonColor = false
				b.LayoutOrder = i
				b.Parent = list
				Corner(b, 8)
				buttons[opt] = b
				b.MouseButton1Click:Connect(function()
					list.Visible = false
					obj:Set(opt)
				end)
			end
			refresh()
		end

		function obj:Get() return value end
		function obj:Set(v)
			value = v
			refresh()
			SetFlag(flag, v)
			Fire(callback, v)
		end
		function obj:Refresh(newOptions, newDefault)
			options = newOptions or {}
			if newDefault ~= nil then value = newDefault end
			if not table.find(options, value) then value = options[1] end
			build(options)
		end

		header.MouseButton1Click:Connect(function()
			list.Visible = not list.Visible
			refresh()
			if list.Visible then
				local i = 0
				for _, b in pairs(buttons) do
					i += 1
					local target = b.BackgroundTransparency
					b.BackgroundTransparency = 1
					b.TextTransparency = 1
					task.delay(math.min(i, 8) * 0.025, function()
						Tween(b, 0.22, { BackgroundTransparency = target, TextTransparency = 0 })
					end)
				end
			end
		end)

		build(options)
		RegisterSetter(flag, obj)
		if restored then Fire(callback, value) end
		return obj
	end

	function T:CreateKeybind(text, defaultKey, callback, flag)
		local defName = typeof(defaultKey) == "EnumItem" and defaultKey.Name or tostring(defaultKey or "None")
		local keyName, restored = Resolve(flag, defName)

		local row = NewRow(page, 42)
		local label = MakeLabel(row, text, 11)
		label.Position = UDim2.new(0, 12, 0, 0)
		label.Size = UDim2.new(1, -100, 1, 0)

		local btn = Instance.new("TextButton")
		btn.Size = UDim2.new(0, 76, 0, 26)
		btn.Position = UDim2.new(1, -86, 0.5, -13)
		btn.BackgroundColor3 = Color3.fromRGB(12, 12, 16)
		btn.BorderSizePixel = 0
		btn.TextSize = 11
		btn.Font = Enum.Font.GothamBold
		btn.TextColor3 = Color3.fromRGB(245, 245, 245)
		btn.AutoButtonColor = false
		btn.Parent = row
		Corner(btn, 7)

		local listening = false
		local obj = {}
		local function render() btn.Text = listening and "..." or keyName end
		render()

		function obj:Get() return keyName end
		function obj:Set(name)
			keyName = tostring(name)
			listening = false
			render()
			SetFlag(flag, keyName)
		end

		btn.MouseButton1Click:Connect(function()
			listening = true
			render()
		end)

		Connect(UIS.InputBegan, function(input, gpe)
			if input.UserInputType ~= Enum.UserInputType.Keyboard then return end
			if listening then
				obj:Set(input.KeyCode == Enum.KeyCode.Escape and "None" or input.KeyCode.Name)
			elseif not gpe and input.KeyCode.Name == keyName then
				Fire(callback)
			end
		end)

		RegisterSetter(flag, obj)
		return obj
	end

	function T:CreateColorPicker(text, default, callback, flag)
		default = default or Color3.new(1, 1, 1)
		local color, restored = Resolve(flag, default)
		local h, s, v = color:ToHSV()

		local row = NewExpandRow(page)

		local header = Instance.new("TextButton")
		header.Size = UDim2.new(1, 0, 0, 42)
		header.BackgroundTransparency = 1
		header.Text = ""
		header.LayoutOrder = 1
		header.Parent = row

		local label = MakeLabel(header, text, 11)
		label.Position = UDim2.new(0, 12, 0, 0)
		label.Size = UDim2.new(1, -70, 1, 0)

		local swatch = Instance.new("Frame")
		swatch.Size = UDim2.new(0, 36, 0, 20)
		swatch.Position = UDim2.new(1, -48, 0.5, -10)
		swatch.BackgroundColor3 = color
		swatch.BorderSizePixel = 0
		swatch.Parent = header
		Corner(swatch, 5)
		Stroke(swatch, Color3.new(1, 1, 1), 1, 0.6)

		local panel = Instance.new("Frame")
		panel.Size = UDim2.new(1, 0, 0, 0)
		panel.AutomaticSize = Enum.AutomaticSize.Y
		panel.BackgroundTransparency = 1
		panel.Visible = false
		panel.LayoutOrder = 2
		panel.Parent = row
		local pl = Instance.new("UIListLayout")
		pl.Padding = UDim.new(0, 5)
		pl.SortOrder = Enum.SortOrder.LayoutOrder
		pl.Parent = panel
		local pp = Instance.new("UIPadding")
		pp.PaddingLeft, pp.PaddingRight, pp.PaddingBottom = UDim.new(0, 6), UDim.new(0, 6), UDim.new(0, 8)
		pp.Parent = panel

		local obj = {}
		local hueS, satS, valS, hexBox
		local satGrad, valGrad

		local function paint()
			color = Color3.fromHSV(h, s, v)
			swatch.BackgroundColor3 = color
			if hexBox and not hexBox:IsFocused() then hexBox.Text = ToHex(color) end
			if satGrad then
				satGrad.Color = ColorSequence.new(Color3.fromHSV(h, 0, 1), Color3.fromHSV(h, 1, 1))
				valGrad.Color = ColorSequence.new(Color3.new(0, 0, 0), Color3.fromHSV(h, s, 1))
			end
		end
		local function commit()
			paint()
			SetFlag(flag, color)
			Fire(callback, color)
		end

		hueS = MakeSlider(panel, "Sắc độ", 0, 1, h, 0.005, function(x) h = x commit() end,
			{ gradient = true, display = function(x) return math.floor(x * 360 + 0.5) .. "°" end })
		satS = MakeSlider(panel, "Độ đậm", 0, 1, s, 0.005, function(x) s = x commit() end,
			{ gradient = true, display = function(x) return math.floor(x * 100 + 0.5) .. "%" end })
		valS = MakeSlider(panel, "Độ sáng", 0, 1, v, 0.005, function(x) v = x commit() end,
			{ gradient = true, display = function(x) return math.floor(x * 100 + 0.5) .. "%" end })

		local hueGrad = Instance.new("UIGradient")
		local kps = {}
		for i = 0, 6 do
			table.insert(kps, ColorSequenceKeypoint.new(i / 6, Color3.fromHSV(i / 6 >= 1 and 0.9999 or i / 6, 1, 1)))
		end
		hueGrad.Color = ColorSequence.new(kps)
		hueGrad.Parent = hueS.Track
		satGrad = Instance.new("UIGradient")
		satGrad.Parent = satS.Track
		valGrad = Instance.new("UIGradient")
		valGrad.Parent = valS.Track

		local function setColor(c, silent)
			h, s, v = c:ToHSV()
			hueS:Set(h, true)
			satS:Set(s, true)
			valS:Set(v, true)
			paint()
			if not silent then
				SetFlag(flag, color)
				Fire(callback, color)
			end
		end

		-- HEX
		local hexRow = NewRow(panel, 38)
		local hl = MakeLabel(hexRow, "HEX", 11, Enum.Font.GothamBold)
		hl.Position = UDim2.new(0, 12, 0, 0)
		hl.Size = UDim2.new(0.3, 0, 1, 0)
		hexBox = Instance.new("TextBox")
		hexBox.Position = UDim2.new(0.4, 0, 0.15, 0)
