-- COMPONENT NỀN
--========================================================
local NEUTRAL = Color3.fromRGB(43, 43, 51)
local ROWBG = Color3.fromRGB(27, 27, 34)
local ROWLINE = Color3.fromRGB(55, 55, 65)

local function NewRow(parent, height)
	local row = Instance.new("Frame")
	row.Size = UDim2.new(1, -4, 0, height)
	row.BackgroundColor3 = ROWBG
	row.BackgroundTransparency = 0.18
	row.BorderSizePixel = 0
	row.Parent = parent
	Order(row)
	Corner(row, 10)
	Stroke(row, ROWLINE, 1, 0)
	return row
end

-- Hàng tự giãn chiều cao (cho dropdown / color picker)
local function NewExpandRow(parent)
	local row = Instance.new("Frame")
	row.Size = UDim2.new(1, -4, 0, 0)
	row.AutomaticSize = Enum.AutomaticSize.Y
	row.BackgroundColor3 = ROWBG
	row.BackgroundTransparency = 0.18
	row.BorderSizePixel = 0
	row.Parent = parent
	Order(row)
	Corner(row, 10)
	Stroke(row, ROWLINE, 1, 0)
	local l = Instance.new("UIListLayout")
	l.Padding = UDim.new(0, 2)
	l.SortOrder = Enum.SortOrder.LayoutOrder
	l.Parent = row
	return row
end

local function MakeSlider(parent, text, min, max, default, step, callback, opts)
	opts = opts or {}
	step = (step and step > 0) and step or 1

	local function snap(v)
		v = math.clamp(v, min, max)
		v = min + math.floor((v - min) / step + 0.5) * step
		return math.clamp(v, min, max)
	end
	local value = snap(default or min)

	local function fmt(v)
		if opts.display then return opts.display(v) end
		if step >= 1 then return tostring(math.floor(v + 0.5)) .. (opts.suffix or "") end
		local d = math.max(0, math.ceil(-math.log10(step) - 1e-9))
		return string.format("%." .. d .. "f", v) .. (opts.suffix or "")
	end

	local row = NewRow(parent, 50)

	local label = MakeLabel(row, text, 11)
	label.Position = UDim2.new(0, 12, 0, 6)
	label.Size = UDim2.new(0.6, 0, 0, 16)

	local valLabel = MakeLabel(row, "", 11, Enum.Font.Gotham)
	valLabel.Position = UDim2.new(0.5, 0, 0, 6)
	valLabel.Size = UDim2.new(0.5, -12, 0, 16)
	valLabel.TextXAlignment = Enum.TextXAlignment.Right
	valLabel.TextColor3 = Color3.fromRGB(170, 170, 180)

	local track = Instance.new("Frame")
	track.Position = UDim2.new(0, 12, 0, 31)
	track.Size = UDim2.new(1, -24, 0, 8)
	track.BackgroundColor3 = opts.gradient and Color3.new(1, 1, 1) or NEUTRAL
	track.BorderSizePixel = 0
	track.Parent = row
	Corner(track, 4)

	local fill = Instance.new("Frame")
	fill.BorderSizePixel = 0
	fill.Size = UDim2.new(0, 0, 1, 0)
	fill.BackgroundTransparency = opts.gradient and 1 or 0
	fill.Parent = track
	Corner(fill, 4)

	local knob = Instance.new("Frame")
	knob.AnchorPoint = Vector2.new(0.5, 0.5)
	knob.Size = UDim2.new(0, 14, 0, 14)
	knob.BackgroundColor3 = Color3.fromRGB(245, 245, 245)
	knob.BorderSizePixel = 0
	knob.ZIndex = 2
	knob.Parent = track
	Corner(knob, 7)
	Stroke(knob, Color3.fromRGB(20, 20, 26), 1.5, 0)

	local hit = Instance.new("TextButton")
	hit.BackgroundTransparency = 1
	hit.Text = ""
	hit.Position = UDim2.new(0, 6, 0, 22)
	hit.Size = UDim2.new(1, -12, 0, 26)
	hit.ZIndex = 3
	hit.Parent = row

	local function render()
		local a = (max - min) == 0 and 0 or (value - min) / (max - min)
		fill.Size = UDim2.new(a, 0, 1, 0)
		knob.Position = UDim2.new(a, 0, 0.5, 0)
		valLabel.Text = fmt(value)
	end
	render()

	if not opts.gradient then
		OnTheme(function() fill.BackgroundColor3 = Theme.Accent end)
	end

	local dragging = false
	local function fromInput(input)
		local a = math.clamp((input.Position.X - track.AbsolutePosition.X) / math.max(track.AbsoluteSize.X, 1), 0, 1)
		local nv = snap(min + (max - min) * a)
		if nv ~= value then
			value = nv
			render()
			Fire(callback, value)
		end
	end

	hit.InputBegan:Connect(function(input)
		if IsPointer(input) then
			dragging = true
			RightScroll.ScrollingEnabled = false
			Tween(knob, 0.15, { Size = UDim2.new(0, 19, 0, 19) }, Enum.EasingStyle.Back)
			fromInput(input)
		end
	end)
	Connect(UIS.InputChanged, function(input)
		if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement
			or input.UserInputType == Enum.UserInputType.Touch) then
			fromInput(input)
		end
	end)
	Connect(UIS.InputEnded, function(input)
		if dragging and IsPointer(input) then
			dragging = false
			RightScroll.ScrollingEnabled = true
			Tween(knob, 0.2, { Size = UDim2.new(0, 14, 0, 14) }, Enum.EasingStyle.Back)
		end
	end)

	local obj = { Frame = row, Track = track }
	function obj:Get() return value end
	function obj:Set(v, silent)
		value = snap(tonumber(v) or value)
		render()
		if not silent then Fire(callback, value) end
	end
	return obj
end

