	local changed = currentTab ~= name
	currentTab = name
	for pName, pObj in pairs(Pages) do pObj.Visible = (pName == name) end
	RefreshTabs()
	RightScroll.CanvasPosition = Vector2.new(0, 0)
	local pg = Pages[name]
	local pad = pg and pg:FindFirstChildOfClass("UIPadding")
	if pad and changed then
		pad.PaddingLeft = UDim.new(0, 22)
		Tween(pad, 0.3, { PaddingLeft = UDim.new(0, 0) }, Enum.EasingStyle.Quint)
	end
end

