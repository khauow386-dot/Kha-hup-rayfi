local function IsPointer(input)
	return input.UserInputType == Enum.UserInputType.MouseButton1
		or input.UserInputType == Enum.UserInputType.Touch
end

-- Hiệu ứng hover (phóng nhẹ) + nhấn (thu nhỏ rồi bật lại)
local function Animate(btn)
	local sc = Instance.new("UIScale")
	sc.Parent = btn
	btn.InputBegan:Connect(function(i)
		if IsPointer(i) then
			Tween(sc, 0.08, { Scale = 0.94 })
		elseif i.UserInputType == Enum.UserInputType.MouseMovement then
			Tween(sc, 0.12, { Scale = 1.03 })
		end
	end)
	btn.InputEnded:Connect(function(i)
		if IsPointer(i) then
			Tween(sc, 0.25, { Scale = 1 }, Enum.EasingStyle.Back)
		elseif i.UserInputType == Enum.UserInputType.MouseMovement then
			Tween(sc, 0.12, { Scale = 1 })
		end
	end)
end
Animate(Close)
Animate(Bar)

local function MakeDraggable(handle, getCenter, setCenter, onClick)
	local dragging, startInput, startPos, startCenter, moved = false, nil, nil, nil, false

	Connect(handle.InputBegan, function(input)
		if IsPointer(input) then
			dragging, moved = true, false
			startInput, startPos, startCenter = input, input.Position, getCenter()
		end
	end)

	Connect(UIS.InputChanged, function(input)
		if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement
			or input.UserInputType == Enum.UserInputType.Touch) then
			local d = input.Position - startPos
			if d.Magnitude > 5 then moved = true end
			if moved then setCenter(startCenter + Vector2.new(d.X, d.Y)) end
		end
	end)

	Connect(UIS.InputEnded, function(input)
		if dragging and IsPointer(input)
			and (input.UserInputType ~= Enum.UserInputType.Touch or input == startInput) then
			dragging = false
			if moved then
				QueueSave()
			elseif onClick then
				onClick()
			end
		end
	end)
end

MakeDraggable(Top,
	function() return MainCenter end,
	function(c) MainCenter = Place(Main, MainSize * BaseScale, c) end)

MakeDraggable(Bar,
	function() return BarCenter end,
	function(c) BarCenter = Place(Bar, BarSize, c) end,
	function() Library:Toggle() end)

