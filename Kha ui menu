function Library:Copy(text)
	local fn = (type(setclipboard) == "function" and setclipboard)
		or (type(toclipboard) == "function" and toclipboard)
	if fn then return (pcall(fn, tostring(text))) end
	return false
end

function Library:GetPosition()
	local ch = Player.Character
	local root = ch and (ch:FindFirstChild("HumanoidRootPart") or ch.PrimaryPart)
	return root and root.Position or nil
end

function Library:JoinServer(id)
	id = (tostring(id or ""):gsub("%s", ""))
	if #id < 8 then
		self:Notify("Server ID", "Hãy nhập Server ID hợp lệ.", 3)
		return false
	end
	if id == game.JobId then
		self:Notify("Server ID", "Bạn đang ở đúng server này rồi.", 3)
		return false
	end
	self:Notify("Server", "Đang vào server vừa nhập...", 3)
	self:Save(true)
	local ok, err = pcall(function()
		TeleportService:TeleportToPlaceInstance(game.PlaceId, id, Player)
	end)
	if not ok then self:Notify("Lỗi dịch chuyển", tostring(err), 4) end
	return ok
end

local hopping = false
function Library:ServerHop()
	if hopping then return end
	hopping = true
	self:Notify("Server Hop", "Đang tìm server khác...", 3)
	task.spawn(function()
		local target, cursor = nil, ""
		for _ = 1, 3 do
			local url = string.format(
				"https://games.roblox.com/v1/games/%d/servers/Public?sortOrder=Asc&limit=100%s",
				game.PlaceId, cursor ~= "" and ("&cursor=" .. cursor) or "")
			local ok, data = pcall(function() return HttpService:JSONDecode(game:HttpGet(url)) end)
			if not ok or type(data) ~= "table" or type(data.data) ~= "table" then break end
			local pool = {}
			for _, sv in ipairs(data.data) do
				if sv.id ~= game.JobId and type(sv.playing) == "number"
					and type(sv.maxPlayers) == "number" and sv.playing < sv.maxPlayers - 1 then
					table.insert(pool, sv.id)
				end
			end
			if #pool > 0 then
				target = pool[math.random(#pool)]
				break
			end
			if not data.nextPageCursor then break end
			cursor = data.nextPageCursor
		end

		self:Save(true)
		if target then
			local ok, err = pcall(function()
				TeleportService:TeleportToPlaceInstance(game.PlaceId, target, Player)
			end)
			if not ok then self:Notify("Lỗi dịch chuyển", tostring(err), 4) end
		else
			self:Notify("Server Hop", "Không lấy được danh sách server, thử vào server ngẫu nhiên...", 3)
			pcall(function() TeleportService:Teleport(game.PlaceId, Player) end)
		end
		task.wait(6)
		hopping = false
	end)
end

