local MainCenter, BarCenter

local function Place(frame, size, center)
	local v = ViewSize()
	local hx, hy = size.X / 2, size.Y / 2
	local x = (v.X <= size.X) and v.X / 2 or math.clamp(center.X, hx, v.X - hx)
	local y = (v.Y <= size.Y) and v.Y / 2 or math.clamp(center.Y, hy, v.Y - hy)
	frame.Position = UDim2.fromOffset(x, y)
	return Vector2.new(x, y)
end

do
	local v = ViewSize()
	local m, b = Config.ui.main, Config.ui.bar
	MainCenter = (type(m) == "table" and type(m[1]) == "number" and type(m[2]) == "number")
		and Vector2.new(m[1], m[2]) or Vector2.new(v.X / 2, v.Y / 2)
	BarCenter = (type(b) == "table" and type(b[1]) == "number" and type(b[2]) == "number")
		and Vector2.new(b[1], b[2]) or Vector2.new(v.X / 2, 6 + BAR_H / 2)
end

local function RefreshLayout()
