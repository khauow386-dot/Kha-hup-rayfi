local function adaptTab(tab)
    local A = {}

    function A:AddToggle(settings)
        settings = table.clone(settings or {})
        local flag = settings.Flag
        settings.Flag = nil
        settings.CurrentValue = settings.CurrentValue ~= nil and settings.CurrentValue or settings.Default or false
        settings.Default = nil
        return tab:CreateToggle(settings, flag)
    end

    function A:AddButton(settings)
        settings = table.clone(settings or {})
        settings.Primary = nil
        return tab:CreateButton(settings)
    end

    function A:AddSlider(settings)
        settings = table.clone(settings or {})
        local flag = settings.Flag
        local minv = settings.Min or 0
        local maxv = settings.Max or 100
        local defv = settings.Default
        local suffix = settings.Suffix
        settings.Min, settings.Max, settings.Default, settings.Flag = nil, nil, nil, nil
        settings.Range = {minv, maxv}
        settings.CurrentValue = defv
        settings.Increment = settings.Increment or ((maxv - minv) <= 20 and 0.5 or 1)
        if suffix then settings.Suffix = suffix end
        return tab:CreateSlider(settings, flag)
    end

    function A:AddDropdown(settings)
        settings = table.clone(settings or {})
        local flag = settings.Flag
        local def = settings.Default
        settings.Flag, settings.Default = nil, nil
        settings.CurrentOption = type(def) == "table" and def or {def}
        settings.MultipleOptions = false
        return tab:CreateDropdown(settings, flag)
    end

    function A:AddMultiDropdown(settings)
        settings = table.clone(settings or {})
        local flag = settings.Flag
        local def = settings.Default or {}
        settings.Flag, settings.Default = nil, nil
        settings.CurrentOption = type(def) == "table" and def or {}
        settings.MultipleOptions = true
        return tab:CreateDropdown(settings, flag)
    end

    function A:AddInput(settings)
        settings = table.clone(settings or {})
        local flag = settings.Flag
        settings.Flag = nil
        settings.CurrentValue = settings.Default or settings.CurrentValue or ""
        settings.Default = nil
        settings.Numeric = settings.Numeric or false
        settings.Enter = settings.Enter or false
        return tab:CreateInput(settings, flag)
    end

    function A:AddKeybind(settings)
        settings = table.clone(settings or {})
        local flag = settings.Flag
        settings.Flag = nil
        settings.CurrentBind = settings.Default or settings.CurrentBind or "K"
        settings.Default = nil
        return tab:CreateBind(settings, flag)
    end

    function A:AddDivider()
        return tab:CreateDivider()
    end

    function A:AddParagraph(settings)
        return tab:CreateParagraph(settings or {})
    end

    function A:AddSection(name)
        return tab:CreateSection(name)
    end

    function A:AddSubTab(name)
        return adaptTab(LunaWindow:CreateTab({
            Name = name,
            Icon = "list",
            ImageSource = "Material",
            ShowTitle = true
        }))
    end

    return A
end

