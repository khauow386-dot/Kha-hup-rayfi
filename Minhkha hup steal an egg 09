local walkSpeedEnabled = false; local walkSpeedVal = 24
local jumpPowerEnabled = false; local jumpPowerVal = 60
local flying = false
local savedFlyPoint = nil
local returningToFlyPoint = false

local function ApplyWalkSpeed(v)
    walkSpeedVal = v
    local hum = findHum()
    if hum and walkSpeedEnabled then hum.WalkSpeed = v end
end

local function ApplyJumpPower(v)
    jumpPowerVal = v
    local hum = findHum()
    if hum and jumpPowerEnabled then hum.UseJumpPower = true; hum.JumpPower = v end
end

track(RunService.Stepped:Connect(function()
    if HUB.dead then return end
    local hum = findHum()
    if hum then
        if walkSpeedEnabled then hum.WalkSpeed = walkSpeedVal end
        if jumpPowerEnabled then hum.UseJumpPower = true; hum.JumpPower = jumpPowerVal end
    end
end))

local function startFly()
    if flying then return end
    local hrp = findHRP()
    if not hrp then return end
    flying = true; hrp.Anchored = true
    local bodyGyro = Instance.new("BodyGyro")
    bodyGyro.MaxTorque = Vector3.new(1, 1, 1) * 1e5
    bodyGyro.P = 1e5
    bodyGyro.CFrame = hrp.CFrame
    bodyGyro.Parent = hrp

    HUB._fly = {
        hrp = hrp, gyro = bodyGyro,
        conn = track(RunService.RenderStepped:Connect(function(dt)
            if not flying or HUB.dead then return end
            local cam = GetCamera()
            if not cam then return end
            local look = cam.CFrame.LookVector
            local right = cam.CFrame.RightVector
            local dir = Vector3.zero
            if UserInputService:IsKeyDown(Enum.KeyCode.W) then dir = dir + Vector3.new(look.X, 0, look.Z).Unit end
            if UserInputService:IsKeyDown(Enum.KeyCode.S) then dir = dir - Vector3.new(look.X, 0, look.Z).Unit end
            if UserInputService:IsKeyDown(Enum.KeyCode.A) then dir = dir - Vector3.new(right.X, 0, right.Z).Unit end
            if UserInputService:IsKeyDown(Enum.KeyCode.D) then dir = dir + Vector3.new(right.X, 0, right.Z).Unit end
            if UserInputService:IsKeyDown(Enum.KeyCode.Space) then dir = dir + Vector3.new(0, 1, 0) end
            if UserInputService:IsKeyDown(Enum.KeyCode.LeftShift) then dir = dir - Vector3.new(0, 1, 0) end
            if dir.Magnitude > 0 then
                local currentWalkSpeed = math.max(tonumber(findHum().WalkSpeed) or 16, 0.1)
                hrp.CFrame = hrp.CFrame + dir.Unit * currentWalkSpeed * math.min(dt, 0.1)
            end
            bodyGyro.CFrame = CFrame.lookAt(hrp.Position, hrp.Position + look)
        end))
    }
end

local function stopFly()
    flying = false
    local f = HUB._fly
    if f then
        pcall(function() f.conn:Disconnect() end)
        pcall(function() f.hrp.Anchored = false end)
        pcall(function() f.gyro:Destroy() end)
        HUB._fly = nil
    end
end

local function SetFlyPoint()
    local hrp = findHRP()
    if not hrp then Notify("Fly Point", "Không tìm thấy nhân vật", "Error") return end
    savedFlyPoint = hrp.CFrame
    Notify("Fly Point", "Đã đặt điểm bay", "Success")
end

local function FlyBackToPoint()
    if returningToFlyPoint then return end
    if not savedFlyPoint then Notify("Fly Point", "Chưa đặt điểm bay", "Error") return end
    local hrp = findHRP()
    if not hrp then return end
    returningToFlyPoint = true
    Notify("Fly Point", "Đang bay về điểm đã đặt...", "Info")
    task.spawn(function()
        FlyToPoint(savedFlyPoint.Position, 200, true)
        local h = findHRP()
        if h then h.CFrame = savedFlyPoint end
        Notify("Fly Point", "Đã về điểm bay", "Success")
        returningToFlyPoint = false
    end)
end

