------------------------------------------------------------

local function dynamic(text)

    local lower = text:lower()
    local n

    n = lower:match("^level:%s*(.+)$")
    if n then
        return "Cấp: " .. text:sub(#text - #n + 1)
    end

    n = lower:match("^speed:%s*(.+)$")
    if n then
        return "Tốc độ: " .. text:sub(#text - #n + 1)
    end

    n = lower:match("^distance:%s*(.+)$")
    if n then
        return "Khoảng cách: " .. text:sub(#text - #n + 1)
    end

    n = lower:match("^health:%s*(.+)$")
    if n then
        return "Máu: " .. text:sub(#text - #n + 1)
    end

    n = lower:match("^damage:%s*(.+)$")
    if n then
        return "Sát thương: " .. text:sub(#text - #n + 1)
    end

    n = lower:match("^luck:%s*(.+)$")
    if n then
        return "May mắn: " .. text:sub(#text - #n + 1)
    end

    n = lower:match("^progress:%s*(.+)$")
    if n then
        return "Tiến trình: " .. text:sub(#text - #n + 1)
    end

    n = lower:match("^cooldown:%s*(.+)$")
    if n then
        return "Hồi chiêu: " .. text:sub(#text - #n + 1)
    end

    n = lower:match("^players:%s*(.+)$")
    if n then
        return "Người chơi: " .. text:sub(#text - #n + 1)
    end

    n = lower:match("^you need%s+(.+)$")
    if n then
        return "Bạn cần " .. text:sub(#text - #n + 1)
    end

    n = lower:match("^you have%s+(.+)$")
    if n then
        return "Bạn có " .. text:sub(#text - #n + 1)
    end

    n = lower:match("^you got%s+(.+)$")
    if n then
        return "Bạn nhận được " .. text:sub(#text - #n + 1)
    end

    n = lower:match("^you received%s+(.+)$")
    if n then
        return "Bạn nhận được " .. text:sub(#text - #n + 1)
    end

    return nil
end

------------------------------------------------------------
-- FAST TRANSLATOR
------------------------------------------------------------

local function fastTranslate(text)

    if type(text) ~= "string" then
        return text
    end

    if text == "" then
        return text
    end

    if #text > CFG.MaxLength then
        return text
    end

    local lower = text:lower()

    if lower:find("https://",1,true)
        or lower:find("http://",1,true)
        or lower:find("www.",1,true)
        or lower:find("loadstring",1,true)
        or lower:find("getgenv",1,true)
        or lower:find("rbxassetid://",1,true)
        or lower:find("game:httpget",1,true)
    then
        return text
    end

    local cached = Cache[text]

    if cached then
        Stats.CacheHits += 1
        return cached
    end

    local exact = Dictionary[lower]

    if exact then
        Cache[text] = exact
        Stats.Translated += 1
        return exact
    end

    local dyn = dynamic(text)

    if dyn then
        Cache[text] = dyn
        Stats.Translated += 1
        return dyn
    end

    local result = text
    local changed = false

    for _, key in ipairs(SortedKeys) do

        if result:lower():find(key,1,true) then

            local value = Dictionary[key]

            local escaped =
                key:gsub("([^%w%s])","%%%1")

            local pattern =
                "%f[%a]"
                .. escaped
                .. "%f[^%a]"

            local before = result

            result = result:gsub(
                pattern,
                value
            )

            if result ~= before then
                changed = true
            end
        end
    end

    Cache[text] = result

    if changed then
        Stats.Translated += 1
    end

    return result
end

------------------------------------------------------------
-- RICHTEXT
------------------------------------------------------------

local function translateRichText(text)

    if not CFG.RichText then
        return fastTranslate(text)
    end

    if not text:find("<",1,true) then
        return fastTranslate(text)
    end

    local result = ""
    local pos = 1

    while true do

        local s,e =
            text:find("<[^>]->",pos)

        if not s then

            result =
                result
                .. fastTranslate(
                    text:sub(pos)
                )

            break
        end

        result =
            result
            .. fastTranslate(
                text:sub(pos,s-1)
            )
            .. text:sub(s,e)

        pos = e + 1
    end

    return result
end

------------------------------------------------------------
-- TEXT CHECK
------------------------------------------------------------

local function isText(obj)

    return obj:IsA("TextLabel")
        or obj:IsA("TextButton")
        or obj:IsA("TextBox")

end

------------------------------------------------------------
-- APPLY TEXT
------------------------------------------------------------

local function fastApply(obj)

    if not obj or not obj.Parent then
        return
    end

    if not isText(obj) then
        return
    end

    if obj:IsA("TextBox")
        and not CFG.TranslateTextBox
    then
        return
    end

    if Busy[obj] then
        return
    end

    local source = obj.Text

    if type(source) ~= "string" then
        return
    end

    if LastTranslated[obj] == source then
        return
    end

    if LastSource[obj] ~= source then

        Original[obj] = source
        LastSource[obj] = source

    end

    if not Enabled then
        return
    end

    Busy[obj] = true

    local result =
        translateRichText(source)

    if result ~= source then

        pcall(function()
            obj.Text = result
        end)

        LastTranslated[obj] = result

    else

        LastTranslated[obj] = source

    end

    Busy[obj] = nil
end

------------------------------------------------------------
-- PLACEHOLDER
------------------------------------------------------------

local function applyPlaceholder(obj)

    if not CFG.TranslatePlaceholder then
        return
    end

    if not obj:IsA("TextBox") then
        return
    end

    local text = obj.PlaceholderText

    if not text or text == "" then
        return
    end

    if not PlaceholderOriginal[obj] then
        PlaceholderOriginal[obj] = text
    end

    if Enabled then

        local result =
            fastTranslate(text)

        if result ~= text then

            pcall(function()
                obj.PlaceholderText = result
            end)

        end

    else

        local original =
            PlaceholderOriginal[obj]

        if original then

            pcall(function()
                obj.PlaceholderText = original
            end)

        end
    end
end

------------------------------------------------------------
-- WATCH OBJECT
------------------------------------------------------------

local function watch(obj)

    if Watched[obj] then
        return
    end

    if not isText(obj) then
        return
    end

    Watched[obj] = true
    Stats.Watchers += 1

    task.defer(function()

        if Enabled then
            fastApply(obj)
            applyPlaceholder(obj)
        end

    end)

    obj:GetPropertyChangedSignal(
        "Text"
    ):Connect(function()

        if Busy[obj] then
            return
        end

        task.defer(function()

            if Enabled then
                fastApply(obj)
            end

        end)

    end)

    if obj:IsA("TextBox") then

        obj:GetPropertyChangedSignal(
            "PlaceholderText"
        ):Connect(function()

            task.defer(function()

                if Enabled then
                    applyPlaceholder(obj)
                end

            end)

        end)

    end
end

------------------------------------------------------------
-- ROOT WATCH
------------------------------------------------------------

local function watchRoot(root)

    if not root then
        return
    end

    if RootWatched[root] then
        return
    end

    RootWatched[root] = true

    root.DescendantAdded:Connect(function(obj)

        if not CFG.AutoDetect then
            return
        end

        if isText(obj) then

            task.defer(function()
                watch(obj)
            end)

        end

    end)
end

------------------------------------------------------------
-- SCAN
------------------------------------------------------------

local function scan(root)

    if not root then
        return 0
    end

    local count = 0

    pcall(function()

        for _, obj in ipairs(
            root:GetDescendants()
        ) do

            if isText(obj) then

                count += 1
                Stats.Scanned += 1

                watch(obj)

            end

        end

    end)

    return count
end

------------------------------------------------------------
-- FULL SCAN
------------------------------------------------------------

local function fullScan()

    if Scanning then
        return 0
    end

    Scanning = true

    Cache = {}

    local count = 0

    if CFG.PlayerGui and LP then

        local pg =
            LP:FindFirstChildOfClass(
                "PlayerGui"
            )

        if pg then

            watchRoot(pg)
            count += scan(pg)

        end
    end

    if CFG.CoreGui then

        pcall(function()

            watchRoot(CoreGui)
            count += scan(CoreGui)

        end)

    end

    if CFG.Workspace then

        pcall(function()

            watchRoot(workspace)
            count += scan(workspace)

        end)

    end

    Scanning = false

    return count
end

------------------------------------------------------------
-- RESTORE
------------------------------------------------------------

local function restore()

    local count = 0

    for obj, text in pairs(Original) do

        if typeof(obj) == "Instance"
            and obj.Parent
            and isText(obj)
        then

            pcall(function()

                Busy[obj] = true

                obj.Text = text

                LastSource[obj] = text
                LastTranslated[obj] = text

                Busy[obj] = nil

                count += 1

            end)

        end
    end

    for obj, text in pairs(
        PlaceholderOriginal
    ) do

        if typeof(obj) == "Instance"
            and obj.Parent
            and obj:IsA("TextBox")
        then

            pcall(function()
                obj.PlaceholderText = text
            end)

        end
    end

    return count
end

