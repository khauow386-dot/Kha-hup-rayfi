-- FPS
------------------------------------------------------------

local frames = 0
local lastFPS = os.clock()
local currentFPS = 60

RunService.RenderStepped:Connect(
    function()

        frames += 1

        local now = os.clock()

        if now - lastFPS >= 1 then

            currentFPS =
                frames
                / (now - lastFPS)

            frames = 0
            lastFPS = now

        end

    end
)

