local Generated = 0

local function giantAdd(key, value)
    key = tostring(key):lower()

    if not Dictionary[key] then
        Dictionary[key] = value
        Generated += 1
    end
end

-- ACTION + OBJECT

for _, a in ipairs(ACTIONS) do
    for _, o in ipairs(OBJECTS) do

        giantAdd(
            a[1] .. " " .. o[1],
            a[2] .. " " .. o[2]
        )

        giantAdd(
            a[1] .. " " .. o[1] .. " all",
            a[2] .. " tất cả " .. o[2]
        )

    end
end

-- MODIFIER + OBJECT

for _, m in ipairs(MODIFIERS) do
    for _, o in ipairs(OBJECTS) do

        giantAdd(
            m[1] .. " " .. o[1],
            m[2] .. " " .. o[2]
        )

    end
end

