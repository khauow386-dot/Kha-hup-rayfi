--========================================================--
-- SORT CỤM DÀI TRƯỚC
--========================================================--

local Keys = {}

for k in pairs(D) do
    table.insert(Keys, k)
end

table.sort(Keys, function(a,b)
    return #a > #b
end)

--========================================================--
-- CHUẨN HÓA
--========================================================--

local function normalize(s)
    s = tostring(s or "")
    s = s:gsub("%s+", " ")
    return s
end

--========================================================--
-- TRANSLATE
--========================================================--

local function translate(text)

    if not text or text == "" then
        return text
    end

    text = normalize(text)

    -- Đã có tiếng Việt
    if text:find("[ăâđêôơưĂÂĐÊÔƠƯ]") then
        return text
    end

    -- Exact match
    if D[text] then
        return D[text]
    end

    local result = text

    -- Cụm dài trước
    for _, english in ipairs(Keys) do

        local vietnamese = D[english]

        local escaped =
            english:gsub("([^%w%s])","%%%1")

        result = result:gsub(
            "(%f[%a])" ..
            escaped ..
            "(%f[%A])",
            function(a,b)
                return a .. vietnamese .. b
            end
        )
    end

    return result
end

--========================================================--
-- SAVE / RESTORE
--========================================================--

local function remember(obj, property, value)

    Original[obj] =
        Original[obj] or {}

    if Original[obj][property] == nil then
        Original[obj][property] = value
    end
end

local function restore()

    for obj, props in pairs(Original) do

        if obj and obj.Parent then

            for property, value in pairs(props) do

                pcall(function()
                    obj[property] = value
                end)

            end
        end
    end
end

--========================================================--
-- IS TEXT OBJECT
--========================================================--

local function isTextObject(obj)

    return obj:IsA("TextLabel")
        or obj:IsA("TextButton")
        or obj:IsA("TextBox")
end

--========================================================--
-- TRANSLATE OBJECT
--========================================================--

local function process(obj)

    if not obj or not obj.Parent then
        return
    end

    if Busy[obj] then
        return
    end

    if not isTextObject(obj) then
        return
    end

    Busy[obj] = true

    pcall(function()

        local text = obj.Text

        remember(
            obj,
            "Text",
            text
        )

        if ENABLED then

            local newText =
                translate(text)

            if newText ~= text then

                obj.Text = newText

            end
        end

        if obj:IsA("TextBox") then

            local placeholder =
                obj.PlaceholderText

            remember(
                obj,
                "PlaceholderText",
                placeholder
            )

            if ENABLED
                and placeholder ~= "" then

                local newPlaceholder =
                    translate(placeholder)

                if newPlaceholder
                    ~= placeholder then

                    obj.PlaceholderText =
                        newPlaceholder
                end
            end
        end

    end)

    Busy[obj] = nil
end

--========================================================--
-- SCAN ROOT
--========================================================--

local function scanRoot(root)

    if not root then
        return
    end

    pcall(function()

        for _, obj in ipairs(
            root:GetDescendants()
        ) do

            if isTextObject(obj) then
                process(obj)
            end

        end

    end)
end

--========================================================--
-- WATCH ROOT
--========================================================--

local function watchRoot(root)

    if not root then
        return
    end

    root.DescendantAdded:Connect(function(obj)

        task.defer(function()

            if isTextObject(obj) then
                process(obj)
            end

        end)

    end)

    scanRoot(root)
end

--========================================================--
-- WATCH TEXT
--========================================================--

local function watchText(obj)

    if not isTextObject(obj) then
        return
    end

    if Watched[obj] then
        return
    end

    Watched[obj] = true

    obj:GetPropertyChangedSignal(
        "Text"
    ):Connect(function()

        if not ENABLED then
            return
        end

        -- Không scan toàn bộ GUI.
        -- Chỉ xử lý object vừa thay đổi.
        task.defer(function()
            process(obj)
        end)

    end)

    if obj:IsA("TextBox") then

        obj:GetPropertyChangedSignal(
            "PlaceholderText"
        ):Connect(function()

            if ENABLED then
                task.defer(function()
                    process(obj)
                end)
            end

        end)

    end
end

--========================================================--
-- WATCH ALL TEXT OBJECTS
--========================================================--

local function watchExisting(root)

    if not root then
        return
    end

    for _, obj in ipairs(
        root:GetDescendants()
    ) do

        if isTextObject(obj) then
            watchText(obj)
        end

    end

    root.DescendantAdded:Connect(function(obj)

        if isTextObject(obj) then
            watchText(obj)
        end

    end)
end

