--========================================================--
-- FULL GLOBAL SCAN
--========================================================--

local function translateAll()

    if Translating then
        return
    end

    Translating = true
    Progress = 0

    local objects = {}
    local seen = {}

    -- PLAYER GUI
    collectRoot(
        PlayerGui,
        objects,
        seen
    )

    -- CORE GUI
    if SCAN_CORE_GUI then

        pcall(function()

            collectRoot(
                CoreGui,
                objects,
                seen
            )

        end)

    end

    -- WORLD GUI
    if SCAN_WORLD_GUI then

        pcall(function()

            for _,obj in ipairs(
                workspace:GetDescendants()
            ) do

                if obj:IsA("BillboardGui")
                    or obj:IsA("SurfaceGui") then

                    collectRoot(
                        obj,
                        objects,
                        seen
                    )

                end

            end

        end)

    end

    local total =
        #objects

    if total == 0 then

        updateButton(100)
        Translating = false

        return
    end

    local lastStep = 0

    for index,obj in ipairs(objects) do

        if not ENABLED then
            break
        end

        watchText(obj)
        process(obj)

        local percent =
            math.floor(
                index / total * 100
            )

        local step =
            math.floor(
                percent / 10
            ) * 10

        if step >= 10
            and step <= 100
            and step ~= lastStep then

            lastStep = step
            Progress = step

            updateButton(step)

            task.wait()

        end

    end

    if ENABLED then

        Progress = 100
        updateButton(100)

    end

    Translating = false

end

