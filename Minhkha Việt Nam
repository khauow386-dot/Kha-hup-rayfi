local function add(key, value)
    if type(key) ~= "string" then
        return
    end

    if type(value) ~= "string" then
        return
    end

    key = key:lower()

    if key == "" then
        return
    end

    Dictionary[key] = value
end

local function addTable(t)
    for k, v in pairs(t) do
        add(k, v)
    end
end

