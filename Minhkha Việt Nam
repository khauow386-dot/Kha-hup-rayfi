--========================================================--
-- SORT KEYS
--========================================================--

local Keys = {}

for key in pairs(D) do
    table.insert(Keys,key)
end

table.sort(Keys,function(a,b)
    return #a > #b
end)

--========================================================--
-- NORMALIZE
--========================================================--

local function normalize(text)

    text = tostring(text or "")
    text = text:gsub("%s+"," ")

    return text
end

--========================================================--
-- TRANSLATE TEXT
--========================================================--

local function translate(text)

    if not text or text == "" then
        return text
    end

    text = normalize(text)

    if D[text] then
        return D[text]
    end

    -- Không dịch lại chuỗi đã có ký tự tiếng Việt
    if text:find("[ăâđêôơưĂÂĐÊÔƠƯ]") then
        return text
    end

    local result = text

    for _,english in ipairs(Keys) do

        local vietnamese = D[english]

        local escaped =
            english:gsub(
                "([^%w%s])",
                "%%%1"
            )

        local pattern =
            "(%f[%a])"
            .. escaped ..
            "(%f[%A])"

        result =
            result:gsub(
                pattern,
                function(a,b)
                    return a ..
                        vietnamese ..
                        b
                end
            )

    end

    return result
end

--========================================================--
-- TEXT CHECK
--========================================================--

local function isTextObject(obj)

    return obj:IsA("TextLabel")
        or obj:IsA("TextButton")
        or obj:IsA("TextBox")

end

--========================================================--
-- SAVE ORIGINAL
--========================================================--

local function remember(
    obj,
    property,
    value
)

    Original[obj] =
        Original[obj] or {}

    if Original[obj][property] == nil then

        Original[obj][property] =
            value

    end

end

--========================================================--
-- PROCESS
--========================================================--

local function process(obj)

    if not obj
        or not obj.Parent
        or Busy[obj]
        or not isTextObject(obj) then

        return
    end

    Busy[obj] = true

    pcall(function()

        local text = obj.Text

        remember(
            obj,
            "Text",
            text
        )

        if ENABLED then

            local newText =
                translate(text)

            if newText ~= text then
                obj.Text = newText
            end

        end

        if obj:IsA("TextBox") then

            local placeholder =
                obj.PlaceholderText

            remember(
                obj,
                "PlaceholderText",
                placeholder
            )

            if ENABLED
                and placeholder ~= "" then

                local newPlaceholder =
                    translate(placeholder)

                if newPlaceholder
                    ~= placeholder then

                    obj.PlaceholderText =
                        newPlaceholder

                end

            end

        end

    end)

    Busy[obj] = nil

end

--========================================================--
-- RESTORE
--========================================================--

local function restore()

    for obj,properties in pairs(Original) do

        if obj and obj.Parent then

            for property,value
                in pairs(properties) do

                pcall(function()
                    obj[property] = value
                end)

            end

        end

    end

end

--========================================================--
-- WATCH TEXT
--========================================================--

local function watchText(obj)

    if not isTextObject(obj)
        or Watched[obj] then

        return
    end

    Watched[obj] = true

    obj:GetPropertyChangedSignal(
        "Text"
    ):Connect(function()

        if not ENABLED then
            return
        end

        task.defer(function()

            if obj.Parent then
                process(obj)
            end

        end)

    end)

    if obj:IsA("TextBox") then

        obj:GetPropertyChangedSignal(
            "PlaceholderText"
        ):Connect(function()

            if not ENABLED then
                return
            end

            task.defer(function()

                if obj.Parent then
                    process(obj)
                end

            end)

        end)

    end

end

--========================================================--
-- WATCH ROOT
--========================================================--

local function watchRoot(root)

    if not root
        or WatchedRoots[root] then

        return
    end

    WatchedRoots[root] = true

    pcall(function()

        for _,obj in ipairs(
            root:GetDescendants()
        ) do

            if isTextObject(obj) then
                watchText(obj)
            end

        end

        root.DescendantAdded:Connect(
            function(obj)

                if isTextObject(obj) then

                    watchText(obj)

                    if ENABLED then

                        task.defer(function()
                            process(obj)
                        end)

                    end

                end

            end
        )

    end)

end

--========================================================--
-- COLLECT TEXT OBJECTS
--========================================================--

local function collectRoot(
    root,
    list,
    seen
)

    if not root then
        return
    end

    pcall(function()

        if isTextObject(root)
            and not seen[root] then

            seen[root] = true
            table.insert(list,root)

        end

        for _,obj in ipairs(
            root:GetDescendants()
        ) do

            if isTextObject(obj)
                and not seen[obj] then

                seen[obj] = true
                table.insert(list,obj)

            end

        end

    end)

end

