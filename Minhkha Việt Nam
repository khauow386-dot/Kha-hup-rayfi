                giantAdd(
                    a[1] .. " " .. m[1] .. " " .. o[1],
                    a[2] .. " " .. m[2] .. " " .. o[2]
                )

            end

            if Generated >= 7500 then
                break
            end

        end

        if Generated >= 7500 then
            break
        end
    end

    if Generated >= 7500 then
        break
    end
end

