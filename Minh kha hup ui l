        local function SetColor(
            NewColor,
            CallCallback
        )

            if typeof(NewColor)
                ~= "Color3"
            then
                return
            end

            Color =
                NewColor

            ColorButton.BackgroundColor3 =
                Color

            -- Color3 không được JSON encode
            -- trực tiếp nên lưu RGB.
            Config.Colors[Key] = {
                R = math.floor(
                    Color.R * 255
                ),

                G = math.floor(
                    Color.G * 255
                ),

                B = math.floor(
                    Color.B * 255
                )
            }

            SaveConfig()

            if CallCallback then

                SafeCallback(
                    Callback,
                    Color
                )

            end

        end

        ColorButton.MouseButton1Click:Connect(
            function()

                -- Bộ màu nhanh
                local Colors = {
                    Color3.fromRGB(
                        220,
                        25,
                        45
                    ),

                    Color3.fromRGB(
                        30,
                        200,
                        80
                    ),

                    Color3.fromRGB(
                        40,
                        130,
                        255
                    ),

                    Color3.fromRGB(
                        180,
                        60,
                        255
                    ),

                    Color3.fromRGB(
                        255,
                        180,
                        30
                    ),

                    Color3.fromRGB(
                        255,
                        255,
                        255
                    )
                }

                local Current = 1

                local BestDistance =
                    math.huge

                for Index, C in ipairs(
                    Colors
                ) do

                    local Distance =
                        (
                            C.R - Color.R
                        ) ^ 2
                        +
                        (
                            C.G - Color.G
                        ) ^ 2
                        +
                        (
                            C.B - Color.B
                        ) ^ 2

                    if Distance <
                        BestDistance
                    then

                        BestDistance =
                            Distance

                        Current =
                            Index

                    end

                end

                Current =
                    Current
                    % #Colors
                    + 1

                SetColor(
                    Colors[Current],
                    true
                )

            end
        )

        -- Load RGB
        local Saved =
            Config.Colors[Key]

        if type(Saved) == "table" then

            if
                Saved.R
                and Saved.G
                and Saved.B
            then

                Color =
                    Color3.fromRGB(
                        Saved.R,
                        Saved.G,
                        Saved.B
                    )

                ColorButton.BackgroundColor3 =
                    Color

            end

        end

        local Object = {}

        function Object:Set(NewColor)

            SetColor(
                NewColor,
                true
            )

        end

        function Object:Get()

            return Color

        end

        return Object

    end

