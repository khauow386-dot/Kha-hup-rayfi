        section.TextColor3 = Theme.BorderColor
        section.TextSize = 12
        section.Font = Enum.Font.GothamBold
        section.TextXAlignment = Enum.TextXAlignment.Left

        return section
    end

    return TabFunctions
end

--============================================================
-- THEME API
--============================================================

function Library:SetTheme(color)

    if typeof(color) ~= "Color3" then
        return
    end

    Theme.BorderColor = color

    for _, obj in ipairs(Gui:GetDescendants()) do

        if obj:IsA("UIStroke") then
            obj.Color = Theme.BorderColor
        end

    end

    for _, tab in pairs(Tabs) do
        if tab.BackgroundTransparency <= 0.06 then
            tab.BackgroundColor3 = Theme.BorderColor
        end
    end

    Save()
end

--============================================================
-- TRANSPARENCY API
--============================================================

function Library:SetTransparency(value)

    value = tonumber(value)

    if not value then
        return
    end

    value = math.clamp(value, 0, 0.95)

    Theme.GlassTransparency = value
    Main.BackgroundTransparency = value

    SavedData.GlassTransparency = value

    Save()
end

--============================================================
-- SHOW / HIDE API
--============================================================

function Library:SetVisible(value)

    Main.Visible = value == true

    SavedData.MainVisible = Main.Visible

    Save()
end

function Library:Toggle()

    Main.Visible = not Main.Visible

    SavedData.MainVisible = Main.Visible

    Save()
end

--============================================================
-- DESTROY API
--============================================================

function Library:Destroy()

    Save()

    pcall(function()
        Gui:Destroy()
    end)
end

