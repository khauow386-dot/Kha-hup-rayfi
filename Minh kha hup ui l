local Dragging = false
local DragStart
local StartPos

Top.InputBegan:Connect(function(Input)

    if
        Input.UserInputType ==
            Enum.UserInputType.MouseButton1
        or
        Input.UserInputType ==
            Enum.UserInputType.Touch
    then

        Dragging = true

        DragStart =
            Input.Position

        StartPos =
            Main.Position

    end

end)

UserInputService.InputChanged:Connect(function(Input)

    if not Dragging then
        return
    end

    if
        Input.UserInputType ==
            Enum.UserInputType.MouseMovement
        or
        Input.UserInputType ==
            Enum.UserInputType.Touch
    then

        local Delta =
            Input.Position - DragStart

        Main.Position =
            UDim2.new(
                StartPos.X.Scale,
                StartPos.X.Offset + Delta.X,
                StartPos.Y.Scale,
                StartPos.Y.Offset + Delta.Y
            )

    end

end)

UserInputService.InputEnded:Connect(function(Input)

    if
        Input.UserInputType ==
            Enum.UserInputType.MouseButton1
        or
        Input.UserInputType ==
            Enum.UserInputType.Touch
    then

        if Dragging then

            Config.UI.MainXScale =
                Main.Position.X.Scale

            Config.UI.MainXOffset =
                Main.Position.X.Offset

            Config.UI.MainYScale =
                Main.Position.Y.Scale

            Config.UI.MainYOffset =
                Main.Position.Y.Offset

            SaveConfig()

        end

        Dragging = false

    end

end)

