    --========================================================

    function TabFunctions:CreateButton(text, callback)

        componentIndex += 1

        local btn = Instance.new("TextButton")
        btn.Name = "Button_" .. componentIndex
        btn.Parent = page
        btn.Size = UDim2.new(1, -4, 0, 42)
        btn.BackgroundColor3 = Color3.fromRGB(27, 27, 34)
        btn.BackgroundTransparency = 0.18
        btn.BorderSizePixel = 0
        btn.Text = tostring(text)
        btn.TextColor3 = Color3.fromRGB(245, 245, 245)
        btn.TextSize = 11
        btn.Font = Enum.Font.GothamBold
        btn.AutoButtonColor = false

        Corner(btn, 10)
        Stroke(btn)

        btn.Activated:Connect(function()
            SafeCall(callback)
        end)

        Components[#Components + 1] = {
            Type = "Button",
            Object = btn,
            Text = text,
        }

        return btn
    end

    --========================================================
    -- TOGGLE
    --========================================================

    function TabFunctions:CreateToggle(text, default, callback)

        componentIndex += 1

        local key =
            "Toggle_" ..
            tabName ..
            "_" ..
            tostring(text)

        local enabled

        if SavedData.Toggles
            and SavedData.Toggles[key] ~= nil
        then
            enabled = SavedData.Toggles[key]
        else
            enabled = default == true
        end

        local row = Instance.new("Frame")
        row.Name = "Toggle_" .. componentIndex
        row.Parent = page
        row.Size = UDim2.new(1, -4, 0, 42)
        row.BackgroundColor3 = Color3.fromRGB(27, 27, 34)
        row.BackgroundTransparency = 0.18
        row.BorderSizePixel = 0

        Corner(row, 10)
        Stroke(row)

        local label = Instance.new("TextLabel")
        label.Parent = row
        label.Size = UDim2.new(1, -55, 1, 0)
        label.Position = UDim2.new(0, 12, 0, 0)
        label.BackgroundTransparency = 1
        label.Font = Enum.Font.GothamSemibold
        label.TextSize = 11
        label.TextColor3 = Color3.fromRGB(245, 245, 245)
        label.TextXAlignment = Enum.TextXAlignment.Left

        local toggleBtn = Instance.new("TextButton")
        toggleBtn.Parent = row
        toggleBtn.Size = UDim2.new(0, 36, 0, 20)
        toggleBtn.Position = UDim2.new(1, -44, 0.5, -10)
        toggleBtn.Text = ""
        toggleBtn.BorderSizePixel = 0
        toggleBtn.AutoButtonColor = false

        Corner(toggleBtn, 10)

        local function Update(callCallback)

            label.Text =
                tostring(text)
                .. "  ["
                .. (enabled and "ON" or "OFF")
                .. "]"

            if enabled then
                toggleBtn.BackgroundColor3 = Theme.BorderColor
            else
                toggleBtn.BackgroundColor3 =
                    Color3.fromRGB(43, 43, 51)
            end

            SavedData.Toggles = SavedData.Toggles or {}
            SavedData.Toggles[key] = enabled

            Save()

            if callCallback then
                SafeCall(callback, enabled)
            end
        end

        toggleBtn.Activated:Connect(function()

            enabled = not enabled

            Update(true)

        end)

        Update(true)

        local ToggleObject = {}

        function ToggleObject:Set(value)

            enabled = value == true

            Update(true)

        end

        function ToggleObject:Get()

            return enabled

        end

        Components[#Components + 1] = {
            Type = "Toggle",
            Object = row,
            Key = key,
            API = ToggleObject,
        }

        return ToggleObject
    end

    --========================================================
    -- INPUT
    --========================================================

    function TabFunctions:CreateInput(text, default, callback)

        componentIndex += 1

        local key =
            "Input_" ..
            tabName ..
            "_" ..
            tostring(text)

        local savedValue =
            SavedData.Inputs
            and SavedData.Inputs[key]

        if savedValue == nil then
            savedValue = default
        end

        local holder = Instance.new("Frame")
        holder.Name = "Input_" .. componentIndex
        holder.Parent = page
        holder.Size = UDim2.new(1, -4, 0, 45)
        holder.BackgroundColor3 = Color3.fromRGB(27, 27, 34)
        holder.BackgroundTransparency = 0.18
        holder.BorderSizePixel = 0

        Corner(holder, 10)
        Stroke(holder)

        local label = Instance.new("TextLabel")
        label.Parent = holder
        label.Size = UDim2.new(0.35, 0, 1, 0)
        label.Position = UDim2.new(0, 10, 0, 0)
        label.BackgroundTransparency = 1
        label.Text = tostring(text)
        label.TextColor3 = Color3.fromRGB(245, 245, 245)
        label.TextSize = 11
        label.Font = Enum.Font.GothamBold
        label.TextXAlignment = Enum.TextXAlignment.Left

        local box = Instance.new("TextBox")
        box.Parent = holder
        box.Position = UDim2.new(0.4, 0, 0.15, 0)
        box.Size = UDim2.new(0.57, 0, 0.7, 0)
        box.BackgroundColor3 = Color3.fromRGB(12, 12, 16)
        box.BorderSizePixel = 0
        box.Text = tostring(savedValue or "")
        box.TextColor3 = Color3.fromRGB(245, 245, 245)
        box.TextSize = 11
        box.Font = Enum.Font.Gotham
        box.ClearTextOnFocus = false

        Corner(box, 7)

        box.FocusLost:Connect(function()

            local value = tonumber(box.Text)

            if value ~= nil then

                SavedData.Inputs = SavedData.Inputs or {}
                SavedData.Inputs[key] = value

                Save()

                SafeCall(callback, value)
            end

        end)

        Components[#Components + 1] = {
            Type = "Input",
            Object = holder,
            Key = key,
        }

        return box
    end

    --========================================================
    -- LABEL
    --========================================================

    function TabFunctions:CreateLabel(text)

        local label = Instance.new("TextLabel")
        label.Parent = page
        label.Size = UDim2.new(1, -4, 0, 32)
        label.BackgroundTransparency = 1
        label.Text = tostring(text)
        label.TextColor3 = Color3.fromRGB(200, 200, 210)
        label.TextSize = 11
        label.Font = Enum.Font.Gotham
        label.TextWrapped = true
