        return label
    end

    --========================================================
    -- SECTION
    --========================================================

    function TabFunctions:CreateSection(text)

        local section = Instance.new("TextLabel")
        section.Parent = page
        section.Size = UDim2.new(1, -4, 0, 28)
        section.BackgroundTransparency = 1
