                .. "]"

        end

        local function CloseList()

            Open = false

            if List then

                List:Destroy()

                List = nil

            end

        end

        local function Choose(Value)

            Selected =
                Value

            Config.Dropdowns[Key] =
                Value

            UpdateText()

            SaveConfig()

            CloseList()

            SafeCallback(
                Callback,
                Value
            )

        end

        local function OpenList()

            if Open then

                CloseList()

                return

            end

            Open = true

            List =
                Instance.new("ScrollingFrame")

            List.Parent = Gui

            List.Size =
                UDim2.new(
                    0,
                    math.max(
                        Holder.AbsoluteSize.X,
                        180
                    ),
                    0,
                    math.min(
                        #Options * 32,
                        160
                    )
                )

            List.Position =
                UDim2.new(
                    0,
                    Holder.AbsolutePosition.X,
                    0,
                    Holder.AbsolutePosition.Y
                    + Holder.AbsoluteSize.Y
                    + 3
                )

            List.BackgroundColor3 =
                Color3.fromRGB(
                    12,
                    12,
                    16
                )

            List.BorderSizePixel = 0

            List.ScrollBarThickness = 2

            List.ZIndex = 500

            Corner(List, 8)

            Stroke(List)

            local Layout =
                Instance.new(
                    "UIListLayout"
                )

            Layout.Parent = List

            for _, Option in ipairs(
                Options
