FloatBar.MouseButton1Click:Connect(
    function()

        if FloatMoved then

            FloatMoved = false

            return

        end

        Main.Visible =
            not Main.Visible

        Config.UI.MainVisible =
            Main.Visible

        SaveConfig()

    end
)

--========================================================
-- LIBRARY FUNCTIONS
--========================================================

function Library:SaveConfig()

    SaveConfig()

end

function Library:ResetConfig()

    ResetConfig()

end

function Library:GetConfig()

    return Config

end

function Library:GetFileSaveStatus()

    return FileAPI.Available

end

function Library:SetThemeColor(
    Color
)

    if typeof(Color)
        ~= "Color3"
    then
        return
    end

    Theme.BorderColor =
        Color

    for _, Object in ipairs(
        Gui:GetDescendants()
    ) do

        if
            Object:IsA("UIStroke")
            and
            Object.Name ==
                "DynamicBorder"
        then

            Object.Color =
                Color

        end

    end

end

function Library:SetTransparency(
    Value
)

    Value =
        tonumber(Value)

    if not Value then
        return
    end

    Value =
        math.clamp(
            Value,
            0,
            1
        )

    Theme.GlassTransparency =
        Value

    Main.BackgroundTransparency =
        Value

    SaveConfig()

end

function Library:SetVisibility(
    Visible
)

    Main.Visible =
        Visible == true

    Config.UI.MainVisible =
        Main.Visible

    SaveConfig()

end

function Library:GetVisibility()

    return Main.Visible

end

