    -- Supports:
    -- CreateSlider(Text, Min, Max, Default, Callback)
    --====================================================

    function TabFunctions:CreateSlider(
        Text,
        Minimum,
        Maximum,
        Default,
        Callback
    )

        Minimum =
            tonumber(Minimum)
            or 0

        Maximum =
            tonumber(Maximum)
            or 100

        Default =
            tonumber(Default)
            or Minimum

        if Maximum < Minimum then
            Minimum, Maximum =
                Maximum, Minimum
        end

        local Key =
            ComponentKey(
                TabName,
                Text
            )

        local Value =
            tonumber(
                Config.Sliders[Key]
            )

        if Value == nil then
            Value = Default
        end

        Value =
            math.clamp(
                Value,
                Minimum,
                Maximum
            )

        local Holder =
            Instance.new("Frame")

        Holder.Parent = Page

        Holder.Size =
            UDim2.new(
                1,
                -4,
                0,
                58
            )

        Holder.BackgroundColor3 =
            Color3.fromRGB(
                27,
                27,
                34
            )

        Holder.BackgroundTransparency =
            0.18

        Holder.BorderSizePixel = 0

        Corner(Holder, 10)

        Stroke(
            Holder,
            Color3.fromRGB(
                55,
                55,
                65
            ),
            1,
            0
        )

        local Label =
            Instance.new("TextLabel")

        Label.Parent = Holder

        Label.Position =
            UDim2.new(
                0,
                10,
                0,
                5
            )

        Label.Size =
            UDim2.new(
                1,
                -20,
                0,
                18
            )

        Label.BackgroundTransparency = 1

        Label.TextColor3 =
            Color3.fromRGB(
                245,
                245,
                245
            )

        Label.TextSize = 11

        Label.Font =
            Enum.Font.GothamBold

        Label.TextXAlignment =
            Enum.TextXAlignment.Left

        local Bar =
            Instance.new("Frame")

        Bar.Parent = Holder

        Bar.Position =
            UDim2.new(
                0,
                10,
                0,
                33
            )

        Bar.Size =
            UDim2.new(
                1,
                -20,
                0,
                8
            )

        Bar.BackgroundColor3 =
            Color3.fromRGB(
                45,
                45,
                53
            )

        Bar.BorderSizePixel = 0

        Corner(Bar, 6)

        local Fill =
            Instance.new("Frame")

        Fill.Parent = Bar

        Fill.Size =
            UDim2.new(
                0,
                0,
                1,
                0
            )

        Fill.BackgroundColor3 =
            Theme.BorderColor

        Fill.BorderSizePixel = 0

        Corner(Fill, 6)

        local function SetValue(
            NewValue,
            CallCallback
        )

            NewValue =
                tonumber(NewValue)

            if not NewValue then
                return
            end

            NewValue =
                math.clamp(
                    NewValue,
                    Minimum,
                    Maximum
                )

            Value =
                NewValue

            Config.Sliders[Key] =
                Value

            local Alpha =
                (Value - Minimum)
                /
                math.max(
                    Maximum - Minimum,
                    0.0001
                )

            Fill.Size =
                UDim2.new(
                    Alpha,
                    0,
                    1,
                    0
                )

            Label.Text =
                tostring(Text)
                .. "  ["
                .. tostring(
                    math.floor(
                        Value + 0.5
                    )
                )
                .. "]"

            SaveConfig()

            if CallCallback then

                SafeCallback(
                    Callback,
                    Value
                )

            end

        end

        local Sliding = false

        local function UpdateFromInput(
            Input
        )

            local Relative =
                Input.Position.X
                - Bar.AbsolutePosition.X

            local Alpha =
                math.clamp(
                    Relative
                    /
                    Bar.AbsoluteSize.X,
                    0,
                    1
                )

            local NewValue =
                Minimum
                +
                (
                    Maximum
                    - Minimum
                )
                * Alpha

            SetValue(
                NewValue,
                true
            )

        end

        Bar.InputBegan:Connect(
            function(Input)

                if
                    Input.UserInputType ==
                        Enum.UserInputType.MouseButton1
                    or
                    Input.UserInputType ==
                        Enum.UserInputType.Touch
                then

                    Sliding = true

                    UpdateFromInput(
                        Input
                    )

                end

            end
        )

        UserInputService.InputChanged:Connect(
            function(Input)

                if not Sliding then
                    return
                end

                if
                    Input.UserInputType ==
                        Enum.UserInputType.MouseMovement
                    or
                    Input.UserInputType ==
                        Enum.UserInputType.Touch
                then

                    UpdateFromInput(
                        Input
                    )

                end

            end
        )

        UserInputService.InputEnded:Connect(
            function(Input)

                if
                    Input.UserInputType ==
                        Enum.UserInputType.MouseButton1
                    or
                    Input.UserInputType ==
                        Enum.UserInputType.Touch
                then

                    Sliding = false

                end

            end
        )

        SetValue(
            Value,
            false
        )

        if Config.Sliders[Key] ~= nil then

            task.defer(
                function()

                    SafeCallback(
                        Callback,
                        Value
                    )

                end
            )

        end

        local Object = {}

        function Object:Set(NewValue)

            SetValue(
                NewValue,
                true
            )

        end

        function Object:Get()

            return Value

        end

        return Object

    end

