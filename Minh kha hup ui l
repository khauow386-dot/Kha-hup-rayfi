local function SafeCallback(Callback, ...)

    if typeof(Callback) ~= "function" then
        return
    end

    task.spawn(function(...)

        pcall(Callback, ...)

    end, ...)

end

local function Corner(Object, Radius)

    local C = Instance.new("UICorner")

    C.CornerRadius = UDim.new(0, Radius or 10)

    C.Parent = Object

    return C

end

local function Stroke(
    Object,
    Color,
    Thickness,
    Transparency
)

    local S = Instance.new("UIStroke")

    S.Name = "DynamicBorder"

    S.Color = Color or Theme.BorderColor

    S.Thickness =
        Thickness or Theme.BorderThickness

    S.Transparency =
        Transparency ~= nil
        and Transparency
        or Theme.BorderTransparency

    S.Parent = Object

    return S

end

local function SafeName(Text)

    Text = tostring(Text or "Item")

    Text = Text:gsub(
        "[^%w_%- ]",
        ""
    )

    Text = Text:gsub(
        "%s+",
        "_"
    )

    if Text == "" then
        Text = "Item"
    end

    return Text

end

local function ComponentKey(
    TabName,
    ComponentName
)

    return tostring(TabName)
        .. "::"
        .. tostring(ComponentName)

end

