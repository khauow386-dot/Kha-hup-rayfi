--========================================================
-- LOAD CONFIG
--========================================================

local function LoadConfig()

    if not FileAPI.Available then
        return
    end

    pcall(function()

        if not isfile(ConfigFile) then
            return
        end

        local Raw = readfile(ConfigFile)

        if not Raw or Raw == "" then
            return
        end

        local Data = HttpService:JSONDecode(Raw)

        if type(Data) ~= "table" then
            return
        end

        for Name, Value in pairs(Data) do

            if type(Value) == "table" then

                if Name == "Toggles" then
                    Config.Toggles = Value

                elseif Name == "Inputs" then
                    Config.Inputs = Value

                elseif Name == "Sliders" then
                    Config.Sliders = Value

                elseif Name == "Dropdowns" then
                    Config.Dropdowns = Value

                elseif Name == "Keybinds" then
                    Config.Keybinds = Value

                elseif Name == "Colors" then
                    Config.Colors = Value

                elseif Name == "UI" then

                    for K, V in pairs(Value) do
                        Config.UI[K] = V
                    end

                end

            end

        end

    end)

end

LoadConfig()

--========================================================
-- SAVE CONFIG
--========================================================

local SaveQueued = false

local function SaveConfig()

    if not FileAPI.Available then
        return
    end

    if SaveQueued then
        return
    end

    SaveQueued = true

    task.delay(0.12, function()

        SaveQueued = false

        pcall(function()

            if not isfolder(ConfigFolder) then
                makefolder(ConfigFolder)
            end

            local Encoded = HttpService:JSONEncode(Config)

            writefile(ConfigFile, Encoded)

        end)

    end)

end

