--============================================================
-- SAFE PERSISTENCE
--============================================================

local CanFileSave =
    typeof(isfile) == "function"
    and typeof(readfile) == "function"
    and typeof(writefile) == "function"

local function LoadSettings()
    if not CanFileSave then
        return {}
    end

    local ok, result = pcall(function()
        if not isfile(SettingsFile) then
            return {}
        end

        local content = readfile(SettingsFile)

        if not content or content == "" then
            return {}
        end

        return HttpService:JSONDecode(content)
    end)

    if ok and type(result) == "table" then
        return result
    end

    return {}
end

local function SaveSettings()
    if not CanFileSave then
        return
    end

    pcall(function()
        writefile(
            SettingsFile,
            HttpService:JSONEncode(SavedData)
        )
    end)
end

SavedData = LoadSettings()

--============================================================
-- HELPERS
--============================================================

local function Corner(obj, radius)
    local c = Instance.new("UICorner")
    c.CornerRadius = UDim.new(0, radius or 10)
    c.Parent = obj
    return c
end

local function Stroke(
    obj,
    color,
    thickness,
    transparency
)
    local s = obj:FindFirstChild("DynamicBorder")

    if not s then
        s = Instance.new("UIStroke")
        s.Name = "DynamicBorder"
        s.Parent = obj
    end

    s.Color = color or Theme.BorderColor
    s.Thickness = thickness or Theme.BorderThickness
    s.Transparency = transparency or Theme.BorderTransparency

    return s
end

local function SafeCall(callback, ...)
    if typeof(callback) ~= "function" then
        return
    end

    task.spawn(function()
        pcall(callback, ...)
    end)
end

local function Save()
    SaveSettings()
end

