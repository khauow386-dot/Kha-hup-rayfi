--============================================================

function Library:CreateTab(tabName)

    tabName = tostring(tabName or "Tab")

    -- tránh lỗi khi trùng tên tab
    local originalName = tabName
    local count = 2

    while Pages[tabName] do
        tabName = originalName .. " " .. count
        count += 1
    end

    local page = Instance.new("Frame")
    page.Name = tabName
    page.Parent = RightScroll
    page.Size = UDim2.new(1, -4, 0, 0)
    page.AutomaticSize = Enum.AutomaticSize.Y
    page.BackgroundTransparency = 1
    page.Visible = false

    local layout = Instance.new("UIListLayout")
    layout.Parent = page
    layout.Padding = UDim.new(0, 8)

    Pages[tabName] = page

    local tabBtn = Instance.new("TextButton")
    tabBtn.Name = "TabButton"
    tabBtn.Parent = MenuScroll
    tabBtn.Size = UDim2.new(1, -4, 0, 38)
    tabBtn.BackgroundColor3 = Color3.fromRGB(43, 43, 51)
    tabBtn.BackgroundTransparency = 0.25
    tabBtn.BorderSizePixel = 0
    tabBtn.Text = tabName
    tabBtn.TextColor3 = Color3.fromRGB(245, 245, 245)
    tabBtn.TextSize = 10
    tabBtn.Font = Enum.Font.GothamSemibold
    tabBtn.AutoButtonColor = false

    Corner(tabBtn, 9)
    Stroke(tabBtn)

    Tabs[tabName] = tabBtn

    local function SelectTab()

        currentTabName = tabName

        for pName, pObj in pairs(Pages) do
            pObj.Visible = pName == tabName
        end

        for tName, tObj in pairs(Tabs) do
            if tName == tabName then
                tObj.BackgroundColor3 = Theme.BorderColor
                tObj.BackgroundTransparency = 0.05
            else
                tObj.BackgroundColor3 = Color3.fromRGB(43, 43, 51)
                tObj.BackgroundTransparency = 0.25
            end
        end

        RightScroll.CanvasPosition = Vector2.new(0, 0)

        SavedData.SelectedTab = tabName
        Save()
    end

    tabBtn.Activated:Connect(SelectTab)

    if firstTab then
        firstTab = false
        SelectTab()
    elseif SavedData.SelectedTab == tabName then
        SelectTab()
    end

    --========================================================
    -- TAB API
    --========================================================

    local TabFunctions = {}

    --========================================================
