--============================================================
-- FPF DRAG
--============================================================

local fpfDragging = false
local fpfDragStart
local fpfStartPos
local fpfMoved = false

FPF.InputBegan:Connect(function(input)

    if
        input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch
    then

        fpfDragging = true
        fpfMoved = false
        fpfDragStart = input.Position
        fpfStartPos = FPF.Position

    end

end)

UserInputService.InputChanged:Connect(function(input)

    if
        fpfDragging
        and (
            input.UserInputType == Enum.UserInputType.MouseMovement
            or input.UserInputType == Enum.UserInputType.Touch
        )
    then

        local delta =
            input.Position - fpfDragStart

        if
            math.abs(delta.X) > 5
            or math.abs(delta.Y) > 5
        then
            fpfMoved = true
        end

        FPF.Position = UDim2.new(
            fpfStartPos.X.Scale,
            fpfStartPos.X.Offset + delta.X,
            fpfStartPos.Y.Scale,
            fpfStartPos.Y.Offset + delta.Y
        )

    end

end)

UserInputService.InputEnded:Connect(function(input)

    if
        input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch
    then

        if fpfDragging then

            SavedData.FPFPosition = {
                XScale = FPF.Position.X.Scale,
                XOffset = FPF.Position.X.Offset,
                YScale = FPF.Position.Y.Scale,
                YOffset = FPF.Position.Y.Offset,
            }

            Save()

        end

        fpfDragging = false

    end

end)

--============================================================
-- FPF CLICK = SHOW / HIDE MENU
--============================================================

FPF.Activated:Connect(function()

    if fpfMoved then
        fpfMoved = false
        return
    end

    Main.Visible = not Main.Visible

    SavedData.MainVisible = Main.Visible

    Save()

end)

--============================================================
-- FPS COUNTER
--============================================================

local FPS = 0
local frames = 0
local lastFPSUpdate = tick()

RunService.RenderStepped:Connect(function()

    frames += 1

    local now = tick()

    if now - lastFPSUpdate >= 0.5 then

        FPS = math.floor(
            frames / (now - lastFPSUpdate) + 0.5
        )

        frames = 0
        lastFPSUpdate = now

        FPF.Text = "FPF • " .. tostring(FPS) .. " FPS"

    end

end)

--============================================================
-- RESTORE SETTINGS
--============================================================

if SavedData.GlassTransparency ~= nil then

    local value =
        tonumber(SavedData.GlassTransparency)

    if value then

        value = math.clamp(value, 0, 0.95)

        Theme.GlassTransparency = value
        Main.BackgroundTransparency = value

    end

end

if SavedData.MainVisible ~= nil then
    Main.Visible = SavedData.MainVisible == true
else
    Main.Visible = true
end

