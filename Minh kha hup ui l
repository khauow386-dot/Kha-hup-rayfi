                        30,
                        30,
                        38
                    )

                OptionButton.BackgroundTransparency =
                    0.15

                OptionButton.BorderSizePixel = 0

                OptionButton.Text =
                    tostring(Option)

                OptionButton.TextColor3 =
                    Color3.fromRGB(
                        245,
                        245,
                        245
                    )

                OptionButton.TextSize = 10

                OptionButton.Font =
                    Enum.Font.Gotham

                OptionButton.AutoButtonColor =
                    false

                Corner(
                    OptionButton,
                    6
                )

                OptionButton.ZIndex =
                    501

                OptionButton.MouseButton1Click:Connect(
                    function()

                        Choose(
                            Option
                        )

                    end
                )

            end

            task.defer(
                function()

                    if List then

                        List.CanvasSize =
                            UDim2.new(
                                0,
                                0,
                                0,
                                Layout.AbsoluteContentSize.Y
                            )

                    end

                end
            )

        end

        Button.MouseButton1Click:Connect(
            OpenList
        )

        UpdateText()

        if Saved ~= nil then

            task.defer(
                function()

                    SafeCallback(
                        Callback,
                        Selected
                    )

                end
            )

        end

        local Object = {}

        function Object:Set(Value)

            Choose(Value)

        end

        function Object:Get()

            return Selected

        end

        function Object:Refresh(
            NewOptions
        )

            if type(NewOptions) ~= "table" then
                return
            end

            Options = NewOptions

            if not table.find(
                Options,
                Selected
            ) then

                Selected =
                    Options[1]

                Config.Dropdowns[Key] =
                    Selected

                SaveConfig()

                UpdateText()

            end

        end

        return Object

    end

