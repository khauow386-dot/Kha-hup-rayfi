-- ============================================================
-- GEF FUNCTIONS
-- ============================================================

local GEFKeywords = {

    "gef",
    "monster",
    "enemy",
    "zombie",
    "boss"

}


local function IsGEF(obj)

    if not obj then
        return false
    end


    if not obj:IsA("Model") then
        return false
    end


    if obj ==
        LocalPlayer.Character
    then

        return false

    end


    local name =
        string.lower(
            obj.Name
        )


    for _,keyword in ipairs(
        GEFKeywords
    ) do

        if string.find(
            name,
            keyword,
            1,
            true
        ) then

            return true

        end

    end


    return false

end


local function GetGEFRoot(gef)

    if not gef then
        return nil
    end


    return

        gef:FindFirstChild(
            "HumanoidRootPart"
        )

        or

        gef.PrimaryPart

        or

        gef:FindFirstChildWhichIsA(
            "BasePart",
            true
        )

end


local function GetGEFHumanoid(gef)

    if not gef then
        return nil
    end


    return
        gef:FindFirstChildOfClass(
            "Humanoid"
        )

end


local function GetAllGEFs()

    local result = {}


    for _,obj in ipairs(
        Workspace:GetDescendants()
    ) do

        if IsGEF(obj) then

            table.insert(
                result,
                obj
            )

        end

    end


    return result

end


local function GetGEFDistance(gef)

    local playerRoot =
        GetCharacterRoot()


    local gefRoot =
        GetGEFRoot(gef)


    if not playerRoot
    or not gefRoot
    then

        return math.huge

    end


    return (
        playerRoot.Position
        -
        gefRoot.Position
    ).Magnitude

end


local function GetNearestGEF()

    local nearest = nil

    local nearestDistance =
        math.huge


    for _,gef in ipairs(
        GetAllGEFs()
    ) do

        local distance =
            GetGEFDistance(gef)


        if distance <=
            Config.GEFMaxDistance

            and

            distance <
            nearestDistance
        then

            nearest =
                gef

            nearestDistance =
                distance

        end

    end


    return
        nearest,
        nearestDistance

end


-- ============================================================
-- GEF ESP
-- ============================================================

local function RemoveGEFESP(gef)

    local object =
        GEFObjects[gef]


    if object then

        pcall(function()
            object:Destroy()
        end)

        GEFObjects[gef] =
            nil

    end

end


local function ClearGEFESP()

    for gef,object in pairs(
        GEFObjects
    ) do

        pcall(function()

            if object then
                object:Destroy()
            end

        end)

        GEFObjects[gef] =
            nil

    end

end


local function CreateGEFESP(gef)

    if not gef then
        return
    end


    if GEFObjects[gef] then
        return
    end


    local root =
        GetGEFRoot(gef)


    if not root then
        return
    end


    local container =
        Instance.new("Folder")


    container.Name =
        "MK_GEF_ESP"


    container.Parent =
        Workspace


    GEFObjects[gef] =
        container


    local highlight =
        Instance.new("Highlight")


    highlight.Name =
        "GEFHighlight"


    highlight.Adornee =
        gef


    highlight.DepthMode =
        Enum.HighlightDepthMode.AlwaysOnTop


    highlight.FillColor =
        C.RED


    highlight.FillTransparency =
        0.65


    highlight.OutlineColor =
        C.WHITE


    highlight.OutlineTransparency =
        0


    highlight.Parent =
        container


    local billboard =
        Instance.new("BillboardGui")


    billboard.Name =
        "GEFInfo"


    billboard.Adornee =
        root


    billboard.Size =
        UDim2.new(
            0,
            190,
            0,
            75
        )


    billboard.StudsOffset =
        Vector3.new(
            0,
            4,
            0
        )


    billboard.AlwaysOnTop =
        true


    billboard.Parent =
        container


    local label =
        Instance.new("TextLabel")


    label.Size =
        UDim2.new(
            1,
            0,
            1,
            0
        )


    label.BackgroundTransparency =
        1


    label.TextColor3 =
        C.WHITE


    label.TextStrokeTransparency =
        0


    label.Font =
        Enum.Font.GothamBold


    label.TextSize =
        12


    label.TextWrapped =
        true


    label.Parent =
        billboard


    local connection


    connection =
        RunService.RenderStepped:Connect(
            function()

                if not Config.GEFESP then

                    connection:Disconnect()

                    RemoveGEFESP(
                        gef
                    )

                    return

                end


                if not gef
                or not gef.Parent
                then

                    connection:Disconnect()

                    RemoveGEFESP(
                        gef
                    )

                    return

                end


                local currentRoot =
                    GetGEFRoot(gef)


                if not currentRoot then
                    return
                end


                local distance =
                    GetGEFDistance(
                        gef
                    )


                if distance >
                    Config.GEFMaxDistance
                then

                    container.Parent =
                        nil

                    return

                end


                if not container.Parent then

                    container.Parent =
                        Workspace

                end


                local text = ""


                if Config.GEFName then

                    text =
                        text
                        ..
                        gef.Name

                end


                if Config.GEFHealth then

                    local humanoid =
                        GetGEFHumanoid(
                            gef
                        )


                    if humanoid then

                        text =
                            text
                            ..
                            "\nHP: "
                            ..
                            math.floor(
                                humanoid.Health
                            )
                            ..
                            " / "
                            ..
                            math.floor(
                                humanoid.MaxHealth
                            )

                    end

                end


                if Config.GEFDistance then

                    text =
                        text
                        ..
                        "\nDistance: "
                        ..
                        math.floor(
                            distance
                        )
                        ..
                        " studs"

                end


                label.Text =
                    text

            end
        )

end


local function UpdateGEFESP()

    if not Config.GEFESP then

        ClearGEFESP()

        return

    end


    local current = {}


    for _,gef in ipairs(
        GetAllGEFs()
    ) do

        current[gef] =
            true


        local distance =
            GetGEFDistance(
                gef
            )


        if distance <=
            Config.GEFMaxDistance
        then

            CreateGEFESP(
                gef
            )

        end

    end


    for gef in pairs(
        GEFObjects
    ) do

        if not current[gef] then

            RemoveGEFESP(
                gef
            )

        end

    end

end


local function UpdateGEFAlert()

    if not Config.GEFAlert then
        return
    end


    local current = {}


    for _,gef in ipairs(
        GetAllGEFs()
    ) do

        current[gef] =
            true


        if not KnownGEFs[gef] then

            KnownGEFs[gef] =
                true

            Notify(
                "GEF detected: "
                ..
                gef.Name
            )

        end

    end


    for gef in pairs(
        KnownGEFs
    ) do

        if not current[gef] then

            KnownGEFs[gef] =
                nil

        end

    end

end


