    local toggle =
        Instance.new("TextButton")

    toggle.Size =
        UDim2.new(
            0,
            45,
            0,
            24
        )

    toggle.Position =
        UDim2.new(
            1,
            -58,
            0.5,
            -12
        )

    toggle.BackgroundColor3 =
        Config[key]
        and C.RED
        or C.PANEL2

    toggle.Text = ""

    toggle.BorderSizePixel = 0

    toggle.Parent =
        holder

    Corner(toggle,12)


    local dot =
        Instance.new("Frame")

    dot.Size =
        UDim2.new(
            0,
            18,
            0,
            18
        )

    dot.Position =
        Config[key]
        and UDim2.new(
            1,
            -21,
            0.5,
            -9
        )
        or UDim2.new(
            0,
            3,
            0.5,
            -9
        )

    dot.BackgroundColor3 =
        C.WHITE

    dot.BorderSizePixel = 0

    dot.Parent =
        toggle

    Corner(dot,10)


    local function Refresh()

        toggle.BackgroundColor3 =
            Config[key]
            and C.RED
            or C.PANEL2

        dot.Position =
            Config[key]
            and UDim2.new(
                1,
                -21,
                0.5,
                -9
            )
            or UDim2.new(
                0,
                3,
                0.5,
                -9
            )

    end


    toggle.MouseButton1Click:Connect(
        function()

            Config[key] =
                not Config[key]

            Refresh()

        end
    )


    return holder,Refresh

end


