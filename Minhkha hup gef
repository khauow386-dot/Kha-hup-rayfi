local function CreateNav(
    name,
    icon
)

    local button =
        Instance.new("TextButton")

    button.Size =
        UDim2.new(
            1,
            0,
            0,
            38
        )

    button.BackgroundColor3 =
        C.SIDEBAR

    button.Text =
        "  "
        ..icon
        .."   "
        ..name

    button.TextColor3 =
        C.GRAY

    button.TextSize = 12

    button.Font =
        Enum.Font.GothamSemibold

    button.TextXAlignment =
        Enum.TextXAlignment.Left

    button.BorderSizePixel = 0

    button.AutoButtonColor = false

    button.Parent =
        Nav

    Corner(button,7)

    NavButtons[name] =
        button


    button.MouseButton1Click:Connect(
        function()

            for _,b in pairs(
                NavButtons
            ) do

                b.BackgroundColor3 =
                    C.SIDEBAR

                b.TextColor3 =
                    C.GRAY

            end


            button.BackgroundColor3 =
                C.DARK_RED

            button.TextColor3 =
                C.WHITE


            for _,p in pairs(
                Pages
            ) do

                p.Visible = false

            end


            if Pages[name] then

                Pages[name].Visible =
                    true

            end


            PageTitle.Text =
                string.upper(name)

            PageSubtitle.Text =
                "MINH KHA HUB • "
                ..string.upper(name)

        end
    )


    return button

end


