            input.Position -
            floatingDragStart

        Floating.Position =
            UDim2.new(
                floatingStartPos.X.Scale,
                floatingStartPos.X.Offset
                    + delta.X,

                floatingStartPos.Y.Scale,
                floatingStartPos.Y.Offset
                    + delta.Y
