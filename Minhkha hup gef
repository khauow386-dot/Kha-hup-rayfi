local function GetCharacterRoot()

    local char =
        LocalPlayer.Character

    if not char then
        return nil
    end

    return char:FindFirstChild(
        "HumanoidRootPart"
    )

end


local function MaterialFromName(name)

    if typeof(name) ~= "string" then
        return Enum.Material.Plastic
    end


    local ok,result =
        pcall(
            function()

                return Enum.Material[name]

            end
        )


    if ok and result then
        return result
    end


    return Enum.Material.Plastic

end


local function MakeBuildPart(
    data,
    parent,
    preview
)

    if type(data) ~= "table" then
        return nil
    end


    local part =
        Instance.new("Part")


    part.Name =
        tostring(
            data.Name
            or "Part"
        )


    part.Anchored = true

    part.CanCollide =
        not preview

    part.Size =
        Vector3.new(
            4,
            4,
            4
        )


    if type(data.Size) ==
        "table"

        and
        #data.Size >= 3
    then

        local x =
            tonumber(
                data.Size[1]
            )

        local y =
            tonumber(
                data.Size[2]
            )

        local z =
            tonumber(
                data.Size[3]
            )


        if x and y and z then

            part.Size =
                Vector3.new(

                    math.clamp(
                        x,
                        0.1,
                        1000
                    ),

                    math.clamp(
                        y,
                        0.1,
                        1000
                    ),

                    math.clamp(
                        z,
                        0.1,
                        1000
                    )

                )

        end

    end


    local pos =
        Vector3.zero


    if type(data.Position) ==
        "table"

        and
        #data.Position >= 3
    then

        local x =
            tonumber(
                data.Position[1]
            )

        local y =
            tonumber(
                data.Position[2]
            )

        local z =
            tonumber(
                data.Position[3]
            )


        if x and y and z then

            pos =
                Vector3.new(
                    x,
                    y,
                    z
                )

        end

    end


    local rot =
        Vector3.zero


    if type(data.Rotation) ==
        "table"

        and
        #data.Rotation >= 3
    then

        local x =
            tonumber(
                data.Rotation[1]
            )

        local y =
            tonumber(
                data.Rotation[2]
            )

        local z =
            tonumber(
                data.Rotation[3]
            )


        if x and y and z then

            rot =
                Vector3.new(
                    x,
                    y,
                    z
                )

        end

    end


    part.CFrame =
        CFrame.new(pos)
        *
        CFrame.Angles(

            math.rad(rot.X),
            math.rad(rot.Y),
            math.rad(rot.Z)

        )


    part.Material =
        MaterialFromName(
            data.Material
        )


    if preview then

        part.Transparency =
            0.45

        part.Color =
            C.RED

    else

        part.Transparency =
            0

    end


    part.Parent =
        parent


    if preview then

        local highlight =
            Instance.new("Highlight")

        highlight.FillColor =
            C.RED

        highlight.FillTransparency =
            0.75

        highlight.OutlineColor =
            C.WHITE

        highlight.OutlineTransparency =
            0

        highlight.Parent =
            part

    end


    return part

end


local function ValidateBuild(build)

    if type(build) ~= "table" then

        return false,
            "Build phải là object."

    end


    if type(build.Parts) ~= "table" then

        return false,
            "Thiếu Parts."

    end


    if #build.Parts > 500 then

        return false,
            "Tối đa 500 Parts."

    end


    for i,part in ipairs(
        build.Parts
    ) do

        if type(part) ~= "table" then

            return false,
                "Part "..i
                .." không hợp lệ."

        end


        if type(part.Size) ~=
            "table"

            or
            #part.Size < 3
        then

            return false,
                "Part "..i
                .." thiếu Size."

        end


        if type(part.Position) ~=
            "table"

            or
            #part.Position < 3
        then

            return false,
                "Part "..i
                .." thiếu Position."

        end

    end


    return true

end


local function PreviewBuild(build)

    ClearPreview()


    local root =
        GetCharacterRoot()


    if not root then

        Notify(
            "Không tìm thấy nhân vật."
        )

        return

    end


    local count = 0


    for _,partData in ipairs(
        build.Parts
    ) do

        MakeBuildPart(
            partData,
            PreviewFolder,
            true
        )

        count += 1

    end


    local origin =
        root.CFrame


    for _,part in ipairs(
        PreviewFolder:GetChildren()
    ) do

        if part:IsA("BasePart") then

            part.CFrame =
                origin
                *
                part.CFrame

        end

    end


    Notify(
        "Preview "
        ..count
        .." Parts."
    )

end


local function BuildImported(build)

    ClearPreview()


    local root =
        GetCharacterRoot()


    if not root then

        Notify(
            "Không tìm thấy nhân vật."
        )

        return

    end


    local folder =
        Instance.new("Folder")


    folder.Name =
        "MinhKhaImportedBuild"


    folder.Parent =
        Workspace


    local origin =
        root.CFrame


    local count = 0


    for _,partData in ipairs(
        build.Parts
    ) do

        local part =
            MakeBuildPart(
                partData,
                folder,
                false
            )


        if part then

            part.CFrame =
                origin
                *
                part.CFrame

            count += 1

        end

    end


    Notify(
        "Đã tạo "
        ..count
        .." Parts."
    )


    task.delay(
        5,
        function()

            if folder
            and
            folder.Parent
            then

                folder:Destroy()

            end

        end
    )

end


